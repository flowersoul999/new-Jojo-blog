				left.textContent = item.busy
					? "上传中…"
					: item.kind === "url"
						? "链接"
						: formatBytes(item.size || 0);
				var right = document.createElement("span");
				right.textContent = isVideo
					? item.duration
						? formatDuration(item.duration)
						: "视频"
