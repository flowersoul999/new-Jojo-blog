	</style>

	<script is:inline>
	(function () {
		var MOOD_MAP = {
			"super-happy": { label: "炒鸡开心", emoji: "🤩" },
			happy: { label: "开心", emoji: "😊" },
			neutral: { label: "平平淡淡", emoji: "😐" },
			unhappy: { label: "不开心", emoji: "😔" },
			sad: { label: "伤心难过", emoji: "😭" },
		};

		var DIARY_PASSWORD = "2299";
		var UNLOCK_KEY = "aemeath-diary-unlocked";
		var DRAG_THRESHOLD = 6; // 拖动超过该像素才算拖动，否则视为点击

		var board = document.getElementById("diary-board");
		var shuffleBtn = document.getElementById("diary-shuffle");
		var composeBtn = document.getElementById("diary-compose-btn");

		var entries = [];
		var unlocked = false;
		var shuffleSeed = 0;
		var savedPos = {}; // slug -> {x,y}，拖动后的位置
		var zTop = 10; // 拖动/触摸时递增，让纸片叠到最上

		try {
			unlocked = sessionStorage.getItem(UNLOCK_KEY) === "1";
		} catch (e) {}

		/* ---------- 工具 ---------- */
		function hashStr(s) {
			var h = 7;
			for (var i = 0; i < s.length; i++) {
				h = (h * 31 + s.charCodeAt(i)) >>> 0;
			}
			return h;
		}

		/* 确定性伪随机数生成器：同一 slug + seed 结果固定 */
		function mulberry32(a) {
			return function () {
				a |= 0;
				a = (a + 0x6d2b79f5) | 0;
				var t = Math.imul(a ^ (a >>> 15), 1 | a);
				t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
				return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
			};
		}

		function escapeHtml(str) {
			var div = document.createElement("div");
			div.textContent = str == null ? "" : String(str);
			return div.innerHTML;
		}

		function formatDate(dateStr) {
			var d = new Date(dateStr);
			if (isNaN(d.getTime())) return dateStr;
			return (
				d.getFullYear() +
				"年" +
				String(d.getMonth() + 1).padStart(2, "0") +
				"月" +
				String(d.getDate()).padStart(2, "0") +
				"日"
			);
		}

		function isLocked(entry) {
			return entry.isPrivate && !unlocked;
		}

		/* 未锁定的带图日记取首图做纸片缩略图 */
		function paperImage(entry) {
			if (isLocked(entry)) return null;
			return entry.images && entry.images.length ? entry.images[0].url : null;
		}

		/* 基于 slug 的确定性"随机"漂浮参数 */
		function floatParams(slug, seed) {
			var h = (hashStr(slug) + seed * 2654435761) >>> 0;
			var variants = ["card", "bubble", "cloud"];
			var variant = variants[h % 3];
			var tone = (h >>> 3) % 5;
			var w =
				variant === "cloud"
					? 250 + ((h >>> 5) % 60)
					: variant === "bubble"
						? 185 + ((h >>> 5) % 45)
						: 210 + ((h >>> 5) % 60);
			var rotate = -7 + ((h >>> 9) % 140) / 10;
			return {
				variant: variant,
				tone: tone,
				w: w,
				rotate: rotate,
				floatDur: 5 + ((h >>> 13) % 30) / 10,
				floatDelay: -(((h >>> 17) % 40) / 10),
				floatAmp: 6 + ((h >>> 21) % 6),
				h: h,
			};
		}

		/* ---------- 随机散布：多次取点，尽量降低互相遮挡 ---------- */
		function overlapArea(a, b) {
			var ix = Math.max(0, Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x));
			var iy = Math.max(0, Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y));
			return ix * iy;
		}

		function scatterPlace(pw, ph, w, h, placed, rnd) {
			var maxX = Math.max(10, w - pw - 10);
			var maxY = Math.max(16, h - ph - 16);
			var best = null;
			var bestScore = Infinity;
			for (var t = 0; t < 10; t++) {
				var cand = {
					x: 10 + rnd() * (maxX - 10),
					y: 16 + rnd() * (maxY - 16),
					w: pw,
					h: ph,
				};
				var score = 0;
				for (var k = 0; k < placed.length; k++) {
					score += overlapArea(cand, placed[k]);
				}
				if (score === 0) {
					best = cand;
					break;
				}
				if (score < bestScore) {
					bestScore = score;
					best = cand;
				}
			}
			placed.push(best);
			return best;
		}

		/* ---------- 渲染漂浮板 ---------- */
		function renderBoard() {
			if (!entries.length) {
				board.innerHTML =
					'<div class="diary-board-tip"><div style="text-align:center"><div style="font-size:2.2rem;margin-bottom:.6rem">📝</div><p>暂无日记</p></div></div>';
				board.classList.remove("is-flow");
				board.style.height = "";
				return;
			}

			var w = board.clientWidth || 800;
			var isMobile = window.innerWidth < 640;
			var sorted = entries.slice().sort(function (a, b) {
				return new Date(b.date).getTime() - new Date(a.date).getTime();
			});

			// 板面内容高度按行估算：让所有纸片都有散布空间；
			// 画布可视高度由 CSS 固定（.diary-board height: min(70vh, 42rem)），
			// 内容超出可视部分靠画布内部的滚动条浏览，纸片始终被限制在画布内。
			var cols = isMobile ? 1 : w >= 1100 ? 4 : w >= 800 ? 3 : 2;
			var rows = Math.ceil(sorted.length / cols);
			var cellH = isMobile ? 230 : 280;
			var boardH = Math.max(rows * cellH + 72, 480);
			// 拖动时允许纸片移动到内容区（含画布内可滚动到的区域）
			var contentH = Math.max(boardH, board.clientHeight);

			board.classList.toggle("is-flow", isMobile);
			if (isMobile) {
				board.style.height = "";
			} else {
				// 高度交给 CSS，不再覆盖，保证画布固定高度长方形
				board.style.height = "";
			}

			var placed = [];
			var html = "";
			sorted.forEach(function (entry) {
				var prm = floatParams(entry.slug, shuffleSeed);
				var locked = isLocked(entry);
				var mood = entry.mood ? MOOD_MAP[entry.mood] : null;
				var img = paperImage(entry);

				// 带图的纸片固定用便签卡片样式（拍立得感），略宽一点
				var variant = img ? "card" : prm.variant;
				var pw = img ? 250 + ((prm.h >>> 2) % 50) : prm.w;
				pw = Math.min(pw, w * 0.66, w - 20);
				pw = Math.max(pw, 160);
				var ph = img ? 300 : variant === "bubble" ? 205 : 185;

				var left, top;
				if (isMobile) {
					left = 0;
					top = 0;
				} else {
					var sp = savedPos[entry.slug];
					if (sp) {
						// 拖动过就停在拖动后的位置
						left = sp.x;
						top = sp.y;
					} else {
						var rnd = mulberry32((hashStr(entry.slug) + shuffleSeed * 1013904223) >>> 0);
						var rect = scatterPlace(pw, ph, w, contentH, placed, rnd);
						left = rect.x;
						top = rect.y;
					}
					// 限制在画布范围内（含画布内可滚动到的内容区）
					left = Math.max(8, Math.min(left, w - pw - 8));
					top = Math.max(16, Math.min(top, contentH - ph - 16));
				}

				html += '<div class="diary-paper-pos" style="left:' + left.toFixed(1) + "px;top:" + top.toFixed(1) + 'px;width:' + pw.toFixed(0) + 'px" data-slug="' + entry.slug + '">';
				html +=
					'<div class="diary-paper-rot" style="transform:rotate(' + prm.rotate.toFixed(1) + 'deg)">';
				html +=
					'<div class="diary-paper diary-paper--' +
					variant +
					(locked ? " diary-paper--locked" : "") +
					'" data-tone="' +
					prm.tone +
					'" style="--float-dur:' +
					prm.floatDur.toFixed(1) +
					"s;--float-delay:" +
					prm.floatDelay.toFixed(1) +
					"s;--float-amp:" +
					prm.floatAmp +
					'px;width:100%">';

				if (locked) {
					html += '<div class="text-2xl mb-1">🔒</div>';
					html += '<div class="diary-paper-title" style="text-align:center">私密日记</div>';
					html += '<div class="diary-paper-meta" style="justify-content:center"><span>' + formatDate(entry.date) + "</span></div>";
				} else {
					if (img) {
						html += '<div class="diary-paper-thumb"><img src="' + img + '" alt="" loading="lazy" draggable="false"></div>';
					}
					html += '<div class="diary-paper-title">' + escapeHtml(entry.title || "无题") + "</div>";
					html += '<div class="diary-paper-excerpt">' + escapeHtml((entry.content || "").slice(0, 90)) + "</div>";
					html += '<div class="diary-paper-meta">';
					html += "<span>" + formatDate(entry.date) + "</span>";
					html += '<span class="flex items-center gap-1">';
					if (entry.images && entry.images.length > 1) {
						html += "<span>🖼" + entry.images.length + "</span>";
					}
					if (mood) {
						html += '<span class="diary-paper-mood" title="' + mood.label + '">' + mood.emoji + "</span>";
					}
					html += "</span></div>";
				}

				html += "</div></div></div>";
			});

			board.innerHTML = html;

			// 绑定拖拽与点击（移动端为流式排列，仅绑定点击）
			board.querySelectorAll(".diary-paper-pos").forEach(function (el) {
				var slug = el.dataset.slug;
				var entry = entries.find(function (e) {
					return e.slug === slug;
				});
				if (!entry) return;
				if (isMobile) {
					el.addEventListener("click", function () {
						handleEntryClick(entry);
					});
				} else {
					bindDrag(el, entry, contentH);
				}
			});
		}

		/* ---------- 跳转详情页（走 Swup 站内平滑过渡，不整页跳转） ---------- */
		function gotoDiary(slug) {
			var url = "/diary/" + slug;
			try {
				if (window.swup && typeof window.swup.navigate === "function") {
					window.swup.navigate(url);
					return;
				}
			} catch (e) {}
			window.location.href = url;
		}

		/* ---------- 点击纸片：跳转详情 / 解锁 ---------- */
		function handleEntryClick(entry) {
			if (isLocked(entry)) {
				var pwd = prompt("这是一篇私密日记，请输入密码：");
				if (pwd === DIARY_PASSWORD) {
					try {
						sessionStorage.setItem(UNLOCK_KEY, "1");
					} catch (e) {}
					unlocked = true;
					renderBoard();
					gotoDiary(entry.slug);
				} else if (pwd !== null) {
					alert("密码错误");
				}
				return;
			}
			gotoDiary(entry.slug);
		}

		/* ---------- 纸片拖动（全程可拖） ---------- */
		function bindDrag(el, entry, contentH) {
			var startX = 0,
				startY = 0,
				origX = 0,
				origY = 0,
				moved = false,
				dragging = false;

			el.addEventListener("pointerdown", function (e) {
				if (e.pointerType === "mouse" && e.button !== 0) return;
				dragging = true;
				moved = false;
				startX = e.clientX;
				startY = e.clientY;
				origX = parseFloat(el.style.left);
				origY = parseFloat(el.style.top);
				el.classList.add("dragging");
				el.style.zIndex = ++zTop; // 摸到谁，谁到最上面
				try {
					el.setPointerCapture(e.pointerId);
				} catch (err) {}
			});

			el.addEventListener("pointermove", function (e) {
				if (!dragging) return;
				var dx = e.clientX - startX;
				var dy = e.clientY - startY;
				if (!moved && Math.hypot(dx, dy) < DRAG_THRESHOLD) return;
				moved = true;
				var w = board.clientWidth;
				var pw = el.offsetWidth || 200;
				var ph = el.offsetHeight || 160;
				var nx = Math.max(8, Math.min(origX + dx, w - pw - 8));
				// 垂直方向允许拖到画布内容区（含滚动区域），仍被限制在画布内
				var ny = Math.max(8, Math.min(origY + dy, contentH - ph - 8));
				el.style.left = nx + "px";
				el.style.top = ny + "px";
				savedPos[entry.slug] = { x: nx, y: ny };
			});

			function endDrag(e) {
				if (!dragging) return;
				dragging = false;
				el.classList.remove("dragging");
				try {
					el.releasePointerCapture(e.pointerId);
				} catch (err) {}
				// 没怎么动 → 视为点击，跳转详情页
				if (!moved) handleEntryClick(entry);
			}
			el.addEventListener("pointerup", endDrag);
			el.addEventListener("pointercancel", endDrag);
		}

		shuffleBtn.addEventListener("click", function () {
			shuffleSeed = (shuffleSeed + 1) % 997;
			savedPos = {};
			renderBoard();
		});

		var resizeTimer = null;
		window.addEventListener("resize", function () {
			clearTimeout(resizeTimer);
			resizeTimer = setTimeout(renderBoard, 200);
		});

		/* ---------- 写日记（登录后可用） ---------- */
		var composeModal = document.getElementById("diary-compose");
		var composeMask = document.getElementById("diary-compose-mask");
		var composeClose = document.getElementById("diary-compose-close");
		var composeSubmit = document.getElementById("diary-compose-submit");
		var composeStatus = document.getElementById("diary-compose-status");
		var composeTitle = document.getElementById("diary-compose-title");
		var composeContent = document.getElementById("diary-compose-content");
		var composeImages = document.getElementById("diary-compose-images");
		var composePrivate = document.getElementById("diary-compose-private");
		var composeMoods = document.getElementById("diary-compose-moods");
		var composeMood = "neutral";
		var composeSaving = false;
		var DIARY_JSON_PATH = "public/diary/index.json";

		// 渲染心情选项（默认选中"平平淡淡"）
		Object.keys(MOOD_MAP).forEach(function (key) {
			var m = MOOD_MAP[key];
			var btn = document.createElement("button");
			btn.type = "button";
			btn.className = "diary-compose-mood" + (key === composeMood ? " is-active" : "");
			btn.dataset.mood = key;
			btn.innerHTML = "<span>" + m.emoji + "</span><span>" + m.label + "</span>";
			btn.addEventListener("click", function () {
				composeMood = key;
				composeMoods.querySelectorAll(".diary-compose-mood").forEach(function (el) {
					el.classList.toggle("is-active", el.dataset.mood === key);
				});
			});
			composeMoods.appendChild(btn);
		});

		function showToast(msg) {
			var old = document.querySelector(".diary-toast");
			if (old) old.remove();
			var toast = document.createElement("div");
			toast.className = "diary-toast";
			toast.textContent = msg;
			document.body.appendChild(toast);
			setTimeout(function () {
				toast.remove();
			}, 3200);
		}

		function setComposeStatus(msg, isError) {
			composeStatus.textContent = msg || "";
			composeStatus.classList.toggle("is-error", !!isError);
		}

		function openCompose() {
			setComposeStatus("");
			composeModal.hidden = false;
			composeContent.focus();
		}

		function closeCompose() {
			composeModal.hidden = true;
		}

		// 生成 slug：diary-YYYYMMDD-xxxxxx（与现有数据格式一致）
		function genSlug() {
			var d = new Date();
			var ymd =
				d.getFullYear() +
				String(d.getMonth() + 1).padStart(2, "0") +
				String(d.getDate()).padStart(2, "0");
			var rand = Math.random().toString(36).slice(2, 8);
			return "diary-" + ymd + "-" + rand;
		}

		// 生成与现有数据一致的本地时间格式：YYYY-MM-DDTHH:mm
		function localDateStr() {
			var d = new Date();
			return (
				d.getFullYear() +
				"-" +
				String(d.getMonth() + 1).padStart(2, "0") +
				"-" +
				String(d.getDate()).padStart(2, "0") +
				"T" +
				String(d.getHours()).padStart(2, "0") +
				":" +
				String(d.getMinutes()).padStart(2, "0")
			);
		}

		function submitCompose() {
			if (composeSaving) return;
			var content = composeContent.value.trim();
			if (!content) {
				setComposeStatus("内容不能为空", true);
				return;
			}
			var imageUrls = composeImages.value
				.split("\n")
				.map(function (s) {
					return s.trim();
				})
				.filter(function (s) {
					return !!s;
				});

			var entry = {
				slug: genSlug(),
				title: composeTitle.value.trim(),
				content: content,
				date: localDateStr(),
				tags: [],
				images: imageUrls.map(function (url) {
					return { url: url };
				}),
				isPrivate: composePrivate.checked,
				mood: composeMood,
			};

			composeSaving = true;
			composeSubmit.disabled = true;
			setComposeStatus("正在保存...");

			// 先读最新文件内容和 sha（GitHub Contents API 更新时必须带 sha），避免覆盖别处的新改动
			fetch("/api/content/read/?path=" + encodeURIComponent(DIARY_JSON_PATH))
				.then(function (r) {
					if (!r.ok) throw new Error("读取日记数据失败");
					return r.json();
				})
				.then(function (file) {
					var arr;
					try {
						arr = JSON.parse(file.content || "[]");
					} catch (e) {
						arr = [];
					}
					if (!Array.isArray(arr)) arr = [];
					arr.unshift(entry);
					return fetch("/api/content/write/", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							path: DIARY_JSON_PATH,
							content: JSON.stringify(arr, null, 2) + "\n",
							sha: file.sha,
							message: "新增日记: " + (entry.title || entry.slug),
						}),
					});
				})
				.then(function (r) {
					return r.json().then(function (data) {
						if (!r.ok) throw new Error(data.error || "保存失败");
						// 立即更新本地数据并重渲染，无需等部署
						entries.unshift(entry);
						renderBoard();
						closeCompose();
						composeTitle.value = "";
						composeContent.value = "";
						composeImages.value = "";
						composePrivate.checked = false;
						showToast("日记已发表，全站生效约需 1-2 分钟（等待重新部署）");
					});
				})
				.catch(function (err) {
					setComposeStatus(err.message || "保存失败", true);
				})
				.finally(function () {
					composeSaving = false;
					composeSubmit.disabled = false;
				});
		}

		composeBtn.addEventListener("click", openCompose);
		composeClose.addEventListener("click", closeCompose);
		composeMask.addEventListener("click", closeCompose);
		composeSubmit.addEventListener("click", submitCompose);
		document.addEventListener("keydown", function (e) {
			if (e.key === "Escape" && !composeModal.hidden) closeCompose();
		});

		/* ---------- 登录状态：已登录则显示「写日记」按钮 ---------- */
		fetch("/api/auth/status/", { credentials: "same-origin" })
			.then(function (r) {
				return r.json();
			})
			.then(function (data) {
				if (data.authenticated) {
					composeBtn.hidden = false;
					composeBtn.classList.remove("hidden");
					composeBtn.classList.add("inline-flex");
				}
			})
			.catch(function () {
				/* 未登录则保持隐藏 */
			});

		/* ---------- 加载数据 ---------- */
		fetch("/diary/index.json")
			.then(function (r) {
				return r.json();
			})
			.then(function (data) {
				entries = data;
				renderBoard();
			})
			.catch(function (err) {
				console.error("Failed to load diary:", err);
				board.innerHTML = '<div class="diary-board-tip">日记加载失败</div>';
			});
	})();
	</script>
</MainGridLayout>
