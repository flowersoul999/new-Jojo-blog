---
// 日记页：普通页面布局（套用主站 MainGridLayout，保留导航栏/侧边栏/页脚）
// 点击「日记」与其他页面一样走站内平滑过渡，不再整页跳转；
// 纸片散落在页面中央区域内，往下滑即可浏览全部，可拖动摆放、点击看详情。
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.diary) {
	return Astro.redirect("/404/");
}

const title = "日记";
const description = "记录生活，碎碎念。纸片随意拖动摆放，点击查看详情。";
---

<MainGridLayout title={title} description={description}>
	<div class="card-base z-10 relative w-full overflow-hidden">
		<div class="px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative">
			<!-- 页面标题 -->
			<div class="flex items-center gap-3 mb-2">
					<div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-(--primary) text-white dark:text-black/70">
						<Icon is:inline name="material-symbols:edit-note" class="text-[1.5rem]" />
					</div>
					<div class="text-2xl sm:text-3xl font-bold text-neutral-900 dark:text-neutral-100">{title}</div>
					<a
						href="/life/"
						class="ml-auto inline-flex items-center gap-1.5 rounded-lg bg-(--btn-regular-bg) px-3 py-1.5 text-sm text-(--btn-content) transition-colors hover:bg-(--btn-regular-bg-hover)"
						aria-label="时间线视图"
					>
						<Icon is:inline name="material-symbols:timeline" class="text-base" />
						<span>时间线</span>
					</a>
					<button
						type="button"
						id="diary-shuffle"
						class="inline-flex items-center gap-1.5 rounded-lg bg-(--btn-regular-bg) px-3 py-1.5 text-sm text-(--btn-content) transition-colors hover:bg-(--btn-regular-bg-hover)"
						aria-label="换个摆法"
					>
						<Icon is:inline name="material-symbols:shuffle-rounded" class="text-base" />
						<span>换个摆法</span>
					</button>
				<button
					type="button"
					id="diary-compose-btn"
					class="hidden items-center gap-1.5 rounded-lg bg-(--primary) px-3 py-1.5 text-sm text-white dark:text-black/70 transition-opacity hover:opacity-90"
					aria-label="写日记"
					hidden
				>
					<Icon is:inline name="material-symbols:edit-rounded" class="text-base" />
					<span>写日记</span>
				</button>
			</div>
			<p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
				{description}
			</p>

			<!-- 漂浮板：固定高度长方形画布，纸片只在画布内散布与拖动，超出部分在画布内滚动 -->
			<div id="diary-board" class="diary-board relative w-full">
				<div class="diary-board-tip">
					<div class="animate-pulse">纸片飞扬中...</div>
				</div>
			</div>

			<!-- 底部提示 -->
			<div class="diary-board-hint flex items-center justify-center gap-1.5 pt-3 text-xs text-neutral-400 dark:text-neutral-500">
				<Icon is:inline name="material-symbols:open-in-new-rounded" class="text-sm" />
				<span>点击纸片查看完整日记，按住可随意拖动摆放</span>
			</div>
		</div>
	</div>

	<!-- 写日记弹窗（登录后可用，写入 public/diary/index.json） -->
	<div id="diary-compose" class="diary-compose" hidden>
		<div id="diary-compose-mask" class="diary-compose-mask"></div>
		<div class="diary-compose-panel" role="dialog" aria-modal="true" aria-label="写日记">
			<div class="diary-compose-head">
				<div class="flex items-center gap-2">
					<Icon is:inline name="material-symbols:edit-rounded" class="text-lg text-(--primary)" />
					<h2 class="text-base font-bold text-neutral-900 dark:text-neutral-100">写日记</h2>
				</div>
				<button type="button" id="diary-compose-close" class="diary-compose-close" aria-label="关闭">
					<Icon is:inline name="material-symbols:close" class="text-lg" />
				</button>
			</div>

			<div class="diary-compose-body">
				<input
					type="text"
					id="diary-compose-title"
					class="diary-compose-input"
					placeholder="标题（可留空）"
					maxlength="60"
				/>
				<textarea
					id="diary-compose-content"
					class="diary-compose-input diary-compose-textarea"
					placeholder="今天想记点什么..."
				></textarea>

				<div class="diary-compose-row">
					<span class="diary-compose-label">心情</span>
					<div id="diary-compose-moods" class="diary-compose-moods"></div>
				</div>

				<div class="diary-compose-row">
					<span class="diary-compose-label">时间</span>
					<div class="diary-compose-time">
						<input
							type="datetime-local"
							id="diary-compose-date"
							class="diary-compose-input diary-compose-date"
							step="60"
							aria-label="日记时间"
						/>
						<button type="button" id="diary-compose-now" class="diary-compose-now">
							此刻
						</button>
					</div>
				</div>

				<div class="diary-compose-row">
					<span class="diary-compose-label">照片/视频</span>
					<div class="diary-compose-imgs">
						<input type="file" id="diary-compose-file" accept="image/*,video/*" multiple class="hidden" />
						<button
							type="button"
							id="diary-compose-drop"
							class="diary-compose-drop"
							aria-label="添加照片或视频：点击选择，或把文件拖到这里"
						>
							<Icon is:inline name="material-symbols:add-photo-alternate" class="text-xl" />
							<span>点击选择照片或视频，或把文件拖到这里</span>
							<em>照片自动压缩为 WebP（质量 80%，最长边 1600px），单张不超过 15 MB；视频大于 6 MB 且 1 分钟内会自动转码到 720p，单个不超过 60 MB</em>
						</button>
						<div id="diary-compose-thumbs" class="diary-compose-thumbs"></div>
						<input
							type="text"
							id="diary-compose-url"
							class="diary-compose-input diary-compose-url"
							placeholder="或粘贴图片/视频链接，回车添加（可留空）"
						/>
					</div>
				</div>

				<label class="diary-compose-private">
					<input type="checkbox" id="diary-compose-private" class="accent-(--primary)" />
					<span>私密日记（需要密码才能查看）</span>
				</label>
			</div>

			<div class="diary-compose-foot">
				<span id="diary-compose-status" class="diary-compose-status"></span>
				<button type="button" id="diary-compose-submit" class="diary-compose-submit">
					<Icon is:inline name="material-symbols:send-rounded" class="text-base" />
					<span>发表</span>
				</button>
			</div>
		</div>
	</div>

	<style is:global>
		/* ===================== 写日记弹窗 ===================== */
		.diary-compose {
			position: fixed;
			inset: 0;
			z-index: 9998;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 1rem;
		}
		.diary-compose[hidden] {
			display: none;
		}
		.diary-compose-mask {
			position: absolute;
			inset: 0;
			background: rgb(0 0 0 / 0.55);
			backdrop-filter: blur(6px);
			-webkit-backdrop-filter: blur(6px);
			animation: diary-compose-fade 0.25s ease;
		}
		.diary-compose-panel {
			position: relative;
			width: 100%;
			max-width: 30rem;
			max-height: min(86vh, 44rem);
			display: flex;
			flex-direction: column;
			overflow: hidden;
			border-radius: 1.25rem;
			border: 1px solid var(--line-divider);
			background: var(--card-bg);
			box-shadow:
				0 30px 80px rgb(0 0 0 / 0.35),
				0 6px 24px rgb(0 0 0 / 0.16);
			animation: diary-compose-pop 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		}
		.diary-compose-head {
			flex: none;
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.9rem 1.1rem;
			border-bottom: 1px solid var(--line-divider);
		}
		.diary-compose-close {
			display: flex;
			align-items: center;
			justify-content: center;
			height: 2rem;
			width: 2rem;
			border: none;
			border-radius: 999px;
			cursor: pointer;
			background: var(--btn-regular-bg);
			color: var(--btn-content);
			transition: background 200ms ease;
		}
		.diary-compose-close:hover {
			background: var(--btn-regular-bg-hover);
		}
		.diary-compose-body {
			flex: 1 1 auto;
			min-height: 0;
			overflow-y: auto;
			display: flex;
			flex-direction: column;
			gap: 0.85rem;
			padding: 1rem 1.1rem;
		}
		.diary-compose-input {
			width: 100%;
			border-radius: 0.65rem;
			border: 1px solid var(--line-divider);
			background: color-mix(in srgb, var(--text-color) 3%, transparent);
			padding: 0.55rem 0.75rem;
			font-size: 0.875rem;
			color: var(--text-color);
			outline: none;
			transition: border-color 200ms ease;
		}
		.diary-compose-input:focus {
			border-color: color-mix(in srgb, var(--primary) 55%, transparent);
		}
		.diary-compose-input::placeholder {
			color: color-mix(in srgb, var(--text-color) 40%, transparent);
		}
		.diary-compose-textarea {
			min-height: 8rem;
			resize: vertical;
			line-height: 1.7;
		}
		.diary-compose-imgs {
			flex: 1;
			min-width: 0;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}
		.diary-compose-drop {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 0.15rem;
			width: 100%;
			padding: 0.85rem 0.75rem;
			border: 1px dashed color-mix(in srgb, var(--primary) 45%, transparent);
			border-radius: 0.75rem;
			background: color-mix(in srgb, var(--primary) 4%, transparent);
			color: color-mix(in srgb, var(--text-color) 62%, transparent);
			cursor: pointer;
			text-align: center;
			transition:
				border-color 200ms ease,
				background 200ms ease,
				color 200ms ease;
		}
		.diary-compose-drop:hover,
		.diary-compose-drop.is-drag {
			border-color: var(--primary);
			background: color-mix(in srgb, var(--primary) 10%, transparent);
			color: var(--text-color);
		}
		.diary-compose-drop span {
			font-size: 0.8rem;
			color: var(--text-color);
		}
		.diary-compose-drop em {
			font-size: 0.68rem;
			font-style: normal;
			opacity: 0.75;
		}
		.diary-compose-thumbs {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 0.4rem;
		}
		.diary-compose-thumbs:empty {
			display: none;
		}
		.diary-compose-thumb {
			position: relative;
			aspect-ratio: 1;
			border-radius: 0.5rem;
			overflow: hidden;
			border: 1px solid var(--line-divider);
			background: color-mix(in srgb, var(--text-color) 6%, transparent);
		}
		.diary-compose-thumb img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}
		.diary-compose-thumb-bar {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.25rem;
			padding: 0.15rem 0.3rem;
			background: rgb(0 0 0 / 0.55);
			color: #fff;
			font-size: 0.6rem;
			line-height: 1.4;
		}
		.diary-compose-thumb-del {
			position: absolute;
			top: 0.2rem;
			right: 0.2rem;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 1.15rem;
			height: 1.15rem;
			border: none;
			border-radius: 999px;
			background: rgb(0 0 0 / 0.55);
			color: #fff;
			font-size: 0.7rem;
			line-height: 1;
			cursor: pointer;
			transition: background 200ms ease;
		}
		.diary-compose-thumb-del:hover {
			background: rgb(0 0 0 / 0.78);
		}
		.diary-compose-thumb.is-busy::after {
			content: "";
			position: absolute;
			inset: 0;
			background: rgb(0 0 0 / 0.45);
		}
		/* 视频角标：居中一个播放三角 */
		.diary-compose-thumb-play {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.1rem;
			color: #fff;
			text-shadow: 0 1px 4px rgb(0 0 0 / 0.5);
			pointer-events: none;
		}
		.diary-compose-url {
			font-size: 0.8rem;
		}
		.diary-compose-row {
			display: flex;
			align-items: flex-start;
			gap: 0.65rem;
		}
		.diary-compose-label {
			flex: none;
			padding-top: 0.3rem;
			font-size: 0.8rem;
			color: color-mix(in srgb, var(--text-color) 55%, transparent);
		}
		.diary-compose-moods {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
		}
		.diary-compose-mood {
			display: inline-flex;
			align-items: center;
			gap: 0.25rem;
			border: 1px solid var(--line-divider);
			border-radius: 999px;
			background: transparent;
			padding: 0.28rem 0.65rem;
			font-size: 0.78rem;
			color: var(--text-color);
			cursor: pointer;
			transition:
				border-color 200ms ease,
				background 200ms ease;
		}
		.diary-compose-mood:hover {
			border-color: color-mix(in srgb, var(--primary) 45%, transparent);
		}
		.diary-compose-mood.is-active {
			border-color: var(--primary);
			background: color-mix(in srgb, var(--primary) 12%, transparent);
		}
		.diary-compose-time {
			flex: 1;
			min-width: 0;
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
		.diary-compose-date {
			flex: 1;
			min-width: 0;
			width: auto;
			font-size: 0.8rem;
			font-variant-numeric: tabular-nums;
			color-scheme: light;
		}
		html.dark .diary-compose-date {
			color-scheme: dark;
		}
		.diary-compose-now {
			flex: none;
			border: 1px solid var(--line-divider);
			border-radius: 999px;
			background: transparent;
			padding: 0.34rem 0.7rem;
			font-size: 0.78rem;
			color: var(--text-color);
			cursor: pointer;
			transition:
				border-color 200ms ease,
				background 200ms ease;
		}
		.diary-compose-now:hover {
			border-color: color-mix(in srgb, var(--primary) 45%, transparent);
			background: color-mix(in srgb, var(--primary) 10%, transparent);
		}
		.diary-compose-private {
			display: flex;
			align-items: center;
			gap: 0.45rem;
			font-size: 0.8rem;
			color: color-mix(in srgb, var(--text-color) 70%, transparent);
			cursor: pointer;
		}
		.diary-compose-foot {
			flex: none;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			padding: 0.8rem 1.1rem;
			border-top: 1px solid var(--line-divider);
		}
		.diary-compose-status {
			font-size: 0.75rem;
			color: color-mix(in srgb, var(--text-color) 55%, transparent);
		}
		.diary-compose-status.is-error {
			color: #ef4444;
		}
		.diary-compose-submit {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			border: none;
			border-radius: 0.65rem;
			background: var(--primary);
			color: #fff;
			padding: 0.5rem 1.1rem;
			font-size: 0.85rem;
			cursor: pointer;
			transition: opacity 200ms ease;
		}
		:root.dark .diary-compose-submit {
			color: rgba(0, 0, 0, 0.7);
		}
		.diary-compose-submit:hover {
			opacity: 0.9;
		}
		.diary-compose-submit:disabled {
			opacity: 0.55;
			cursor: not-allowed;
		}

		/* 轻提示 */
		.diary-toast {
			position: fixed;
			left: 50%;
			bottom: 2rem;
			z-index: 9999;
			transform: translateX(-50%);
			border-radius: 999px;
			background: var(--card-bg);
			color: var(--text-color);
			border: 1px solid var(--line-divider);
			box-shadow: 0 10px 30px rgb(0 0 0 / 0.18);
			padding: 0.55rem 1.1rem;
			font-size: 0.82rem;
			animation: diary-compose-pop 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		}
		@keyframes diary-compose-fade {
			from { opacity: 0; }
			to { opacity: 1; }
		}
		@keyframes diary-compose-pop {
			from { opacity: 0; transform: translateY(16px) scale(0.97); }
			to { opacity: 1; transform: translateY(0) scale(1); }
		}
	</style>

	<style is:global>
			/* ===================== 漂浮板：固定高度长方形画布 ===================== */
			.diary-board {
				position: relative;
				height: min(70vh, 42rem);
				min-height: 30rem;
				overflow-y: auto;
				overflow-x: hidden;
				border-radius: 1rem;
				/* 奶油渐变底：跟随主题色（--primary）自动变色，不再是一整片纯白 */
				background:
					radial-gradient(120% 92% at 14% 2%,
						color-mix(in oklch, var(--primary) 20%, white) 0%,
						color-mix(in oklch, var(--primary) 5%, white) 46%,
						transparent 76%),
					radial-gradient(115% 95% at 86% 98%,
						color-mix(in oklch, var(--primary) 16%, white) 0%,
						color-mix(in oklch, var(--primary) 4%, white) 48%,
						transparent 78%),
					linear-gradient(158deg,
						color-mix(in oklch, var(--primary) 10%, white) 0%,
						color-mix(in oklch, var(--primary) 4%, white) 42%,
						color-mix(in oklch, var(--primary) 13%, white) 100%);
				border: 1px solid color-mix(in oklch, var(--primary) 20%, transparent);
				box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.65);
				/* 细滚动条，避免在画布内滚动时显得突兀 */
				scrollbar-width: thin;
				scrollbar-color: color-mix(in oklch, var(--primary) 40%, transparent) transparent;
			}
			/* 淡淡圆点底纹，像软木桌面 */
			.diary-board::before {
				content: "";
				position: absolute;
				inset: 0;
				pointer-events: none;
				opacity: 0.55;
				background-image: radial-gradient(
					color-mix(in oklch, var(--primary) 32%, transparent) 1.1px,
					transparent 1.1px
				);
				background-size: 26px 26px;
			}
			.diary-board-tip {
				height: 100%;
				min-height: 30rem;
				display: flex;
				align-items: center;
				justify-content: center;
				color: color-mix(in srgb, var(--deep-text) 45%, transparent);
			}
			/* 暗色主题：深色渐变底，避免和卡片同色糊成一片 */
			:root.dark .diary-board {
				background:
					radial-gradient(120% 92% at 14% 2%,
						color-mix(in oklch, var(--primary) 30%, var(--card-bg)) 0%,
						color-mix(in oklch, var(--primary) 8%, var(--card-bg)) 48%,
						transparent 78%),
					radial-gradient(115% 95% at 86% 98%,
						color-mix(in oklch, var(--primary) 24%, var(--card-bg)) 0%,
						color-mix(in oklch, var(--primary) 6%, var(--card-bg)) 46%,
						transparent 80%),
					linear-gradient(158deg,
						color-mix(in oklch, var(--primary) 16%, var(--card-bg)) 0%,
						color-mix(in oklch, var(--primary) 7%, var(--card-bg)) 45%,
						color-mix(in oklch, var(--primary) 20%, var(--card-bg)) 100%);
				border-color: color-mix(in oklch, var(--primary) 26%, transparent);
				box-shadow: none;
				scrollbar-color: color-mix(in oklch, var(--primary) 45%, transparent) transparent;
			}

		/* 定位层：负责位置，全程可拖动 */
		.diary-paper-pos {
			position: absolute;
			will-change: transform;
			z-index: 1;
			cursor: grab;
			touch-action: none;
			user-select: none;
		}
		.diary-paper-pos:hover {
			z-index: 30;
		}
		.diary-paper-pos.dragging {
			cursor: grabbing;
			z-index: 40;
