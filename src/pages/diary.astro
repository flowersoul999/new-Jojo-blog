		/* ---------- 视频：读取信息 / 截封面 / 转码 ---------- */
		function formatDuration(sec) {
			if (!isFinite(sec) || sec < 0) return "视频";
			var total = Math.round(sec);
			var m = Math.floor(total / 60);
			var s = total % 60;
			return m + ":" + String(s).padStart(2, "0");
		}

		function readFileAsDataUrl(blob) {
			return new Promise(function (resolve, reject) {
				var reader = new FileReader();
				reader.onload = function () {
					resolve(reader.result);
				};
				reader.onerror = function () {
					reject(new Error("文件读取失败"));
				};
				reader.readAsDataURL(blob);
			});
		}

		// 隐藏的解码用 <video>：必须挂进 DOM，Safari 才肯解码离屏元素
		function createHiddenVideo(url) {
			var v = document.createElement("video");
			v.muted = true;
			v.playsInline = true;
			v.preload = "auto";
			v.setAttribute("aria-hidden", "true");
			v.style.position = "fixed";
			v.style.left = "-9999px";
			v.style.top = "0";
			v.style.width = "1px";
			v.style.height = "1px";
			v.style.opacity = "0";
			v.style.pointerEvents = "none";
			document.body.appendChild(v);
			if (url) v.src = url;
			return v;
		}

		function disposeHiddenVideo(v, url) {
			try {
				v.pause();
			} catch (e) {}
			try {
				v.removeAttribute("src");
				v.load();
			} catch (e) {}
			if (v.parentNode) v.parentNode.removeChild(v);
			try {
				if (url) URL.revokeObjectURL(url);
			} catch (e) {}
		}

		// 读取视频宽高与时长（只加载 metadata，不解码整段）
		function readVideoMeta(file) {
			return new Promise(function (resolve, reject) {
				var url = URL.createObjectURL(file);
				var v = createHiddenVideo(url);
				var timer = setTimeout(function () {
					finish();
					reject(new Error("读取视频信息超时"));
				}, 15000);
				function finish() {
					clearTimeout(timer);
					disposeHiddenVideo(v, url);
				}
				v.onloadedmetadata = function () {
					var meta = {
						width: v.videoWidth || 0,
						height: v.videoHeight || 0,
						duration: v.duration || 0,
					};
					finish();
					resolve(meta);
				};
				v.onerror = function () {
					finish();
					reject(new Error("无法读取该视频，格式可能不受支持"));
				};
				v.src = url;
			});
		}

		// 截取视频首帧当封面（走 canvas → WebP，跟图片压缩同一套路）
		function captureVideoPoster(file, duration) {
			return new Promise(function (resolve, reject) {
				var url = URL.createObjectURL(file);
				var v = createHiddenVideo(url);
				var settled = false;
				var timer = setTimeout(fail, 15000);

				function cleanup() {
					clearTimeout(timer);
					disposeHiddenVideo(v, url);
				}
				function fail() {
					if (settled) return;
					settled = true;
					cleanup();
					reject(new Error("无法截取视频封面"));
				}
				function grab() {
					if (settled) return;
					var w = v.videoWidth || 640;
					var h = v.videoHeight || 360;
					var ratio = Math.min(1, VIDEO_POSTER_EDGE / Math.max(w, h));
					var cw = Math.max(2, Math.round(w * ratio));
					var ch = Math.max(2, Math.round(h * ratio));
					var canvas = document.createElement("canvas");
					canvas.width = cw;
					canvas.height = ch;
					var ctx = canvas.getContext("2d");
					if (!ctx) return fail();
					try {
						ctx.drawImage(v, 0, 0, cw, ch);
					} catch (e) {
						return fail();
					}
					canvas.toBlob(
						function (blob) {
							if (settled) return;
							if (!blob) return fail();
							settled = true;
							cleanup();
							var reader = new FileReader();
							reader.onload = function () {
								resolve({
									dataUrl: reader.result,
									width: cw,
									height: ch,
									size: blob.size,
								});
							};
							reader.onerror = fail;
							reader.readAsDataURL(blob);
						},
						"image/webp",
						IMAGE_QUALITY
					);
				}

				// 首帧常是黑屏，稍微往里挪一点再截
				v.onloadeddata = function () {
					var target = Math.min(0.3, (duration || v.duration || 1) / 2);
					try {
						v.currentTime = target;
					} catch (e) {
						grab();
					}
				};
				v.onseeked = grab;
				v.onerror = fail;
				v.src = url;
			});
		}

		// MediaRecorder 可用的封装格式：Chrome/Firefox 出 WebM，Safari 出 MP4
		function pickRecorderMime() {
			if (typeof MediaRecorder === "undefined") return "";
			var candidates = [
				"video/webm;codecs=vp9,opus",
				"video/webm;codecs=vp8,opus",
				"video/webm",
				"video/mp4;codecs=avc1,mp4a.40.2",
				"video/mp4",
			];
			for (var i = 0; i < candidates.length; i++) {
				try {
					if (MediaRecorder.isTypeSupported(candidates[i])) return candidates[i];
				} catch (e) {}
			}
			return "";
		}

		function canCompressVideo() {
			if (typeof MediaRecorder === "undefined") return false;
			if (typeof document === "undefined") return false;
			var c = document.createElement("canvas");
			return (
				typeof c.captureStream === "function" &&
				typeof window.requestAnimationFrame === "function"
			);
		}

		function evenSize(n) {
			var v = Math.max(2, Math.round(n));
			return v % 2 === 0 ? v : v + 1;
		}

		// 转码：把视频按目标尺寸画到 canvas，再用 MediaRecorder 重录一遍（边播边录）
		// 注意：这一步是实时的，耗时≈视频时长，期间页面要在前台（切走标签页 rAF 会暂停）
		function compressVideo(file, meta, onProgress) {
			return new Promise(function (resolve, reject) {
				var srcUrl = URL.createObjectURL(file);
				var src = createHiddenVideo(srcUrl);
				// 先用「音量 0 但不静音」播放：这样原音轨还能被 captureStream 捕获；
				// 若被自动播放策略拦下，再退化成静音播放（代价是录出来没有声音）
				src.muted = false;
				src.volume = 0;

				var maxEdge = Math.max(meta.width || 640, meta.height || 360);
				var ratio = Math.min(1, VIDEO_TARGET_EDGE / maxEdge);
				var w = evenSize((meta.width || 640) * ratio);
				var h = evenSize((meta.height || 360) * ratio);

				var canvas = document.createElement("canvas");
				canvas.width = w;
				canvas.height = h;
				var ctx = canvas.getContext("2d");
				if (!ctx) {
					disposeHiddenVideo(src, srcUrl);
					return reject(new Error("无法初始化画布"));
				}

				var fps = Math.min(VIDEO_TARGET_FPS, 30);
				var stream = canvas.captureStream(fps);
				// 尽力带上原音轨（Chrome 系可用，拿不到就静音）
				try {
					if (typeof src.captureStream === "function") {
						var ms = src.captureStream();
						var tracks = ms.getAudioTracks ? ms.getAudioTracks() : [];
						for (var i = 0; i < tracks.length; i++) {
							stream.addTrack(tracks[i]);
						}
					}
				} catch (e) {}

				var mime = pickRecorderMime();
				var rec;
				try {
					rec = new MediaRecorder(
						stream,
						mime
							? {
									mimeType: mime,
									videoBitsPerSecond: VIDEO_TARGET_BITRATE,
									audioBitsPerSecond: 128000,
								}
							: undefined
					);
				} catch (e) {
					disposeHiddenVideo(src, srcUrl);
					return reject(new Error("当前浏览器不支持视频转码"));
				}

				var chunks = [];
				var stopped = false;
				var rafId = 0;
				var guard = setTimeout(function () {
					stop(new Error("转码超时，已放弃压缩"));
				}, (meta.duration || 30) * 3000 + 30000);

				rec.ondataavailable = function (e) {
					if (e.data && e.data.size) chunks.push(e.data);
				};
				rec.onerror = function () {
					stop(new Error("录制失败"));
				};
				rec.onstop = function () {
					if (stopped) return;
					stopped = true;
					clearTimeout(guard);
					cancelAnimationFrame(rafId);
					try {
						disposeHiddenVideo(src, srcUrl);
					} catch (e) {}
					try {
						src.pause();
					} catch (e) {}
					if (!chunks.length) return reject(new Error("转码结果为空"));
					var outMime = mime || chunks[0].type || "video/webm";
					resolve(new Blob(chunks, { type: outMime }));
				};

				function stop(err) {
					if (stopped) return;
					if (err) {
						stopped = true;
						clearTimeout(guard);
						cancelAnimationFrame(rafId);
						try {
							rec.stop();
						} catch (e) {}
						try {
							disposeHiddenVideo(src, srcUrl);
						} catch (e) {}
						return reject(err);
					}
					try {
						rec.stop();
					} catch (e) {
						reject(new Error("录制结束失败"));
					}
				}

				function draw() {
					if (stopped) return;
					try {
						ctx.drawImage(src, 0, 0, w, h);
					} catch (e) {}
					if (typeof onProgress === "function" && meta.duration) {
						onProgress(Math.min(1, src.currentTime / meta.duration));
					}
					if (src.ended || src.currentTime >= (meta.duration || 0) - 0.05) {
						stop();
						return;
					}
					rafId = requestAnimationFrame(draw);
				}

				src.onloadeddata = function () {
					var playPromise = src.play();
					if (playPromise && typeof playPromise.catch === "function") {
						playPromise.catch(function () {
							// 被自动播放策略拦了 → 静音重放（画面照转，音轨放弃）
							try {
								src.muted = true;
								var p2 = src.play();
								if (p2 && typeof p2.catch === "function") {
									p2.catch(function () {});
								}
							} catch (e) {}
						});
					}
					try {
						rec.start(1000);
					} catch (e) {
						stop(new Error("无法开始录制"));
						return;
					}
					rafId = requestAnimationFrame(draw);
				};
				src.onerror = function () {
					stop(new Error("无法播放该视频"));
				};
			});
		}

		// 选中视频 → 按需转码 + 截封面 → 加入列表（落盘在发表时统一做）
		function addVideoFiles(files) {
			var arr = Array.prototype.slice.call(files || []).filter(function (f) {
				return f.type && f.type.indexOf("video/") === 0;
			});
			if (!arr.length) return Promise.resolve(0);

			var queue = arr.slice();
			var total = queue.length;
			var done = 0;
			var added = 0;

			function next() {
				if (!queue.length) {
					setComposeStatus("");
					if (added) showToast("已添加 " + added + " 个视频");
					return Promise.resolve(added);
				}
				var file = queue.shift();
				var index = ++done;
				if (file.size > MAX_VIDEO_SIZE) {
					showToast(file.name + " 超过 60 MB，已跳过");
					return next();
				}

				setComposeStatus("正在读取视频 " + index + "/" + total + "：" + file.name);

				return readVideoMeta(file)
					.then(function (meta) {
						var shouldCompress =
							canCompressVideo() &&
							file.size > VIDEO_COMPRESS_MIN_SIZE &&
							meta.duration > 0 &&
							meta.duration <= VIDEO_COMPRESS_MAX_DURATION;

						var blobPromise = Promise.resolve(file);
						if (shouldCompress) {
							blobPromise = compressVideo(file, meta, function (pct) {
								setComposeStatus(
									"正在转码视频 " +
										index +
										"/" +
										total +
										"：" +
										Math.round(pct * 100) +
										"%"
								);
							}).then(function (blob) {
								// 转完反而更大就弃用，直接传原片
								if (blob && blob.size < file.size) return blob;
								return file;
							});
						}

						// 封面帧独立于转码结果，从原片截更稳（转码产物是 webm 时 seek 不一定顺）
						return Promise.all([
							blobPromise,
							captureVideoPoster(file, meta.duration),
						]).then(function (res) {
							var blob = res[0] || file;
							var poster = res[1] || null;
							pendingVideos.push({
								id: "vid-" + Date.now() + "-" + Math.random().toString(36).slice(2, 8),
								type: "video",
								kind: "file",
								name: file.name,
								blob: blob,
								mime: blob.type || "",
								url: "",
								posterDataUrl: poster ? poster.dataUrl : "",
								poster: "",
								width: meta.width || (poster ? poster.width : 0),
								height: meta.height || (poster ? poster.height : 0),
								size: blob.size,
								duration: meta.duration || 0,
								busy: false,
							});
							added++;
							renderThumbs();
							return next();
						});
					})
					.catch(function (err) {
						console.error("视频处理失败", file, err);
						showToast(file.name + "：" + (err.message || "处理失败"));
						return next();
					});
			}

			return next();
		}

		// 选中文件 → 按类型分流（图片压缩 / 视频转码）→ 加入列表（此时还未落盘，发表时统一上传）
		function addPickedFiles(files) {
			var arr = Array.prototype.slice.call(files || []);
			var videos = arr.filter(function (f) {
				return f.type && f.type.indexOf("video/") === 0;
			});
			var images = arr.filter(function (f) {
				return f.type && f.type.indexOf("image/") === 0;
			});
			var others = arr.length - videos.length - images.length;
			if (others > 0) {
				showToast(others + " 个文件既不是图片也不是视频，已忽略");
			}
			addImageFiles(images);
			// 视频是串行的（要边播边录），放在图片之后处理
			return addVideoFiles(videos);
		}

		function addImageFiles(files) {
			var arr = Array.prototype.slice.call(files || []);
			var imageFiles = arr.filter(function (f) {
				return f.type && f.type.indexOf("image/") === 0;
			});
			if (!imageFiles.length) return;

			var queue = imageFiles.slice();
			var total = queue.length;
			var done = 0;
			var added = 0;

			function next() {
				if (!queue.length) {
					setComposeStatus("");
					if (added) showToast("已添加 " + added + " 张图片（已压缩）");
					return;
				}
				var file = queue.shift();
				var index = ++done;
				setComposeStatus("正在压缩 " + index + "/" + total + "：" + file.name);

				if (file.size > MAX_IMAGE_SIZE) {
					showToast(file.name + " 超过 15 MB，已跳过");
					next();
					return;
				}

				compressImage(file)
					.then(function (res) {
						pendingImages.push({
							id: "img-" + Date.now() + "-" + Math.random().toString(36).slice(2, 8),
							name: file.name,
							dataUrl: res.dataUrl,
							width: res.width,
							height: res.height,
							size: res.size,
							busy: false,
						});
						added++;
						renderThumbs();
						next();
					})
					.catch(function (err) {
						console.error("图片压缩失败", file, err);
						showToast(file.name + " 压缩失败，已跳过");
						next();
					});
			}

			next();
		}

		// 粘贴图片 / 视频链接（回车添加）：按扩展名分流
		function addUrlMedia() {
			var url = composeUrl.value.trim();
			if (!url) return;
			var clean = url.split("?")[0].split("#")[0].toLowerCase();
			var isVideo = /\.(mp4|webm|mov|m4v|ogv)$/.test(clean);
			var exists = pendingImages.concat(pendingVideos).some(function (x) {
				return x.kind === "url" && x.url === url;
			});
			if (exists) {
				showToast("该链接已在列表中");
				return;
			}
			var id = (isVideo ? "vid-" : "img-") + Date.now() + "-" + Math.random().toString(36).slice(2, 8);
			if (isVideo) {
				pendingVideos.push({
					id: id,
					type: "video",
					kind: "url",
					name: url.split("/").pop() || "外链视频",
					url: url,
					poster: "",
					posterDataUrl: "",
					size: 0,
					duration: 0,
					busy: false,
				});
			} else {
				pendingImages.push({
					id: id,
					kind: "url",
					url: url,
					dataUrl: "",
					busy: false,
				});
			}
			composeUrl.value = "";
			renderThumbs();
		}

		function openCompose() {
			setComposeStatus("");
			composeModal.hidden = false;
			// 每次打开都默认「此刻」，要补记往期日记再手动改时间
			composeDate.value = localDateStr();
			renderThumbs();
			composeContent.focus();
		}

		function closeCompose() {
			composeModal.hidden = true;
		}

		// 统一的「dataURL → 仓库文件」上传（走 /api/content/write/，base64）
		function postFile(path, dataUrl, message) {
			return fetch("/api/content/write/", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					path: path,
					content: (dataUrl || "").split(",")[1] || "",
					encoding: "base64",
					message: message,
				}),
			}).then(function (r) {
				return r.json().then(function (data) {
					if (!r.ok) throw new Error(data.error || "上传失败");
					return data;
				});
			});
		}

		// 把压缩后的 dataURL 落到 public/diary/images/{时间戳}-{随机}.webp
		// 文件名沿用既有 images/ 目录里的格式；已拿到 url 的直接跳过（失败重试时幂等）
		function uploadDiaryImage(item) {
			if (item.url) return Promise.resolve(item.url);
			var filename =
				Date.now() + "-" + Math.random().toString(36).slice(2, 8) + ".webp";
			var publicPath = "/diary/images/" + filename;
			return postFile(
				DIARY_IMAGE_DIR + "/" + filename,
				item.dataUrl,
				"上传日记图片: " + (item.name || filename)
			).then(function () {
				item.url = publicPath;
				item.busy = false;
				return publicPath;
			});
		}

		// 视频落到 public/diary/videos/{时间戳}-{随机}.{mp4|webm}
		function uploadDiaryVideo(item) {
			if (item.url) return Promise.resolve(item.url);
			var base = Date.now() + "-" + Math.random().toString(36).slice(2, 8);
			// 扩展名跟着实际 mime 走：Safari 录出来是 mp4，Chrome/Firefox 是 webm
			var ext = item.mime && item.mime.indexOf("mp4") >= 0 ? "mp4" : "webm";
			var filename = base + "." + ext;
			var publicPath = "/diary/videos/" + filename;
			item.posterName = base + ".webp";
			return readFileAsDataUrl(item.blob)
				.then(function (dataUrl) {
					return postFile(
						DIARY_VIDEO_DIR + "/" + filename,
						dataUrl,
						"上传日记视频: " + (item.name || filename)
					);
				})
				.then(function () {
					item.url = publicPath;
					item.busy = false;
					return publicPath;
				});
		}

		// 视频封面帧单独落一张 webp，纸片缩略图和详情页 poster 都用它
		function uploadDiaryPoster(item) {
			if (!item.posterDataUrl || item.poster) {
				return Promise.resolve(item.poster || "");
			}
			var filename = item.posterName || Date.now() + "-" + Math.random().toString(36).slice(2, 8) + ".webp";
			return postFile(
				DIARY_VIDEO_DIR + "/" + filename,
				item.posterDataUrl,
				"上传日记视频封面: " + (item.name || filename)
			).then(function () {
				item.poster = "/diary/videos/" + filename;
				return item.poster;
			});
		}

		// 生成 slug：diary-YYYYMMDD-xxxxxx（与现有数据格式一致）
		// 传 dateStr（YYYY-MM-DDTHH:mm）时按该日期取年月日，便于补记往期日记
		function genSlug(dateStr) {
			var d = dateStr ? new Date(dateStr) : new Date();
			if (isNaN(d.getTime())) d = new Date();
			var ymd =
				d.getFullYear() +
				String(d.getMonth() + 1).padStart(2, "0") +
				String(d.getDate()).padStart(2, "0");
			var rand = Math.random().toString(36).slice(2, 8);
			return "diary-" + ymd + "-" + rand;
		}

		// 把 Date 格式化成与现有数据一致的本地时间串：YYYY-MM-DDTHH:mm
		function toLocalDateStr(d) {
			return (
				d.getFullYear() +
				"-" +
				String(d.getMonth() + 1).padStart(2, "0") +
				"-" +
				String(d.getDate()).padStart(2, "0") +
				"T" +
				String(d.getHours()).padStart(2, "0") +
				":" +
				String(d.getMinutes()).padStart(2, "0")
			);
		}

		function localDateStr() {
			return toLocalDateStr(new Date());
		}

		// 读取「时间」行选中的值：空或非法一律回退到当前时刻（datetime-local 的值本身就是 YYYY-MM-DDTHH:mm[:ss]）
		function composeDateValue() {
			var v = composeDate && composeDate.value ? composeDate.value.trim().slice(0, 16) : "";
			if (!v || isNaN(new Date(v).getTime())) return localDateStr();
			return v;
		}

		function submitCompose() {
			if (composeSaving) return;
			var content = composeContent.value.trim();
			if (!content) {
				setComposeStatus("内容不能为空", true);
				return;
			}
			var localImages = pendingImages.filter(function (x) {
				return x.kind !== "url";
			});
			var localVideos = pendingVideos.filter(function (x) {
				return x.kind !== "url";
			});

			composeSaving = true;
			composeSubmit.disabled = true;

			// 先把所有本地图片压缩产物落盘，拿到最终 URL 后再写日记 JSON
			var uploadAll = localImages.reduce(
				function (chain, item, i) {
					return chain.then(function () {
						item.busy = true;
						renderThumbs();
						setComposeStatus(
							"正在上传图片 " + (i + 1) + "/" + localImages.length + "…"
						);
						return uploadDiaryImage(item);
					});
				},
				Promise.resolve()
			);

			// 视频串行上传：先视频本体，再它的封面帧
			uploadAll = localVideos.reduce(function (chain, item, i) {
				return chain
					.then(function () {
						item.busy = true;
						renderThumbs();
						setComposeStatus(
							"正在上传视频 " + (i + 1) + "/" + localVideos.length + "…"
						);
						return uploadDiaryVideo(item);
					})
					.then(function () {
						if (!item.posterDataUrl) return "";
						setComposeStatus(
							"正在上传视频封面 " + (i + 1) + "/" + localVideos.length + "…"
						);
						return uploadDiaryPoster(item);
					});
			}, uploadAll);

			uploadAll
				.then(function () {
					var when = composeDateValue();
					var entry = {
						slug: genSlug(when),
						title: composeTitle.value.trim(),
						content: content,
						date: when,
						tags: [],
						images: pendingImages.map(function (item) {
							return { url: item.url };
						}),
						videos: pendingVideos.map(function (item) {
							return {
								url: item.url,
								poster: item.poster || "",
								width: item.width || 0,
								height: item.height || 0,
								size: item.size || 0,
								duration: item.duration || 0,
							};
						}),
						isPrivate: composePrivate.checked,
						mood: composeMood,
					};

					setComposeStatus("正在保存...");

					// 先读最新文件内容和 sha（GitHub Contents API 更新时必须带 sha），避免覆盖别处的新改动
					return fetch(
						"/api/content/read/?path=" + encodeURIComponent(DIARY_JSON_PATH)
					)
						.then(function (r) {
							if (!r.ok) throw new Error("读取日记数据失败");
							return r.json();
						})
						.then(function (file) {
							var arr;
							try {
								arr = JSON.parse(file.content || "[]");
							} catch (e) {
								arr = [];
							}
							if (!Array.isArray(arr)) arr = [];
							arr.unshift(entry);
							return fetch("/api/content/write/", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({
									path: DIARY_JSON_PATH,
									content: JSON.stringify(arr, null, 2) + "\n",
									sha: file.sha,
									message: "新增日记: " + (entry.title || entry.slug),
								}),
							});
						})
						.then(function (r) {
							return r.json().then(function (data) {
								if (!r.ok) throw new Error(data.error || "保存失败");
								// 立即更新本地数据并重渲染，无需等部署
								entries.unshift(entry);
								renderBoard();
								closeCompose();
								composeTitle.value = "";
								composeContent.value = "";
								composeUrl.value = "";
								pendingImages = [];
								pendingVideos = [];
								renderThumbs();
								composePrivate.checked = false;
								composeDate.value = localDateStr();
								showToast("日记已发表，全站生效约需 1-2 分钟（等待重新部署）");
							});
						});
				})
				.catch(function (err) {
					// 图片 / 视频可能已部分落盘，重试时靠已拿到的 url 跳过（幂等）
					pendingImages.concat(pendingVideos).forEach(function (item) {
						item.busy = false;
					});
					renderThumbs();
					setComposeStatus(err.message || "保存失败", true);
				})
				.finally(function () {
					composeSaving = false;
					composeSubmit.disabled = false;
				});
		}

		composeBtn.addEventListener("click", openCompose);
		composeClose.addEventListener("click", closeCompose);
		composeMask.addEventListener("click", closeCompose);
		composeSubmit.addEventListener("click", submitCompose);
		composeNow.addEventListener("click", function () {
			composeDate.value = localDateStr();
		});

		/* 照片 / 视频：点击选文件 / 拖拽 / 粘贴链接 */
		composeDrop.addEventListener("click", function () {
			composeFile.click();
		});
		composeFile.addEventListener("change", function () {
			addPickedFiles(composeFile.files);
			composeFile.value = "";
		});
		composeUrl.addEventListener("keydown", function (e) {
			if (e.key === "Enter") {
				e.preventDefault();
				addUrlMedia();
			}
		});
		// 整个弹窗都作为拖放区：从桌面拖照片或视频进来松手即可添加
		["dragenter", "dragover"].forEach(function (type) {
			composeModal.addEventListener(type, function (e) {
				if (!e.dataTransfer || Array.prototype.indexOf.call(e.dataTransfer.types || [], "Files") === -1) {
					return;
				}
				e.preventDefault();
				composeDrop.classList.add("is-drag");
			});
		});
		["dragleave", "dragend"].forEach(function (type) {
			composeModal.addEventListener(type, function () {
				composeDrop.classList.remove("is-drag");
			});
		});
		composeModal.addEventListener("drop", function (e) {
			if (!e.dataTransfer || !e.dataTransfer.files || !e.dataTransfer.files.length) return;
			e.preventDefault();
			composeDrop.classList.remove("is-drag");
			addPickedFiles(e.dataTransfer.files);
		});
		document.addEventListener("keydown", function (e) {
			if (e.key === "Escape" && !composeModal.hidden) closeCompose();
		});

		/* ---------- 登录状态：已登录则显示「写日记」按钮 ---------- */
		fetch("/api/auth/status/", { credentials: "same-origin" })
			.then(function (r) {
				return r.json();
			})
			.then(function (data) {
				if (data.authenticated) {
					composeBtn.hidden = false;
					composeBtn.classList.remove("hidden");
					composeBtn.classList.add("inline-flex");
				}
			})
			.catch(function () {
				/* 未登录则保持隐藏 */
			});

		/* ---------- 加载数据 ---------- */
		fetch("/diary/index.json")
			.then(function (r) {
				return r.json();
			})
			.then(function (data) {
				entries = data;
				renderBoard();
			})
			.catch(function (err) {
				console.error("Failed to load diary:", err);
				board.innerHTML = '<div class="diary-board-tip">日记加载失败</div>';
			});
	})();
	</script>
</MainGridLayout>
