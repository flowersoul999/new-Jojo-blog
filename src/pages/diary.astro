		/* ---------- 图片：压缩（与 src/utils/image-compress.ts 同算法） ---------- */
		// 这里不能直接 import 工具函数（页面脚本是 is:inline，不经过打包），
		// 所以按同一套参数内联一份：createImageBitmap 解码 → canvas 等比缩放 → toBlob('image/webp', 0.8)
		function formatBytes(bytes) {
			if (bytes < 1024) return bytes + " B";
			if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
			return (bytes / 1024 / 1024).toFixed(2) + " MB";
		}

		function compressImage(file) {
			return new Promise(function (resolve, reject) {
				var done = function (source, w, h) {
					var ratio = Math.min(1, IMAGE_MAX_EDGE / Math.max(w, h));
					var width = Math.max(1, Math.round(w * ratio));
					var height = Math.max(1, Math.round(h * ratio));
					var canvas = document.createElement("canvas");
					canvas.width = width;
					canvas.height = height;
					var ctx = canvas.getContext("2d");
					if (!ctx) return reject(new Error("无法初始化画布"));
					ctx.drawImage(source, 0, 0, width, height);
					canvas.toBlob(
						function (blob) {
							if (!blob) return reject(new Error("无法生成图片文件"));
							var reader = new FileReader();
							reader.onload = function () {
								resolve({
									dataUrl: reader.result,
									width: width,
									height: height,
									size: blob.size,
								});
							};
							reader.onerror = function () {
								reject(new Error("图片读取失败"));
							};
							reader.readAsDataURL(blob);
						},
						"image/webp",
						IMAGE_QUALITY
					);
				};

				if (typeof createImageBitmap === "function") {
					createImageBitmap(file)
						.then(function (bitmap) {
							done(bitmap, bitmap.width, bitmap.height);
						})
						.catch(function () {
							reject(new Error("无法解码该图片，格式可能不受支持"));
						});
					return;
				}
				// 旧浏览器回退：<img> 解码
				var objUrl = URL.createObjectURL(file);
				var img = new Image();
				img.onload = function () {
					var w = img.naturalWidth;
					var h = img.naturalHeight;
					URL.revokeObjectURL(objUrl);
					done(img, w, h);
				};
				img.onerror = function () {
					URL.revokeObjectURL(objUrl);
					reject(new Error("无法解码该图片，格式可能不受支持"));
				};
				img.src = objUrl;
			});
		}

