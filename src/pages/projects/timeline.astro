---
// 项目时间线：按时间正序铺开，桌面左右交错，移动端单侧
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import PageEditor from "@/components/edit/PageEditor.svelte";
import {
	PROJECT_CATEGORY_MAP,
	PROJECT_STATUS_MAP,
	PROJECT_VIEWS,
} from "@/data/projects";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export const prerender = true;

const entries = (await getCollection("projects", ({ data }) => !data.draft))
	// 时间线要「从早到晚」，所以按 start 升序，和项目墙的推荐序相反
	.sort((a, b) => a.data.start.getTime() - b.data.start.getTime());

interface TimelineItem {
	id: string;
	title: string;
	summary: string;
	role: string;
	period: string;
	year: string;
	status: string;
	category: string;
	stack: string[];
	metrics: { label: string; value: string }[];
	icon: string;
	featured: boolean;
}

function fmt(d: Date) {
	return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}`;
}

const items: TimelineItem[] = entries.map((entry) => ({
	id: entry.id,
	title: entry.data.title,
	summary: entry.data.summary,
	role: entry.data.role,
	period: entry.data.end
		? `${fmt(entry.data.start)} – ${fmt(entry.data.end)}`
		: `${fmt(entry.data.start)} – 至今`,
	year: String(entry.data.start.getFullYear()),
	status: entry.data.status,
	category: entry.data.category,
	stack: entry.data.stack.slice(0, 5),
	metrics: entry.data.metrics.slice(0, 2),
	icon: entry.data.icon,
	featured: entry.data.featured,
}));

/** 按年分组，段头显示当年项目数 */
const groups: { year: string; items: TimelineItem[] }[] = [];
for (const item of items) {
	const last = groups[groups.length - 1];
	if (last && last.year === item.year) last.items.push(item);
	else groups.push({ year: item.year, items: [item] });
}

const title = "项目时间线";
const description =
	"从最早的项目到现在，按时间正序排开——看看我是怎么一步步从课程作业走到 AI Agent 的。";

const editableFiles = [
	...entries.map((entry) => ({
		path: `src/content/projects/${entry.id}.md`,
		label: `项目：${entry.data.title}`,
		hint: entry.data.category,
	})),
	{
		path: "src/pages/projects/timeline.astro",
		label: "页面骨架",
		hint: "时间线的分组与排版逻辑",
	},
];
---

<MainGridLayout title={title} description={description} hideSidebars fullWidth>
	<div class="pj card-base relative z-10 w-full" data-pj-root>
		<div class="pj-shell mx-auto w-full max-w-[78rem] px-4 sm:px-6 md:px-8 py-6 sm:py-8">
			<div class="pj-mobile-title lg:hidden">
				<span class="pj-mobile-title__kicker">TIMELINE</span>
				<span class="pj-mobile-title__text">{title}</span>
			</div>

			<nav class="pj-views" aria-label="视图切换">
				{
					PROJECT_VIEWS.map((view) => (
						<a
							class:list={["pj-view", { "is-on": view.key === "timeline" }]}
							href={view.href}
						>
							{view.label}
						</a>
					))
				}
			</nav>

			<header class="pj-tlhead" data-pj-reveal>
				<div class="pj-tlhead__kicker">PROJECTS · TIMELINE</div>
				<h1 class="pj-tlhead__title">{title}</h1>
				<p class="pj-tlhead__desc">{description}</p>
				<div class="pj-tlhead__actions">
					<PageEditor title="编辑项目时间线" files={editableFiles} client:load />
				</div>
			</header>

			{groups.length === 0 ? (
				<div class="pj-empty">
					<p>还没有项目，去 <code>src/content/projects/</code> 加一篇md 吧。</p>
				</div>
			) : (
				<div class="pj-tl">
					{groups.map((group) => (
						<section class="pj-tl__year">
							<h2 class="pj-tl__year-label">
								<span class="pj-tl__year-num">{group.year}</span>
								<span class="pj-tl__year-count">{group.items.length} 个项目</span>
							</h2>

							<ol class="pj-tl__list">
								{group.items.map((item, index) => {
									const status = PROJECT_STATUS_MAP[item.status];
									const category = PROJECT_CATEGORY_MAP[item.category];
									const mark = item.icon || item.title.charAt(0) || "P";
									return (
										<li
											class:list={["pj-tl__item", { "is-left": index % 2 === 1 }]}
											data-pj-reveal
										>
											<span class="pj-tl__node" aria-hidden="true">
												<Icon is:inline name="material-symbols:circle" />
											</span>

											<article class="pj-tl__card">
												<div class="pj-tl__cardhead">
													<span class="pj-tl__mark" aria-hidden="true">
														{mark}
													</span>
													<div class="pj-tl__ident">
														<h3 class="pj-tl__title">
															<a href={`/projects/${item.id}/`}>{item.title}</a>
														</h3>
														<p class="pj-tl__meta">
															<span>{item.role}</span>
															<span aria-hidden="true">·</span>
															<span>{item.period}</span>
														</p>
													</div>
													<div class="pj-tl__badges">
														{item.featured && (
															<span class="pj-tl__star" title="代表作">
																<Icon is:inline name="material-symbols:star" />
															</span>
														)}
														<span
															class:list={[
																"pj-tl__status",
																`pj-tl__status--${status?.tone ?? "gray"}`,
															]}
														>
															{item.status}
														</span>
													</div>
												</div>

												<p class="pj-tl__summary">{item.summary}</p>

												{item.metrics.length > 0 && (
													<ul class="pj-tl__metrics">
														{item.metrics.map((metric) => (
															<li>
																<span class="pj-tl__metric-value">{metric.value}</span>
																<span class="pj-tl__metric-label">{metric.label}</span>
															</li>
														))}
													</ul>
												)}

												<div class="pj-tl__foot">
													{category && (
														<span class="pj-tl__cat">
															<Icon is:inline name={category.icon} />
															<span>{category.label}</span>
														</span>
													)}
													<ul class="pj-tl__stack">
														{item.stack.map((tech) => (
															<li class="pj-stacktag">{tech}</li>
														))}
													</ul>
												</div>
											</article>
										</li>
									);
								})}
							</ol>
						</section>
					))}
				</div>
			)}

			<div class="pj-foot">
				<a class="pj-foot__link" href="/projects/">
					<Icon is:inline name="material-symbols:grid-view-rounded" />
					回项目墙
				</a>
				<a class="pj-foot__link" href="/projects/stack/">
					<Icon is:inline name="material-symbols:layers-rounded" />
					看技术栈
				</a>
			</div>
		</div>
	</div>

	<style is:global>
		.pj {
			--pj-accent: var(--primary);
			--pj-soft: color-mix(in srgb, var(--primary) 12%, transparent);
			--pj-title: var(--text-color);
			--pj-body: color-mix(in srgb, var(--text-color) 76%, transparent);
			--pj-muted: color-mix(in srgb, var(--text-color) 58%, transparent);
			--pj-faint: color-mix(in srgb, var(--text-color) 44%, transparent);
			--pj-line: var(--line-divider);
			--pj-surface: var(--card-bg);
			--pj-sunken: color-mix(in srgb, var(--text-color) 6%, transparent);
		}
		.pj-shell {
			min-width: 0;
		}

		.pj-mobile-title {
			display: flex;
			flex-direction: column;
			gap: 0.1rem;
			margin-bottom: 1.3rem;
		}
		.pj-mobile-title__kicker {
			font-size: 0.62rem;
			font-weight: 700;
			letter-spacing: 0.24em;
			color: var(--pj-accent);
		}
		.pj-mobile-title__text {
			font-size: clamp(1.6rem, 8vw, 2.1rem);
			font-weight: 800;
			line-height: 1.12;
			color: var(--pj-title);
		}

		/* ===================== 视图切换 ===================== */
		.pj-views {
			display: inline-flex;
			gap: 0.25rem;
			margin-bottom: 1.3rem;
			padding: 0.25rem;
			border-radius: 999px;
			border: 1px solid var(--pj-line);
			background: var(--pj-sunken);
		}
		.pj-view {
			padding: 0.32rem 0.8rem;
			border-radius: 999px;
			font-size: 0.78rem;
			font-weight: 600;
			color: var(--pj-muted);
			text-decoration: none;
			transition:
				background 180ms ease,
				color 180ms ease;
		}
		.pj-view:hover {
			color: var(--pj-accent);
		}
		.pj-view.is-on {
			background: var(--pj-accent);
			color: var(--pj-on-accent, #ffffff);
			font-weight: 700;
		}
		html.dark .pj-view.is-on {
			color: rgb(0 0 0 / 0.8);
		}

		/* ===================== 页头 ===================== */
		.pj-tlhead {
			padding-bottom: 1.15rem;
			margin-bottom: 1.8rem;
			border-bottom: 1px dashed var(--pj-line);
		}
		.pj-tlhead__kicker {
			font-size: 0.66rem;
			font-weight: 700;
			letter-spacing: 0.22em;
			color: var(--pj-accent);
		}
		.pj-tlhead__title {
			margin: 0.15rem 0 0;
			font-size: clamp(1.5rem, 4vw, 2rem);
			font-weight: 800;
			line-height: 1.15;
			color: var(--pj-title);
		}
		.pj-tlhead__desc {
			margin: 0.45rem 0 0;
			font-size: 0.87rem;
			line-height: 1.7;
			color: var(--pj-muted);
		}
		.pj-tlhead__actions:empty {
			display: none;
		}

		/* ===================== 时间线 ===================== */
		.pj-tl {
			display: flex;
			flex-direction: column;
			gap: 2.2rem;
		}
		.pj-tl__year-label {
			display: flex;
			align-items: baseline;
			gap: 0.6rem;
			margin: 0 0 1rem;
		}
		.pj-tl__year-num {
			font-size: 1.5rem;
			font-weight: 800;
			line-height: 1;
			color: var(--pj-accent);
			font-variant-numeric: tabular-nums;
		}
		.pj-tl__year-count {
			font-size: 0.72rem;
			color: var(--pj-faint);
		}

		.pj-tl__list {
			position: relative;
			display: flex;
			flex-direction: column;
			gap: 1rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}
		/* 中轴：移动端在左侧，桌面也在左侧，靠卡片左右交错体现时间感 */
		.pj-tl__list::before {
			content: "";
			position: absolute;
			top: 0.6rem;
			bottom: 0.6rem;
			left: 0.55rem;
			width: 1px;
			background: var(--pj-line);
		}

		.pj-tl__item {
			position: relative;
			padding-left: 1.6rem;
		}
		.pj-tl__node {
			position: absolute;
			top: 0.7rem;
			left: 0;
			display: flex;
			color: var(--pj-accent);
			font-size: 0.75rem;
		}

		.pj-tl__card {
			padding: 1rem 1.05rem;
			border-radius: 16px;
			border: 1px solid var(--pj-line);
			background: var(--pj-surface);
			transition:
				border-color 200ms ease,
				transform 200ms ease;
		}
		.pj-tl__card:hover {
			border-color: color-mix(in srgb, var(--pj-accent) 45%, transparent);
			transform: translateY(-2px);
		}

		.pj-tl__cardhead {
			display: flex;
			align-items: flex-start;
			gap: 0.65rem;
		}
		.pj-tl__mark {
			flex: none;
			width: 2.2rem;
			height: 2.2rem;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 12px;
			background: var(--pj-soft);
			color: var(--pj-accent);
			font-size: 0.95rem;
			font-weight: 800;
		}
		.pj-tl__ident {
			min-width: 0;
			flex: 1;
		}
		.pj-tl__title {
			margin: 0;
			font-size: 0.98rem;
			font-weight: 800;
			line-height: 1.35;
			color: var(--pj-title);
		}
		.pj-tl__title a {
			color: inherit;
			text-decoration: none;
		}
		.pj-tl__title a:hover {
			color: var(--pj-accent);
		}
		.pj-tl__meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.3rem;
			margin: 0.2rem 0 0;
			font-size: 0.73rem;
			color: var(--pj-muted);
		}
		.pj-tl__badges {
			flex: none;
			display: flex;
			align-items: center;
			gap: 0.3rem;
		}
		.pj-tl__star {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 1.3rem;
			height: 1.3rem;
			border-radius: 8px;
			background: color-mix(in srgb, #f5a524 18%, transparent);
			color: #f5a524;
			font-size: 0.85rem;
		}
		.pj-tl__status {
			padding: 0.12rem 0.55rem;
			border-radius: 999px;
			font-size: 0.66rem;
			font-weight: 700;
			border: 1px solid currentcolor;
			white-space: nowrap;
		}
		.pj-tl__status--green {
			color: #1d9e75;
			background: color-mix(in srgb, #1d9e75 12%, transparent);
		}
		.pj-tl__status--blue {
			color: #378add;
			background: color-mix(in srgb, #378add 12%, transparent);
		}
		.pj-tl__status--gray {
			color: #888780;
			background: color-mix(in srgb, #888780 12%, transparent);
		}

		.pj-tl__summary {
			margin: 0.7rem 0 0;
			font-size: 0.83rem;
			line-height: 1.7;
			color: var(--pj-body);
		}
		.pj-tl__metrics {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
			gap: 0.4rem;
			margin: 0.7rem 0 0;
			padding: 0;
			list-style: none;
		}
		.pj-tl__metrics li {
			display: flex;
			flex-direction: column;
			gap: 0.05rem;
			padding: 0.4rem 0.55rem;
			border-radius: 10px;
			background: var(--pj-sunken);
		}
		.pj-tl__metric-value {
			font-size: 0.8rem;
			font-weight: 800;
			color: var(--pj-title);
		}
		.pj-tl__metric-label {
			font-size: 0.63rem;
			color: var(--pj-muted);
		}

		.pj-tl__foot {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.35rem;
			margin-top: 0.7rem;
		}
		.pj-tl__cat {
			display: inline-flex;
			align-items: center;
			gap: 0.25rem;
			padding: 0.2rem 0.55rem;
			border-radius: 999px;
			border: 1px solid var(--pj-line);
			background: var(--pj-sunken);
			font-size: 0.68rem;
			color: var(--pj-muted);
		}
		.pj-tl__stack {
			display: flex;
			flex-wrap: wrap;
			gap: 0.25rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}
		.pj-stacktag {
			padding: 0.18rem 0.5rem;
			border-radius: 999px;
			background: var(--pj-sunken);
			border: 1px solid var(--pj-line);
			font-size: 0.67rem;
			color: var(--pj-muted);
		}

		/* 桌面：左右交错 */
		@media (min-width: 900px) {
			.pj-tl__list {
				gap: 1.2rem;
			}
			.pj-tl__list::before {
				left: 50%;
				transform: translateX(-50%);
			}
			.pj-tl__item {
				width: calc(50% - 1.6rem);
				padding-left: 0;
			}
			.pj-tl__item.is-left {
				margin-left: calc(50% + 1.6rem);
			}
			.pj-tl__node {
				left: auto;
				right: -0.6rem;
			}
			.pj-tl__item.is-left .pj-tl__node {
				left: -0.6rem;
				right: auto;
			}
		}

		/* ===================== 空状态与底部 ===================== */
		.pj-empty {
			margin-top: 2.6rem;
			padding: 2.5rem 1rem;
			border: 1px dashed var(--pj-line);
			border-radius: 18px;
			text-align: center;
			font-size: 0.85rem;
			color: var(--pj-muted);
		}
		.pj-empty code {
			padding: 0.1rem 0.35rem;
			border-radius: 6px;
			background: var(--pj-sunken);
			font-size: 0.8rem;
			color: var(--pj-accent);
		}
		.pj-foot {
			display: flex;
			flex-wrap: wrap;
			gap: 0.6rem;
			margin-top: 2.4rem;
			padding-top: 1.1rem;
			border-top: 1px dashed var(--pj-line);
		}
		.pj-foot__link {
			display: inline-flex;
			align-items: center;
			gap: 0.32rem;
			padding: 0.35rem 0.8rem;
			border-radius: 999px;
			border: 1px solid var(--pj-line);
			background: var(--pj-sunken);
			font-size: 0.78rem;
			font-weight: 600;
			color: var(--pj-muted);
			text-decoration: none;
		}
		.pj-foot__link:hover {
			color: var(--pj-accent);
			border-color: color-mix(in srgb, var(--pj-accent) 40%, transparent);
		}

		.pj [data-pj-reveal] {
			opacity: 0;
			transform: translateY(14px);
			transition:
				opacity 620ms ease,
				transform 620ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
		}
		.pj [data-pj-reveal].is-visible {
			opacity: 1;
			transform: none;
		}
		@media (prefers-reduced-motion: reduce) {
			.pj [data-pj-reveal] {
				opacity: 1;
				transform: none;
				transition: none;
			}
		}
	</style>

	<script>
		function initProjectTimeline() {
			const root = document.querySelector<HTMLElement>("[data-pj-root]");
			if (!root) return;
			type Pw = Window & { __pjTlObserver?: { disconnect: () => void } };
			const pw = window as Pw;
			pw.__pjTlObserver?.disconnect();

			const nodes = Array.from(
				root.querySelectorAll<HTMLElement>("[data-pj-reveal]:not(.is-visible)"),
			);
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (reduceMotion || !("IntersectionObserver" in window)) {
				for (const node of nodes) node.classList.add("is-visible");
				return;
			}
			const observer = new IntersectionObserver(
				(entries, obs) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						(entry.target as HTMLElement).classList.add("is-visible");
						obs.unobserve(entry.target);
					}
				},
				{ threshold: 0.1, rootMargin: "0px 0px -5% 0px" },
			);
			for (const node of nodes) observer.observe(node);
			pw.__pjTlObserver = observer;
		}

		initProjectTimeline();
		document.addEventListener("astro:page-load", initProjectTimeline);
		document.addEventListener("swup:contentReplaced", initProjectTimeline);
	</script>
</MainGridLayout>
