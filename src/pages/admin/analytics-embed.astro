										<button type="button" data-range="30" aria-pressed="true">30 天</button>
										<button type="button" data-range="90" aria-pressed="false">90 天</button>
									</div>
								</div>
								<button type="button" class="analytics-refresh" data-analytics-refresh aria-label="刷新统计数据">
									<Icon is:inline name="material-symbols:refresh-rounded" aria-hidden="true" />
								</button>
							</div>
						</header>

						<div class="analytics-chart-wrap">
							<div class="analytics-chart-labels" aria-hidden="true">
