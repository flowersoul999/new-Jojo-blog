---
/**
 * 后台管理 · 站点统计（嵌入页）
 *
 * 用途：作为 /admin 后台「站点统计」页签的 iframe 内容，不套用任何站点布局。
 * 设计：复刻 Aemeath 主题 analytics 页面的视觉语言（样式见 styles/analytics-embed.css）。
 * 数据：本后台自建的访问埋点，接口 /api/admin/stats/?days=N（同源 cookie 鉴权）。
 */
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import "@/styles/variables.styl";
import "@/styles/main.css";
import "@/styles/analytics-embed.css";

const hue = siteConfig.themeColor.hue;
const defaultMode = siteConfig.themeColor.defaultMode;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>站点统计</title>
		<script is:inline define:vars={{ hue, defaultMode }}>
			// 与后台 AdminLayout 保持一致的主题初始化（localStorage key: theme / hue）
			const LIGHT_MODE = "light";
			const DARK_MODE = "dark";
			const SYSTEM_MODE = "system";
			function getSystemTheme() {
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? DARK_MODE : LIGHT_MODE;
			}
			function resolveTheme(value) {
				return value === SYSTEM_MODE ? getSystemTheme() : value;
			}
			function applyTheme() {
				const theme = localStorage.getItem("theme") || defaultMode;
				const resolved = resolveTheme(theme);
				document.documentElement.classList.toggle("dark", resolved === DARK_MODE);
				document.documentElement.style.setProperty("--hue", localStorage.getItem("hue") || hue);
			}
			applyTheme();
			// 后台切换深浅色时同步（同源 iframe 可收到 storage 事件）
			window.addEventListener("storage", (event) => {
				if (!event.key || event.key === "theme" || event.key === "hue") applyTheme();
			});
		</script>
	</head>
	<body class="analytics-embed-body">
		<section class="analytics-page" data-analytics-embed aria-labelledby="analytics-title">
			<!-- ======================== 顶部概览 ======================== -->
			<header class="analytics-hero card-base onload-animation">
				<div class="analytics-hero__grid">
					<div class="analytics-hero__copy">
						<div class="analytics-kicker">
							<span class="analytics-kicker__signal" aria-hidden="true"></span>
							<span>SELF-HOSTED / SITE TELEMETRY</span>
						</div>
						<h1 id="analytics-title">站点统计</h1>
						<p class="analytics-hero__lead">
							这里展示的是本站的整体趋势，数据来自后台自建埋点，不记录任何可识别个人身份的信息。
						</p>
						<div class="analytics-hero__notes">
							<span><Icon is:inline name="material-symbols:lock-open-rounded" aria-hidden="true" />仅后台可见</span>
							<span><Icon is:inline name="material-symbols:calendar-today-rounded" aria-hidden="true" />按北京时间汇总</span>
						</div>
					</div>

					<div class="analytics-hero__meta">
						<div class="analytics-status" data-analytics-status data-state="loading" role="status" aria-live="polite">
							<span class="analytics-status__dot" aria-hidden="true"></span>
							<span data-analytics-status-text>连接中</span>
						</div>
						<div class="analytics-hero__stamp">
							<span>DATA SOURCE</span>
							<strong>自建埋点</strong>
							<small data-analytics-last-update>读取后台数据 · 自动刷新</small>
						</div>
					</div>
				</div>

				<div class="analytics-hero__rail" aria-hidden="true">
					<span>ADMIN / {year}</span>
					<span></span>
					<span>MEASURE WHAT MATTERS</span>
				</div>
			</header>

			<section class="analytics-summary" aria-label="站点概览">
				<article class="analytics-summary-card analytics-summary-card--blue">
					<div class="analytics-summary-card__topline">
						<span class="analytics-summary-card__label">ALL-TIME</span>
						<Icon is:inline name="material-symbols:group-rounded" aria-hidden="true" />
					</div>
					<strong data-stat="cumulativeVisitors" aria-live="polite">加载中</strong>
					<span>累计访客</span>
					<small>自建埋点累计去重访客</small>
				</article>
				<article class="analytics-summary-card analytics-summary-card--mint">
					<div class="analytics-summary-card__topline">
						<span class="analytics-summary-card__label">ALL-TIME</span>
						<Icon is:inline name="material-symbols:visibility-rounded" aria-hidden="true" />
					</div>
					<strong data-stat="cumulativePageviews" aria-live="polite">加载中</strong>
					<span>累计浏览</span>
					<small>自建埋点累计浏览量</small>
				</article>
				<article class="analytics-summary-card analytics-summary-card--gold">
					<div class="analytics-summary-card__topline">
						<span class="analytics-summary-card__label">TODAY</span>
						<Icon is:inline name="material-symbols:person-search-rounded" aria-hidden="true" />
					</div>
					<strong data-stat="todayVisitors" aria-live="polite">加载中</strong>
					<span>今日访客</span>
					<small>北京时间 00:00 起</small>
				</article>
				<article class="analytics-summary-card analytics-summary-card--violet">
					<div class="analytics-summary-card__topline">
						<span class="analytics-summary-card__label">TODAY</span>
						<Icon is:inline name="material-symbols:trending-up-rounded" aria-hidden="true" />
					</div>
					<strong data-stat="todayPageviews" aria-live="polite">加载中</strong>
					<span>今日浏览</span>
					<small>实时公开数据</small>
				</article>
			</section>

			<div class="analytics-layout">
				<main class="analytics-main">
					<!-- ======================== 访问脉冲 ======================== -->
					<section class="analytics-panel analytics-traffic card-base" aria-labelledby="analytics-traffic-title">
						<header class="analytics-panel__header">
							<div>
								<p class="analytics-section-kicker">TRAFFIC / SIGNAL</p>
								<h2 id="analytics-traffic-title">访问脉冲</h2>
								<p class="analytics-panel__description">每天的浏览量与访客数</p>
