---
// 面试板块首页：只做入口和概览，不放具体内容
import { getCollection } from "astro:content";
import PageEditor from "@/components/edit/PageEditor.svelte";
import InterviewShell from "@/components/interview/InterviewShell.astro";
import ModuleGrid from "@/components/interview/ModuleGrid.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

export const prerender = true;

const keep = ({ data }: { data: { draft?: boolean } }) => !data.draft;

const [experiences, questions, problems, handcrafts] = await Promise.all([
	getCollection("interviews", keep),
	getCollection("questions", keep),
	getCollection("hot100", keep),
	getCollection("handcraft", keep),
]);

const counts: Record<string, number> = {
	experience: experiences.length,
	questions: questions.length,
	hot100: problems.length,
	handcraft: handcrafts.length,
};

const offers = experiences.filter(
	(item) => item.data.result === "offer",
).length;

const stats = [
	{ label: "场面试", value: experiences.length },
	{ label: "条八股", value: questions.length },
	{ label: "道刷题", value: problems.length },
	{ label: "道手撕", value: handcrafts.length },
];

const title = "面试";
const description =
	"面完不写下来就等于白面了一场。这里存着每一次的真题、按领域归档的八股、力扣 Hot100 的刷题进度，以及白板上手写过的那些题。";

/**
 * 登录后「编辑此页」按钮的清单。
 * md 路径直接取集合条目的 filePath（真实路径，不用手写拼），
 * 只有源码文件需要手工列，因为它们不在内容集合里。
 */
const editableFiles = [
	{
		path: "src/pages/interview/index.astro",
		label: "页面文案与统计",
		hint: "首页的描述、统计条和「怎么用这个板块」那段",
	},
	{
		path: "src/data/interview.ts",
		label: "模块切换条配置",
		hint: "四个模块的名称、图标、简介",
	},
	// filePath 在类型上是 string | undefined（内容集合条目未必有源文件），
	// 这里滤掉没有 filePath 的条目，免得把 undefined 塞进 PageEditor 的清单
	...experiences.flatMap((e) =>
		e.filePath
			? [
					{
						path: e.filePath,
						label: `${e.data.company} · ${e.data.stage}`,
						hint: e.data.position,
					},
				]
			: [],
	),
	...questions.flatMap((q) =>
		q.filePath
			? [
					{
						path: q.filePath,
						label: `八股：${q.data.question}`,
						hint: `${q.data.category} · ${q.data.level}`,
					},
				]
			: [],
	),
	...problems.flatMap((p) =>
		p.filePath
			? [
					{
						path: p.filePath,
						label: `No.${p.data.no} ${p.data.title}`,
						hint: `${p.data.difficulty} · ${p.data.category}`,
					},
				]
			: [],
	),
	...handcrafts.flatMap((h) =>
		h.filePath
			? [
					{
						path: h.filePath,
						label: h.data.title,
						hint: `${h.data.kind} · ${h.data.difficulty}`,
					},
				]
			: [],
	),
];
---

<MainGridLayout title={title} description={description} hideSidebars>
	<InterviewShell
		kicker="INTERVIEW PREP"
		title="面试"
		desc="面完不写下来，就等于白面了一场。这里存着每一次的真题目、按领域归档的八股、Hot100 的刷题进度，还有白板上手写过的那些题。"
		stats={stats}
	>
		<PageEditor
			slot="actions"
			title="编辑面试页"
			files={editableFiles}
			client:load
		/>
		<ModuleGrid counts={counts} />

		{
			offers > 0 && (
				<section class="iv-block">
					<div class="iv-block__head">
						<h2 class="iv-block__title">结果</h2>
					</div>
					<div class="iv-panel">
						<p class="iv-block__note">
							已经记录 {experiences.length} 场面试，其中 {offers} 场拿到了 offer。
						</p>
					</div>
				</section>
			)
		}

		<section class="iv-block">
			<div class="iv-block__head">
				<h2 class="iv-block__title">怎么用这个板块</h2>
			</div>
			<div class="iv-panel iv-howto">
				<ol class="iv-howto__list">
					<li>
						<strong>面完当天就写。</strong>趁记忆还热，把被问到的每个问题原样记下来，包括答砸的那几个——答砸的才值钱。
					</li>
					<li>
						<strong>八股先自测再展开。</strong>每张卡的答案默认是收起来的，先自己讲一遍，再点开对照，缺的部分补进去。
					</li>
					<li>
						<strong>刷题只记关键。</strong>Hot100 记的是「这题的关键在哪、错在哪」，不是抄一遍题解。
					</li>
				</ol>
			</div>
		</section>
	</InterviewShell>
</MainGridLayout>

<style>
	.iv-howto__list {
		margin: 0;
		padding-left: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.iv-howto__list li {
		font-size: 0.84rem;
		line-height: 1.85;
		color: var(--iv-body);
	}
	.iv-howto__list strong {
		color: var(--iv-title);
		font-weight: 700;
	}
</style>
