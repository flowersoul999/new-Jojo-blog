---
// 前端技能图：按前置依赖自动分层的技能图，方块上是真实技术 logo
// 数据见 src/data/skills.ts（依赖关系）、src/data/techIcons.ts（图标）
// 组件见 src/components/skills/SkillTree.svelte
import SkillTree from "@/components/skills/SkillTree.svelte";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "技能图";
const description =
	"把前端从前端小白到技术专家的学习路径，排成一张有真实依赖关系的技能图。方块上是真实的技术 logo，连线代表「先会了上面，才能解锁下面」，节点越亮说明掌握得越扎实。";
---

<MainGridLayout title={title} description={description} hideSidebars fullWidth>
	<div class="card-base z-10 relative w-full overflow-hidden">
		<div class="px-3 sm:px-5 md:px-7 py-5 sm:py-7 max-w-[78rem] mx-auto">
			<SkillTree client:load />
		</div>
	</div>
</MainGridLayout>
