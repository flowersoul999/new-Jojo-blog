---
// 日志时间线页：仿 flowersink.com/life 的月度时间线排版
// 单列居中 + 按月分组，每条日志展示「心情/标签/标题/摘要/首图/日期」
// 点击卡片走站内平滑跳转到详情页 /diary/[slug]，私密日记锁定态需密码
import fs from "node:fs";
import { join } from "node:path";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.diary) {
	return Astro.redirect("/404/");
}

// 心情 → 展示信息 + 专属配色（标签底色、卡片左侧色条随之变化）
const MOOD_MAP: Record<
	string,
	{ label: string; emoji: string; color: string }
> = {
	"super-happy": { label: "炒鸡开心", emoji: "🤩", color: "#fb7185" }, // 玫瑰红
	happy: { label: "开心", emoji: "😊", color: "#f59e0b" }, // 琥珀橙
	neutral: { label: "平平淡淡", emoji: "😐", color: "#94a3b8" }, // 银灰
	unhappy: { label: "不开心", emoji: "😔", color: "#38bdf8" }, // 天蓝
	sad: { label: "伤心难过", emoji: "😭", color: "#a78bfa" }, // 淡紫
};

interface RawEntry {
	slug: string;
	title?: string;
	content?: string;
	date: string;
	tags?: string[];
	images?: { url: string }[];
	// 视频日记：封面图走 poster，一并进媒体墙
	videos?: { url: string; poster?: string }[];
	mood?: string;
	isPrivate?: boolean;
}

interface MediaItem {
	url: string;
	isVideo: boolean;
}

// 读取日记数据（与画布页 /diary/ 共用同一份数据源）
const file = join(process.cwd(), "public", "diary", "index.json");
let rawEntries: RawEntry[] = [];
try {
	rawEntries = JSON.parse(fs.readFileSync(file, "utf-8")) as RawEntry[];
} catch (e) {
	rawEntries = [];
}

// 按时间倒序排列
const entries = [...rawEntries].sort(
	(a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

// 按月分组：Map<'2026年10月', RawEntry[]>
const monthGroups: { key: string; items: RawEntry[] }[] = [];
for (const e of entries) {
	const d = new Date(e.date);
	const key = d.getFullYear() + "年" + (d.getMonth() + 1) + "月";
	const last = monthGroups[monthGroups.length - 1];
	if (last && last.key === key) {
		last.items.push(e);
	} else {
		monthGroups.push({ key, items: [e] });
	}
}

function formatDate(dateStr: string) {
	const d = new Date(dateStr);
	if (isNaN(d.getTime())) return dateStr;
	return (
		d.getFullYear() +
		"年" +
		String(d.getMonth() + 1).padStart(2, "0") +
		"月" +
		String(d.getDate()).padStart(2, "0") +
		"日"
	);
}

function excerpt(content?: string, len = 96) {
	const s = (content || "").trim().replace(/\s+/g, " ");
	return s.length > len ? s.slice(0, len) + "…" : s;
}

// 汇总一条日志的全部媒体（图片 + 视频封面），私密日记一律返回空
function mediaList(e: RawEntry): MediaItem[] {
	if (e.isPrivate) return [];
	const list: MediaItem[] = [];
	for (const img of e.images || []) {
		if (img && img.url) list.push({ url: img.url, isVideo: false });
	}
	for (const v of e.videos || []) {
		if (v && v.poster) list.push({ url: v.poster, isVideo: true });
	}
	return list;
}

const title = "日志";
const description = "记录生活的细节点滴，按月份整理成时间线。";
---

<MainGridLayout title={title} description={description}>
	<div class="card-base z-10 relative w-full overflow-hidden">
		<div class="px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative">
			<!-- 页面标题区 -->
			<div class="flex items-center gap-3 mb-2">
				<div
					class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-(--primary) text-white dark:text-black/70"
				>
					<Icon is:inline name="material-symbols:timeline" class="text-[1.5rem]" />
				</div>
				<div class="text-3xl sm:text-4xl font-extrabold text-neutral-900 dark:text-neutral-100">
					{title}
				</div>
				<a
					href="/diary/"
					id="life-to-canvas"
					class="ml-auto inline-flex items-center gap-1.5 rounded-lg bg-(--btn-regular-bg) px-3.5 py-2 text-base font-medium text-(--btn-content) transition-colors hover:bg-(--btn-regular-bg-hover)"
				>
					<Icon is:inline name="material-symbols:apps" class="text-base" />
					<span>画布模式</span>
				</a>
			</div>
<p class="text-base text-neutral-700 dark:text-neutral-300 leading-relaxed mb-5">
			{description}
		</p>

			<!-- 月份筛选 -->
			{monthGroups.length > 0 && (
				<div id="life-month-filter" class="life-filter">
					<button type="button" data-month="all" class="life-filter-pill is-active">全部</button>
					{monthGroups.map((g) => (
						<button type="button" data-month={g.key} class="life-filter-pill">
							{g.key}
						</button>
					))}
				</div>
			)}

			<!-- 时间线主体 -->
			<div id="life-timeline" class="life-timeline">
				{entries.length === 0 ? (
					<div class="life-empty">
						<div class="text-4xl mb-2">🍃</div>
						<p>还没有记录生活点滴</p>
					</div>
				) : (
					monthGroups.map((g) => (
						<section class="life-month" data-month={g.key}>
							<h2 class="life-month-title">
								<span class="life-month-dot"></span>
								{g.key}
							</h2>
							<div class="life-month-items">
								{g.items.map((e) => (
									<a
										href={e.isPrivate ? undefined : `/diary/${e.slug}/`}
										class="life-entry"
										data-months={g.key}
										data-slug={e.slug}
										data-locked={e.isPrivate ? "1" : "0"}
									>
										{(() => {
											const mood = e.mood ? MOOD_MAP[e.mood] : null;
											const media = mediaList(e);
											// 超过 6 张才收敛高度（2 行），其余全部铺开
											const capped = media.length > 6;
											return (
												<article
													class="life-card"
													data-mood={mood ? e.mood : ""}
													style={mood ? `--mood-color: ${mood.color}` : ""}
												>
													{e.isPrivate ? (
														// 私密日记锁定态
														<div class="flex items-center gap-2">
															<span class="life-lock">🔒</span>
															<h3 class="life-title">私密日记</h3>
														</div>
													) : (
														<>
															{(mood || (e.tags && e.tags.length > 0)) && (
																<div class="life-chips">
																	{mood && (
																		<span class="life-chip life-chip-mood" title={mood.label}>
																			{mood.emoji} {mood.label}
																		</span>
																	)}
																	{(e.tags || []).map((t) => (
																		<span class="life-chip">{t}</span>
																	))}
																</div>
															)}
															<h3 class="life-title">{e.title || "无题"}</h3>
{media.length > 0 && (
																<div
																	class="life-media"
																	class:list={{ "is-capped": capped }}
																	data-total={media.length}
																>
																	{media.slice(0, capped ? 6 : media.length).map((m, i) => (
																		<figure class="life-media-cell">
																			<img
																				src={m.url}
																				alt=""
																				loading="lazy"
																				decoding="async"
																				draggable="false"
																			/>
																			{m.isVideo && (
																				<span class="life-media-badge" title="含视频">
																					<Icon
																						is:inline
																						name="material-symbols:play-circle"
																						class="text-[1.35rem]"
																					/>
																				</span>
																			)}
																			{capped && i === 5 && (
																				<span class="life-media-more">
																					+{media.length - 5}
																				</span>
																			)}
																		</figure>
																	))}
																</div>
															)}
															{(e.content || "").trim() && (
																<p class="life-excerpt" data-excerpt>
																	{excerpt(e.content)}
																</p>
															)}
														</>
													)}
													<div class="life-meta">
														<span class="life-date">
															<Icon is:inline name="material-symbols:calendar-today-rounded" class="text-sm" />
															{formatDate(e.date)}
														</span>
														<Icon is:inline name="material-symbols:chevron-right" class="text-base life-arrow" />
													</div>
												</article>
											);
										})()}
									</a>
								))}
							</div>
						</section>
					))
				)}
			</div>

			<!-- 底部提示 -->
<div class="flex items-center justify-center gap-1.5 pt-5 text-sm text-neutral-600 dark:text-neutral-300">
			<Icon is:inline name="material-symbols:open-in-new-rounded" class="text-base" />
				<span>点击卡片查看完整日记，或切换到画布模式自由摆放</span>
			</div>
		</div>
	</div>

	<style is:global>
		/* ===================== 月份筛选 ===================== */
		.life-filter {
			display: flex;
			flex-wrap: nowrap;
			gap: 0.5rem;
			overflow-x: auto;
			padding: 0.25rem 0 0.75rem;
			margin-bottom: 0.5rem;
			scrollbar-width: none;
			-ms-overflow-style: none;
		}
		.life-filter::-webkit-scrollbar {
			display: none;
		}
		.life-filter-pill {
			flex: none;
			display: inline-flex;
			align-items: center;
			border: 1px solid var(--line-divider);
			border-radius: 999px;
			background: transparent;
			padding: 0.42rem 1rem;
			font-size: 0.95rem;
			font-weight: 500;
			color: var(--text-color);
			cursor: pointer;
			transition: all 200ms ease;
		}
		.life-filter-pill:hover {
			border-color: color-mix(in srgb, var(--primary) 55%, transparent);
			background: color-mix(in srgb, var(--primary) 10%, transparent);
		}
		.life-filter-pill.is-active {
			border-color: var(--primary);
			background: color-mix(in srgb, var(--primary) 16%, transparent);
			color: color-mix(in srgb, var(--primary) 78%, var(--text-color));
			font-weight: 700;
		}

		/* ===================== 时间线主体 ===================== */
		.life-timeline {
			display: flex;
			flex-direction: column;
			gap: 2rem;
		}
		.life-month {
			display: flex;
			flex-direction: column;
			gap: 0.9rem;
		}
		.life-month-title {
			margin: 0;
			display: flex;
			align-items: center;
			gap: 0.6rem;
			font-size: 1.45rem;
			font-weight: 800;
			letter-spacing: 0.02em;
			color: var(--text-color);
		}
		.life-month-title::after {
			content: "";
			flex: 1;
			height: 1px;
			background: linear-gradient(
				to right,
				color-mix(in srgb, var(--primary) 40%, transparent),
				transparent
			);
		}
		.life-month-dot {
			flex: none;
			width: 0.6rem;
			height: 0.6rem;
			border-radius: 999px;
			background: var(--primary);
			box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 18%, transparent);
		}
		.life-month-items {
			display: flex;
			flex-direction: column;
			gap: 0.9rem;
		}

		/* ===================== 日志卡片 ===================== */
		.life-entry {
			display: block;
			text-decoration: none;
			cursor: pointer;
			transition: transform 0.25s ease;
		}
		.life-card {
			position: relative;
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding: 1.25rem 1.5rem;
			border-radius: 20px;
			border: 1px solid var(--line-divider);
			background: var(--card-bg);
			box-shadow:
				var(--card-shadow, 0 2px 12px rgb(0 0 0 / 0.06)),
				0 1px 3px rgb(0 0 0 / 0.05);
			transition:
				transform 0.25s ease,
				box-shadow 0.25s ease,
				border-color 0.25s ease;
		}
		/* 有心情的卡片：左侧显示专属色条 */
		.life-card[data-mood]:not([data-mood=""]) {
			padding-left: 1.65rem;
		}
		.life-card[data-mood]:not([data-mood=""])::before {
			content: "";
			position: absolute;
			left: 0;
			top: 1.1rem;
			bottom: 1.1rem;
			width: 5px;
			border-radius: 0 5px 5px 0;
			background: var(--mood-color, var(--primary));
			opacity: 0.9;
		}
		.life-entry:hover {
			transform: translateY(-3px);
		}
		.life-entry:hover .life-card {
			border-color: color-mix(in srgb, var(--primary) 45%, transparent);
			box-shadow:
				0 18px 42px rgb(0 0 0 / 0.12),
				0 4px 12px rgb(0 0 0 / 0.08);
		}
		.life-entry:hover .life-arrow {
			transform: translateX(3px);
		}

		.life-chips {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
		}
		.life-chip {
			display: inline-flex;
			align-items: center;
			border-radius: 999px;
			padding: 0.2rem 0.7rem;
			font-size: 0.84rem;
			font-weight: 600;
			border: 1px solid var(--line-divider);
			background: color-mix(in srgb, var(--card-bg) 70%, transparent);
			color: var(--text-color);
		}
		.life-chip-mood {
			border-color: color-mix(in srgb, var(--mood-color, var(--primary)) 55%, transparent);
			background: color-mix(in srgb, var(--mood-color, var(--primary)) 16%, transparent);
			color: color-mix(in srgb, var(--mood-color, var(--primary)) 72%, var(--text-color));
			font-weight: 700;
		}
		.life-lock {
			font-size: 1.4rem;
			line-height: 1;
		}

		/* 标题：明显加大加粗，用主题安全文字色 */
		.life-title {
			margin: 0;
			font-size: 1.32rem;
			font-weight: 800;
			line-height: 1.4;
			color: var(--text-color);
			word-break: break-word;
		}

		/* ===================== 媒体墙 ===================== */
		.life-media {
			display: grid;
			gap: 0.5rem;
			width: 100%;
			/* 按图片数量选列数：图少就大、图多就密，避免出现半空的窄条 */
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.life-media[data-total="1"] {
			grid-template-columns: 1fr;
		}
		.life-media[data-total="3"],
		.life-media[data-total="5"] {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.life-media[data-total="4"] {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.life-media-cell {
			position: relative;
			margin: 0;
			overflow: hidden;
			border-radius: 12px;
			border: 1px solid var(--line-divider);
			background: color-mix(in srgb, var(--card-bg) 70%, var(--muted));
			aspect-ratio: 4 / 3;
		}
		.life-media-cell img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			pointer-events: none;
			transition: transform 0.4s ease;
		}
		.life-entry:hover .life-media-cell img {
			transform: scale(1.04);
		}
		/* 封面角标（视频） */
		.life-media-badge {
			position: absolute;
			top: 0.3rem;
			right: 0.3rem;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 1.75rem;
			height: 1.75rem;
			border-radius: 999px;
			color: #fff;
			background: rgb(0 0 0 / 0.45);
			backdrop-filter: blur(2px);
			pointer-events: none;
		}
		/* 「还有 N 张」遮罩 */
		.life-media-more {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.25rem;
			font-weight: 800;
			letter-spacing: 0.02em;
			color: #fff;
			background: rgb(0 0 0 / 0.5);
			pointer-events: none;
		}
		/* 单图给足版面（16:9大图）；两图 4:3，视觉重心更稳 */
		.life-media[data-total="1"] .life-media-cell {
			aspect-ratio: 16 / 9;
		}
		/* 超过 6 张才收敛高度（2 行），其余全部铺开 */
		.life-media.is-capped {
			max-height: calc((100% - 0.5rem) / 2);
			overflow: hidden;
		}

		/* 摘要：加大字号、提高对比度 */
		.life-excerpt {
			margin: 0;
			font-size: 1rem;
			line-height: 1.85;
			color: var(--text-color);
			display: -webkit-box;
			-webkit-line-clamp: 4;
			-webkit-box-orient: vertical;
			overflow: hidden;
			white-space: pre-wrap;
			word-break: break-word;
		}

		.life-meta {
			margin-top: 0.35rem;
			padding-top: 0.65rem;
			border-top: 1px dashed var(--line-divider);
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.5rem;
			font-size: 0.88rem;
			font-weight: 500;
			color: var(--text-color);
		}
		.life-date {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
		}
		.life-arrow {
			transition: transform 0.25s ease;
			font-size: 1.2rem;
			color: var(--primary);
		}

		/* 隐藏被筛选掉的月份 */
		.life-month.is-hidden {
			display: none;
		}

		/* 空状态 */
		.life-empty {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 0.3rem;
			padding: 3.5rem 1rem;
			color: var(--text-color);
		}

		/* 移动端微调：单列自然堆叠 */
		@media (max-width: 639px) {
			.life-card {
				padding: 1.1rem 1.15rem;
			}
			.life-title {
				font-size: 1.2rem;
			}
			.life-excerpt {
				font-size: 1rem;
			}
			.life-media[data-total="3"],
			.life-media[data-total="5"] {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
			.life-media[data-total="4"] {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}
	</style>

	<script is:inline>
		(function () {
			// 私密日记密码（与画布页/详情页一致）
			var DIARY_PASSWORD = "2299";
			var UNLOCK_KEY = "aemeath-diary-unlocked";
var unlocked = false;
			try {
				unlocked = sessionStorage.getItem(UNLOCK_KEY) === "1";
			} catch (e) {}

			// 私密日记解锁：走全站共用的居中弹窗（Layout 里的 DiaryUnlockDialog）
			function askDiaryPassword() {
				if (typeof window.__diaryUnlock !== "function") {
					return Promise.resolve(window.prompt("这是一篇私密日记，请输入密码：") === DIARY_PASSWORD);
				}
				return window.__diaryUnlock({
					verify: function (pwd) {
						return pwd === DIARY_PASSWORD;
					},
				});
			}

			// 走站内平滑跳转（与画布页一致）
			function gotoDiary(slug) {
				// 站点 trailingSlash: always，详情页 URL 需带尾部斜杠避免 404
				var url = "/diary/" + slug + "/";
				try {
					if (window.swup && typeof window.swup.navigate === "function") {
						window.swup.navigate(url);
						return;
					}
				} catch (e) {}
				window.location.href = url;
			}

			// 月份筛选
			var filter = document.getElementById("life-month-filter");
			if (filter) {
				var pills = filter.querySelectorAll(".life-filter-pill");
				pills.forEach(function (pill) {
					pill.addEventListener("click", function () {
						pills.forEach(function (p) {
							p.classList.remove("is-active");
						});
						pill.classList.add("is-active");
						var month = pill.dataset.month;
						document.querySelectorAll(".life-month").forEach(function (sec) {
							var show = month === "all" || sec.dataset.month === month;
							sec.style.display = show ? "" : "none";
						});
					});
				});
			}

			// 私密日记点击解锁（卡片本身不带链接，直接跳详情解锁流程）
			document.querySelectorAll(".life-entry[data-locked='1']").forEach(function (el) {
				el.addEventListener("click", function (e) {
					// 已解锁则直接访问
					if (unlocked) {
						gotoDiary(el.dataset.slug);
						return;
					}
					e.preventDefault();
					askDiaryPassword().then(function (ok) {
						if (!ok) return;
						try {
							sessionStorage.setItem(UNLOCK_KEY, "1");
						} catch (err) {}
						unlocked = true;
						gotoDiary(el.dataset.slug);
					});
				});
			});
		})();
	</script>
</MainGridLayout>