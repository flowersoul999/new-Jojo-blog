---
import { Icon } from "astro-icon/components";
import { blogChangelogEntries } from "@/data/blog-changelog";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

type CardType = "feature" | "improve" | "fix" | "remove";

type ChangelogCard = {
	id: string;
	date: string;
	shortDate: string;
	version: string;
	kind: string;
	text: string;
	type: CardType;
};

const TYPE_LABELS: Record<CardType, string> = {
	feature: "功能新增",
	improve: "功能优化",
	fix: "问题修复",
	remove: "移除调整",
};

/** 按语义给每条改动归类，规则顺序不能调：先认「移除」，再「修复」，再「新增」 */
function inferType(text: string): CardType {
	if (/移除|隐藏|清空|删除/.test(text)) return "remove";
	if (/修复|修正|避免|解决|回退/.test(text)) return "fix";
	if (/新增|加入|添加|迁移|支持/.test(text)) return "feature";
	return "improve";
}

const cards: ChangelogCard[] = blogChangelogEntries.flatMap((entry) =>
	entry.details.map((text, index) => ({
		id: `${entry.version}-${index}`,
		date: entry.date,
		shortDate: entry.date.slice(5).replace("-", "."),
		version: entry.version,
		kind: entry.kind,
		text,
		type: inferType(text),
	})),
);

const versionCount = blogChangelogEntries.length;
const oldest =
	blogChangelogEntries.at(-1)?.date.slice(0, 7).replace("-", ".") ?? "";
const newest =
	blogChangelogEntries[0]?.date.slice(0, 7).replace("-", ".") ?? "";

const typeOrder: CardType[] = ["feature", "improve", "fix", "remove"];
const typeCounts = typeOrder
	.map((type) => ({
		type,
		label: TYPE_LABELS[type],
		count: cards.filter((card) => card.type === type).length,
	}))
	.filter((item) => item.count > 0);
---

<MainGridLayout title="更新日志" description="jojo 博客的每一次改动">
	<div class="changelog-page">
		<header class="changelog-hero card-base">
			<p class="changelog-hero__eyebrow">CHANGELOG</p>
			<h1 class="changelog-hero__title">更新日志</h1>
			<p class="changelog-hero__quote">“这个博客的每一次改动”</p>
			<div class="changelog-hero__stats">
				<span>{versionCount} 个版本</span>
				<span class="changelog-hero__dot" aria-hidden="true"></span>
				<span>{cards.length} 条改动</span>
				<span class="changelog-hero__dot" aria-hidden="true"></span>
				<span>{oldest} → {newest}</span>
			</div>
			<ul class="changelog-hero__legend">
				{
					typeCounts.map((item) => (
						<li class="changelog-legend" data-type={item.type}>
							<span class="changelog-legend__dot" aria-hidden="true" />
							{item.label}
							<span class="changelog-legend__count">{item.count}</span>
						</li>
					))
				}
			</ul>
		</header>

		<section class="changelog-board card-base" aria-labelledby="changelog-board-title">
			<div class="changelog-board__head">
				<span class="changelog-board__bar" aria-hidden="true"></span>
				<h2 class="changelog-board__title" id="changelog-board-title">更新日志</h2>
				<span class="changelog-board__hint">按时间倒序</span>
			</div>

			<ol class="changelog-grid">
				{
					cards.map((card, index) => (
						<li class="changelog-card" data-type={card.type}>
							<div class="changelog-card__top">
								<span class="changelog-card__type">{TYPE_LABELS[card.type]}</span>
								<time class="changelog-card__date" datetime={card.date}>
									{card.shortDate}
								</time>
							</div>
							<p class="changelog-card__text">{card.text}</p>
							<div class="changelog-card__foot">
								<span class="changelog-card__version">{card.version}</span>
								<span class="changelog-card__kind">{card.kind}</span>
								<span class="changelog-card__num" aria-hidden="true">
									{String(cards.length - index).padStart(2, "0")}
								</span>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<footer class="changelog-foot">
			<Icon name="material-symbols:history" class="changelog-foot__icon" />
			<p>
				每一次改动都记在这里，按仓库真实提交整理。想看向导，可以回到
				<a href="/about/">关于页</a>。
			</p>
		</footer>
	</div>
</MainGridLayout>

<style>
	.changelog-page {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}

	.changelog-hero {
		padding: 2.2rem 2rem 1.8rem;
	}

	.changelog-hero__eyebrow {
		margin: 0 0 0.6rem;
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.36em;
		color: var(--primary);
	}

	.changelog-hero__title {
		margin: 0 0 0.5rem;
		font-size: clamp(2rem, 3.4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--text-color);
	}

	.changelog-hero__quote {
		margin: 0 0 1.3rem;
		font-size: 0.94rem;
		letter-spacing: 0.02em;
		color: color-mix(in srgb, var(--text-color) 58%, transparent);
	}

	.changelog-hero__stats {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		color: color-mix(in srgb, var(--text-color) 52%, transparent);
	}

	.changelog-hero__dot {
		width: 3px;
		height: 3px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--text-color) 30%, transparent);
	}

	.changelog-hero__legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.changelog-legend {
		--tone: var(--primary);

		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.7rem;
		border: 1px solid color-mix(in srgb, var(--tone) 45%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--tone) 14%, transparent);
		font-size: 0.74rem;
		letter-spacing: 0.04em;
		color: color-mix(in srgb, var(--tone) 55%, var(--text-color));
	}

	.changelog-legend__dot {
		width: 5px;
		height: 5px;
		border-radius: 999px;
		background: var(--tone);
	}

	.changelog-legend__count {
		font-weight: 500;
		opacity: 0.7;
	}

	.changelog-board {
		padding: 1.6rem 1.5rem 1.9rem;
	}

	.changelog-board__head {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 1.4rem;
	}

	.changelog-board__bar {
		width: 3px;
		height: 1.15rem;
		border-radius: 999px;
		background: var(--primary);
	}

	.changelog-board__title {
		margin: 0;
		font-size: 1.22rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--text-color);
	}

	.changelog-board__hint {
		margin-left: auto;
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		color: color-mix(in srgb, var(--text-color) 38%, transparent);
	}

	.changelog-grid {
		columns: 2;
		column-gap: 0.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.changelog-card {
		--tone: var(--primary);

		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		break-inside: avoid;
		margin-bottom: 0.9rem;
		padding: 1rem 1.05rem 0.9rem;
		border: 1px solid var(--line-divider);
		border-left: 2px solid color-mix(in srgb, var(--tone) 55%, transparent);
		border-radius: 0.85rem;
		background: color-mix(in srgb, var(--tone) 4%, var(--card-bg));
		transition:
			transform 0.28s ease,
			border-color 0.28s ease,
			box-shadow 0.28s ease;
	}

	.changelog-card:hover {
		transform: translateY(-2px);
		border-left-color: var(--tone);
		box-shadow: 0 8px 22px -14px color-mix(in srgb, var(--tone) 60%, transparent);
	}

	.changelog-card__top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.6rem;
	}

	.changelog-card__type {
		font-size: 0.74rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		color: var(--tone);
	}

	.changelog-card__date {
		font-family: var(--font-mono, monospace);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: color-mix(in srgb, var(--text-color) 38%, transparent);
	}

	.changelog-card__text {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.72;
		color: color-mix(in srgb, var(--text-color) 88%, transparent);
	}

	.changelog-card__foot {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-top: 0.55rem;
		border-top: 1px dashed color-mix(in srgb, var(--line-divider) 85%, transparent);
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		color: color-mix(in srgb, var(--text-color) 34%, transparent);
	}

	.changelog-card__version {
		font-weight: 500;
		color: color-mix(in srgb, var(--tone) 75%, var(--text-color));
	}

	.changelog-card__num {
		margin-left: auto;
		font-family: var(--font-mono, monospace);
		opacity: 0.62;
	}

	.changelog-card[data-type="feature"] {
		--tone: #16a06b;
	}

	.changelog-card[data-type="improve"] {
		--tone: #3b7ef0;
	}

	.changelog-card[data-type="fix"] {
		--tone: #e0555a;
	}

	.changelog-card[data-type="remove"] {
		--tone: #8d8a99;
	}

	.changelog-legend[data-type="feature"] {
		--tone: #16a06b;
	}

	.changelog-legend[data-type="improve"] {
		--tone: #3b7ef0;
	}

	.changelog-legend[data-type="fix"] {
		--tone: #e0555a;
	}

	.changelog-legend[data-type="remove"] {
		--tone: #8d8a99;
	}

	.changelog-foot {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.2rem 0.4rem 0;
		font-size: 0.78rem;
		line-height: 1.7;
		color: color-mix(in srgb, var(--text-color) 46%, transparent);
	}

	.changelog-foot__icon {
		flex-shrink: 0;
		width: 1rem;
		height: 1rem;
		opacity: 0.6;
	}

	.changelog-foot a {
		color: var(--primary);
		text-decoration: none;
	}

	.changelog-foot a:hover {
		text-decoration: underline;
	}

	@media (max-width: 900px) {
		.changelog-hero {
			padding: 1.7rem 1.3rem 1.4rem;
		}

		.changelog-board {
			padding: 1.3rem 1.1rem 1.5rem;
		}

		.changelog-grid {
			columns: 1;
		}
	}
</style>
