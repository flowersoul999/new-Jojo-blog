---
import fs from "node:fs";
import { join } from "node:path";
// 日记详情页：点击纸片后走站内平滑跳转到此页（不再弹窗）
// 布局：封面大图 + 标题信息 → 其余照片（放在文章上方）→ 正文
// 私密日记：静态页不渲染内容，仅显示锁定卡片，密码验证后由前端拉取渲染
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const MOOD_MAP: Record<string, { label: string; emoji: string }> = {
	"super-happy": { label: "炒鸡开心", emoji: "🤩" },
	happy: { label: "开心", emoji: "😊" },
	neutral: { label: "平平淡淡", emoji: "😐" },
	unhappy: { label: "不开心", emoji: "😔" },
	sad: { label: "伤心难过", emoji: "😭" },
};

interface DiaryEntry {
	slug: string;
	title?: string;
	content?: string;
	date: string;
	tags?: string[];
	images?: {
		id: string;
		name: string;
		url: string;
		width: number;
		height: number;
		size: number;
	}[];
	mood?: string;
	isPrivate?: boolean;
}

interface Props {
	entry: DiaryEntry;
}

// 为每篇日记生成静态详情页
// 注意：不要用 `new URL("../../public/...", import.meta.url)` 相对定位，
// 生产构建时该组件被打包进 dist，import.meta.url 指向 dist 内 chunk，
// 相对路径会解析成 dist/public/... 导致 ENOENT 构建失败。
// 改用项目根目录锚定，开发与构建环境都稳定可读。
export function getStaticPaths() {
	const file = join(process.cwd(), "public", "diary", "index.json");
	const diaries = JSON.parse(fs.readFileSync(file, "utf-8")) as DiaryEntry[];
	return diaries.map((d) => ({
		params: { slug: d.slug },
		props: { entry: d },
	}));
}

const { entry } = Astro.props;

if (!siteConfig.pages.diary) {
	return Astro.redirect("/404/");
}

function formatDate(dateStr: string) {
	const d = new Date(dateStr);
	if (isNaN(d.getTime())) return dateStr;
	return (
		d.getFullYear() +
		"年" +
		String(d.getMonth() + 1).padStart(2, "0") +
		"月" +
		String(d.getDate()).padStart(2, "0") +
		"日"
	);
}

function formatChineseTime(dateStr: string) {
	const d = new Date(dateStr);
	if (isNaN(d.getTime())) return "";
	let h = d.getHours();
	const m = String(d.getMinutes()).padStart(2, "0");
	let period = "凌晨";
	if (h >= 5 && h < 8) period = "早上";
	else if (h >= 8 && h < 11) period = "上午";
	else if (h >= 11 && h < 13) period = "中午";
	else if (h >= 13 && h < 17) period = "下午";
	else if (h >= 17 && h < 19) period = "傍晚";
	else if (h >= 19 && h < 23) period = "晚上";
	else if (h >= 23) period = "深夜";
	const h12 = h % 12 || 12;
	return period + " " + h12 + ":" + m;
}

// 标题不再用封面配图，全部图片都放到正文里展示
const images = entry.images || [];
const mood = entry.mood ? MOOD_MAP[entry.mood] : null;
const tags = entry.tags || [];
const pageTitle = entry.title || "日记";
---

<MainGridLayout title={pageTitle} description="日记详情">
	<div class="card-base z-10 relative w-full overflow-hidden diary-detail-card">
		{entry.isPrivate ? (
			<!-- 私密日记：静态页不输出内容，由前端验证密码后渲染 -->
			<div id="diary-locked" data-slug={entry.slug} class="diary-locked flex min-h-64 flex-col items-center justify-center gap-3 px-6 py-12 text-center">
				<div class="text-4xl">🔒</div>
				<h1 class="diary-title">私密日记</h1>
				<p class="text-sm text-neutral-500 dark:text-neutral-400">这篇日记需要密码才能查看</p>
				<button
					type="button"
					id="diary-locked-btn"
					class="mt-2 inline-flex items-center gap-1.5 rounded-lg bg-(--btn-regular-bg) px-4 py-2 text-sm text-(--btn-content) transition-colors hover:bg-(--btn-regular-bg-hover)"
				>
					输入密码查看
				</button>
			</div>
		) : (
				<>
					<!-- 标题区：不放封面配图 -->
					<div class="px-5 sm:px-7 pt-5 sm:pt-6">
						<h1 class="diary-title">
							{entry.title || "无题"}
							{mood && <span class="diary-title-mood"> {mood.emoji}</span>}
						</h1>
						<div class="diary-meta">
							<span class="diary-hero-date">{formatDate(entry.date)} · {formatChineseTime(entry.date)}</span>
							{mood && <span class="diary-hero-pill">{mood.emoji} {mood.label}</span>}
							{tags.map((tag) => (
								<span class="diary-hero-tag">{tag}</span>
							))}
						</div>
					</div>

					{images.length > 0 && (
						<!-- 全部照片统一放在正文里 -->
						<div class={"diary-imgs px-5 sm:px-7 pt-5" + (images.length === 1 ? " is-single" : "")}>
							{images.map((img) => (
								<img src={img.url} alt="" class="diary-img" data-src={img.url} loading="lazy" draggable="false" />
							))}
						</div>
					)}

					<!-- 正文 -->
					<div class="diary-text px-5 sm:px-7 pb-6 pt-4">{entry.content || ""}</div>
				</>
			)}
	</div>

	<!-- 图片灯箱：点击照片看大图 -->
	<div id="diary-lightbox" class="diary-lightbox" hidden>
		<button type="button" id="diary-lightbox-close" class="diary-lightbox-close" aria-label="关闭">
			<Icon is:inline name="material-symbols:close" class="text-2xl" />
		</button>
		<img id="diary-lightbox-img" src="" alt="" class="diary-lightbox-img" />
	</div>

	<style is:global>
		/* ===================== 无图时的标题区 ===================== */
		.diary-title {
			margin: 0;
			font-size: 1.5rem;
			font-weight: 700;
			line-height: 1.4;
			color: var(--deep-text);
			word-break: break-all;
		}
		.diary-title-mood {
			font-size: 1.2rem;
		}
		.diary-meta {
			margin-top: 0.7rem;
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.45rem;
			font-size: 0.8rem;
			color: color-mix(in srgb, var(--deep-text) 55%, transparent);
		}
		.diary-meta .diary-hero-pill,
		.diary-meta .diary-hero-tag {
			display: inline-flex;
			align-items: center;
			border-radius: 999px;
			padding: 0.14rem 0.55rem;
			border: 1px solid var(--line-divider);
			background: color-mix(in srgb, var(--card-bg) 70%, transparent);
			color: color-mix(in srgb, var(--deep-text) 75%, transparent);
		}

		/* ===================== 照片（放在文章上方） ===================== */
		.diary-imgs {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 0.6rem;
		}
		.diary-imgs.is-single {
			grid-template-columns: 1fr;
		}
		.diary-img {
			display: block;
			width: 100%;
			aspect-ratio: 16 / 9;
			object-fit: cover;
			border-radius: 12px;
			border: 1px solid var(--line-divider);
			cursor: zoom-in;
			transition: transform 0.25s ease;
		}
		.diary-img:hover {
			transform: scale(1.02);
		}

		/* ===================== 正文 ===================== */
	.diary-text {
		white-space: pre-wrap;
		word-break: break-word;
		line-height: 2;
		/* 手机 16px → 桌面 18px 平滑过渡，阅读不费眼 */
		font-size: clamp(1rem, 0.94rem + 0.32vw, 1.125rem);
		color: var(--deep-text);
	}

		/* ===================== 内容区填满到屏幕底部 ===================== */
		/* 无论日记内容多少，内容区都从它所在位置一直延伸到底边对齐；
		   内容超过屏幕可视范围时在卡片内纵向滚动查看超出部分。
		   实际高度由 JS 按视口测量（高度 = 视口高 - 内容区顶部离顶距离），
		   这里先用占位值避免首次渲染滚动条跳动，并保证最小可读高度。 */
		.diary-detail-card {
			display: flex;
			flex-direction: column;
			height: calc(100vh - 5.5rem - 0.5rem);
			min-height: 24rem;
			overflow-y: auto;
			overflow-x: hidden;
			border-radius: var(--radius-large);
			scrollbar-width: thin;
			scrollbar-color: color-mix(in srgb, var(--deep-text) 25%, transparent) transparent;
		}
		.diary-detail-card::-webkit-scrollbar {
			width: 6px;
		}
		.diary-detail-card::-webkit-scrollbar-thumb {
			background: color-mix(in srgb, var(--deep-text) 25%, transparent);
			border-radius: 999px;
		}
		@media (max-width: 1023px) {
			.diary-detail-card {
				height: calc(100vh - 5.5rem - 0.5rem);
			}
		}

		/* ===================== 图片灯箱 ===================== */
		.diary-lightbox {
			position: fixed;
			inset: 0;
			z-index: 9999;
			display: flex;
			align-items: center;
			justify-content: center;
			background: rgb(0 0 0 / 0.82);
			backdrop-filter: blur(6px);
			-webkit-backdrop-filter: blur(6px);
		}
		.diary-lightbox[hidden] {
			display: none;
		}
		.diary-lightbox-close {
			position: absolute;
			top: 1rem;
			right: 1rem;
			z-index: 10;
			display: flex;
			align-items: center;
			justify-content: center;
			height: 2.5rem;
			width: 2.5rem;
			border: none;
			border-radius: 999px;
			cursor: pointer;
			background: rgb(255 255 255 / 0.1);
			color: #fff;
			transition: background 200ms ease;
		}
		.diary-lightbox-close:hover {
			background: rgb(255 255 255 / 0.2);
		}
		.diary-lightbox-img {
				max-height: 90vh;
				max-width: 90vw;
				border-radius: 10px;
				object-fit: contain;
				box-shadow: 0 24px 64px rgb(0 0 0 / 0.5);
			}
		</style>

	<script is:inline>
	(function () {
			var MOOD_MAP = {
				"super-happy": { label: "炒鸡开心", emoji: "🤩" },
				happy: { label: "开心", emoji: "😊" },
				neutral: { label: "平平淡淡", emoji: "😐" },
				unhappy: { label: "不开心", emoji: "😔" },
				sad: { label: "伤心难过", emoji: "😭" },
			};
			var UNLOCK_KEY = "aemeath-diary-unlocked";
			var DIARY_PASSWORD = "2299";

			/* 内容区填满到屏幕底部：
			   高度 = 视口高 - 卡片顶部离视口顶的距离，保证底边与屏幕底边对齐；
			   无论壁纸模式/页面布局/设备尺寸，测量都准确。 */
			var card = document.querySelector(".diary-detail-card");
			var BOTTOM_GAP = 8; // 底部预留 8px 小间距，避免贴得太死
			function fitCardHeight() {
				if (!card) return;
				var top = card.getBoundingClientRect().top;
				if (top < 0 || top > window.innerHeight) top = 5.5 * 16; // 未就绪时回退
				var h = window.innerHeight - top - BOTTOM_GAP;
				if (h < 24 * 16) h = 24 * 16; // 保底最小高度
				card.style.height = h + "px";
			}
			if (card) {
				// 首次渲染 + 壁纸初始化完成后各测量一次，避免布局未稳定时算错
				fitCardHeight();
				var fitTimer = null;
				function requestFit() {
					clearTimeout(fitTimer);
					fitTimer = setTimeout(fitCardHeight, 60);
				}
				window.addEventListener("resize", requestFit);
				window.addEventListener("load", fitCardHeight);
				document.addEventListener("wallpaper-initialized", fitCardHeight, { once: true });
			}

			var lightbox = document.getElementById("diary-lightbox");
		var lightboxImg = document.getElementById("diary-lightbox-img");
		var lightboxClose = document.getElementById("diary-lightbox-close");

		if (lightbox) {
			// 灯箱移到 body 下，避免父级 transform 让 fixed 定位失效；
			// 顺带清理跨页面导航后可能残留在 body 下的同名旧节点
			document.querySelectorAll("#diary-lightbox").forEach(function (n) {
				if (n !== lightbox) n.remove();
			});
			document.body.appendChild(lightbox);

			function closeLightbox() {
				lightbox.hidden = true;
			}
			lightboxClose.addEventListener("click", closeLightbox);
			lightbox.addEventListener("click", function (e) {
				if (e.target === lightbox) closeLightbox();
			});
			document.addEventListener("keydown", function (e) {
				if (e.key === "Escape" && !lightbox.hidden) closeLightbox();
			});
		}

		/* 点击照片看大图 */
		function bindLightbox() {
			document.querySelectorAll(".diary-img").forEach(function (img) {
				img.addEventListener("click", function () {
					lightboxImg.src = img.dataset.src || img.src;
					lightbox.hidden = false;
				});
			});
		}
		bindLightbox();

		/* 私密日记：已解锁则拉取内容渲染，否则等输入密码 */
		var lockedBox = document.getElementById("diary-locked");
		if (!lockedBox) return;
		var slug = lockedBox.dataset.slug;
		var btn = document.getElementById("diary-locked-btn");
		var unlocked = false;
		try {
			unlocked = sessionStorage.getItem(UNLOCK_KEY) === "1";
		} catch (e) {}

		function formatDate(dateStr) {
			var d = new Date(dateStr);
			if (isNaN(d.getTime())) return dateStr;
			return (
				d.getFullYear() +
				"年" +
				String(d.getMonth() + 1).padStart(2, "0") +
				"月" +
				String(d.getDate()).padStart(2, "0") +
				"日"
			);
		}

		function formatChineseTime(dateStr) {
			var d = new Date(dateStr);
			if (isNaN(d.getTime())) return "";
			var h = d.getHours();
			var m = String(d.getMinutes()).padStart(2, "0");
			var period = "凌晨";
			if (h >= 5 && h < 8) period = "早上";
			else if (h >= 8 && h < 11) period = "上午";
			else if (h >= 11 && h < 13) period = "中午";
			else if (h >= 13 && h < 17) period = "下午";
			else if (h >= 17 && h < 19) period = "傍晚";
			else if (h >= 19 && h < 23) period = "晚上";
			else if (h >= 23) period = "深夜";
			var h12 = h % 12 || 12;
			return period + " " + h12 + ":" + m;
		}

		function escapeHtml(str) {
			var div = document.createElement("div");
			div.textContent = str == null ? "" : String(str);
			return div.innerHTML;
		}

		/* 与服务端同款的详情结构渲染（标题 → 照片 → 正文） */
		function renderPrivate(entry) {
			var mood = entry.mood ? MOOD_MAP[entry.mood] : null;
			var imgs = entry.images || [];

			var metaHtml =
				'<div class="diary-meta">' +
				'<span class="diary-hero-date">' + formatDate(entry.date) + " · " + formatChineseTime(entry.date) + "</span>" +
				(mood ? '<span class="diary-hero-pill">' + mood.emoji + " " + mood.label + "</span>" : "") +
				(entry.tags || [])
					.map(function (tag) {
						return '<span class="diary-hero-tag">' + escapeHtml(tag) + "</span>";
					})
					.join("") +
				"</div>";

			var html =
				'<div class="px-5 sm:px-7 pt-5 sm:pt-6">' +
				'<h1 class="diary-title">' +
				escapeHtml(entry.title || "无题") +
				(mood ? ' <span class="diary-title-mood">' + mood.emoji + "</span>" : "") +
				"</h1>" + metaHtml + "</div>";

			if (imgs.length) {
				html +=
					'<div class="diary-imgs px-5 sm:px-7 pt-5' + (imgs.length === 1 ? " is-single" : "") + '">';
				imgs.forEach(function (img) {
					html += '<img src="' + img.url + '" alt="" class="diary-img" data-src="' + img.url + '" loading="lazy" draggable="false">';
				});
				html += "</div>";
			}

			html += '<div class="diary-text px-5 sm:px-7 pb-6 pt-4">' + escapeHtml(entry.content || "") + "</div>";

			var wrap = document.createElement("div");
			wrap.innerHTML = html;
			lockedBox.replaceWith(wrap);
			bindLightbox();
		}

		function loadAndRender() {
			fetch("/diary/index.json")
				.then(function (r) {
					return r.json();
				})
				.then(function (list) {
					var entry = list.find(function (e) {
						return e.slug === slug;
					});
					if (entry) renderPrivate(entry);
				})
				.catch(function (err) {
					console.error("Failed to load diary:", err);
				});
		}

		if (unlocked) {
			loadAndRender();
		} else if (btn) {
			btn.addEventListener("click", function () {
				var pwd = prompt("这是一篇私密日记，请输入密码：");
				if (pwd === DIARY_PASSWORD) {
					try {
						sessionStorage.setItem(UNLOCK_KEY, "1");
					} catch (e) {}
					loadAndRender();
				} else if (pwd !== null) {
					alert("密码错误");
				}
			});
		}
	})();
	</script>
</MainGridLayout>
