---
import { Icon } from "astro-icon/components";
import EncryptedContent from "@/components/features/EncryptedContent.astro";
import PhotoScatter from "@/components/pages/gallery/PhotoScatter.astro";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { scanAlbumPhotoItems } from "@/utils/gallery-utils";
import { url } from "@/utils/url-utils";

// 检查页面是否启用
if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

export function getStaticPaths() {
	return galleryConfig.albums.map((album) => ({
		params: { album: album.id },
	}));
}

const { album: albumId } = Astro.params;
const albumMeta = galleryConfig.albums.find((a) => a.id === albumId);

if (!albumMeta) {
	return Astro.redirect("/404/");
}

const photoItems = scanAlbumPhotoItems(albumMeta.id);

// 散落照片墙数据：PhotoScatter 读取后直接铺满页面
const scatterPayload = JSON.stringify({
	album: albumMeta.id,
	name: albumMeta.name,
	backHref: url("/gallery/"),
	date: albumMeta.date || "",
	tags: albumMeta.tags || [],
	photos: photoItems.map((photo) => ({
		src: photo.src,
		description: photo.description || "",
		date: photo.date || "",
		tags: photo.tags || [],
	})),
});
---

<MainGridLayout title={albumMeta.name} description={albumMeta.description || ""} hideSidebars>
  {
    photoItems.length > 0 ? (
      albumMeta.password ? (
        <EncryptedContent
          password={albumMeta.password}
          slug={albumMeta.id}
          hint={albumMeta.passwordHint}
        >
          <script type="application/json" data-scatter-data set:html={scatterPayload} />
        </EncryptedContent>
      ) : (
        <script type="application/json" data-scatter-data set:html={scatterPayload} />
      )
    ) : (
      <div class="card-base px-6 py-12 flex flex-col items-center text-center">
        <Icon is:inline name="material-symbols:photo-library" class="text-6xl mb-4 opacity-50 text-neutral-400 dark:text-neutral-500" />
        <p class="text-lg text-neutral-500 dark:text-neutral-400 mb-4">
          {i18n(I18nKey.galleryNoAlbums)}
        </p>
        <a
          href={url("/gallery/")}
          class="inline-flex items-center gap-1.5 text-sm text-(--primary) hover:underline"
        >
          <Icon is:inline name="material-symbols:arrow-back" class="text-base" />
          {i18n(I18nKey.galleryBackToAlbums)}
        </a>
      </div>
    )
  }

  <PhotoScatter album={albumId} />
</MainGridLayout>
