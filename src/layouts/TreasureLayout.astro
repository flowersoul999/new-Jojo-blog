---
// 百宝箱独立布局：不套用主站 MainGridLayout（无侧边栏），自带全屏背景 + 主题初始化
// 工具组件为 React 岛，样式依赖旧博客主题令牌（见 styles/treasure-compat.css）
import "@/styles/main.css";
import { siteConfig } from "@/config";
import TreasureToaster from "@/components/react-treasure/toaster";

interface Props {
	title: string;
}

const { title } = Astro.props;
const pageTitle = `${title} | ${siteConfig.title}`;
const hue = siteConfig.themeColor.hue;
const defaultMode = siteConfig.themeColor.defaultMode;
---

<!doctype html>
<html lang="zh-CN" class="treasure-html">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href="/favicon.ico" />
		<title>{pageTitle}</title>
		<script is:inline define:vars={{ hue, defaultMode }}>
			// 与主站 setting-utils 保持一致的主题初始化（localStorage key: theme / hue）
			const LIGHT_MODE = "light";
			const DARK_MODE = "dark";
			const SYSTEM_MODE = "system";

			function getSystemTheme() {
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? DARK_MODE : LIGHT_MODE;
			}
			function resolveTheme(themeValue) {
				return themeValue === SYSTEM_MODE ? getSystemTheme() : themeValue;
			}

			const theme = localStorage.getItem("theme") || defaultMode;
			const resolvedTheme = resolveTheme(theme);
			if (resolvedTheme === DARK_MODE) {
				document.documentElement.classList.add("dark");
			} else {
				document.documentElement.classList.remove("dark");
			}
			const storedHue = localStorage.getItem("hue") || hue;
			document.documentElement.style.setProperty("--hue", storedHue);
		</script>
	</head>
	<body class="treasure-root">
		<a
			href="/"
			class="fixed top-4 left-4 z-50 inline-flex items-center gap-1.5 rounded-full border bg-card/70 px-3.5 py-2 text-xs font-medium backdrop-blur-md transition-all hover:border-brand/50 hover:shadow-lg hover:shadow-brand/10"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="m15 18-6-6 6-6"></path>
			</svg>
			返回主页
		</a>
		<slot />
		<TreasureToaster client:load />
	</body>
</html>
