---
// 面试板块的编辑入口：登录后才出现，所有面试页面共用（放在 InterviewShell 的页头里）。
// 字段由 src/data/interview-admin.ts 声明，这个组件只负责渲染表单 + 拼 frontmatter。
// 写入走仓库既有的 /api/content/{list,read,write,delete} 四件套。
import { Icon } from "astro-icon/components";
import {
	ADMIN_COLLECTIONS,
	type AdminCollectionKey,
} from "@/data/interview-admin";

interface Props {
	/** 要管理哪个集合，对应 ADMIN_COLLECTIONS 的 key */
	collection?: AdminCollectionKey;
}

const { collection = "interviews" } = Astro.props;
const spec = ADMIN_COLLECTIONS[collection];
---

<div class="iv-admin" data-iv-admin data-key={collection} hidden>
	<button type="button" class="iv-admin__open" data-iv-open>
		<Icon is:inline name="material-symbols:edit-square-outline" class="iv-admin__open-icon" />
		<span>管理{spec.label}</span>
	</button>

	<dialog class="iv-admin__dialog" data-iv-dialog>
		<div class="iv-admin__head">
			<div>
				<h2 class="iv-admin__title" data-iv-title>{spec.label}管理</h2>
				<p class="iv-admin__sub" data-iv-count></p>
			</div>
			<button type="button" class="iv-admin__x" data-iv-close aria-label="关闭">
				<Icon is:inline name="material-symbols:close-rounded" />
			</button>
		</div>

		<div class="iv-admin__scroll">
			<div class="iv-admin__list-view" data-iv-list-view>
				<div class="iv-admin__toolbar">
					<button type="button" class="iv-admin__btn iv-admin__btn--primary" data-iv-new>
						<Icon is:inline name="material-symbols:add-rounded" />
						新建{spec.label}
					</button>
					<button type="button" class="iv-admin__btn" data-iv-reload>
						<Icon is:inline name="material-symbols:refresh-rounded" />
						刷新
					</button>
				</div>
				<ul class="iv-admin__list" data-iv-list></ul>
				<p class="iv-admin__empty" data-iv-empty hidden>这个集合里还没有内容，点「新建{spec.label}」开始。</p>
			</div>

			<form class="iv-admin__form" data-iv-form hidden novalidate>
				<div class="iv-admin__grid">
					{
						spec.fields.map((f) => (
							<label
								class:list={["iv-admin__field", { "iv-admin__field--wide": f.wide }]}
							>
								<span>
									{f.label}
									{f.hint && <span class="iv-admin__hint">{f.hint}</span>}
								</span>
								{f.type === "select" ? (
									<select name={f.name}>
										{f.options?.map((opt) => (
											<option value={opt} selected={opt === f.value}>
												{opt}
											</option>
										))}
									</select>
								) : f.type === "textarea" ? (
									<textarea
										name={f.name}
										rows={f.rows ?? 12}
										placeholder={f.placeholder}
									/>
								) : (
									<input
										type={
											f.type === "date"
												? "date"
												: f.type === "number"
													? "number"
													: "text"
										}
										name={f.name}
										value={f.value}
										placeholder={f.placeholder}
										min={f.min}
										max={f.max}
									/>
								)}
							</label>
						))
					}
				</div>

				<p class="iv-admin__error" data-iv-error hidden></p>

				<div class="iv-admin__actions">
					<button type="button" class="iv-admin__btn" data-iv-cancel>取消</button>
					<button type="submit" class="iv-admin__btn iv-admin__btn--primary" data-iv-save>
						保存
					</button>
				</div>
			</form>
		</div>
	</dialog>
</div>

<script>
	import { ADMIN_COLLECTIONS, type AdminField } from "@/data/interview-admin";

	interface Entry {
		name: string;
		path: string;
		sha: string;
	}

	interface ReadResult {
		path: string;
		content: string | null;
		sha: string;
	}

	/** 表单里所有值都按字符串收，拼 YAML 时再按字段类型转换 */
	type Values = Record<string, string>;

	let cleanup: (() => void) | null = null;

	async function request<T>(path: string, init?: RequestInit): Promise<T> {
		const res = await fetch(path, init);
		const data = (await res.json().catch(() => ({}))) as {
			ok?: boolean;
			error?: string;
		};
		if (!res.ok || data.ok === false) {
			throw new Error(data.error || `请求失败（${res.status}）`);
		}
		return data as T;
	}

	function yamlString(value: string): string {
		return `"${value.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`;
	}

	function splitList(raw: string, separator: RegExp): string[] {
		return raw
			.split(separator)
			.map((item) => item.trim())
			.filter(Boolean);
	}

	function toFrontmatter(values: Values, fields: AdminField[]): string {
		const lines = ["---"];
		for (const field of fields) {
			if (field.virtual) continue;
			const raw = values[field.name] ?? "";
			if (field.type === "tags") {
				const tags = splitList(raw, /[,，]/);
				lines.push(`${field.name}: [${tags.map(yamlString).join(", ")}]`);
			} else if (field.type === "nums") {
				const nums = splitList(raw, /[,，\s]+/)
					.map(Number)
					.filter((n) => Number.isFinite(n));
				lines.push(`${field.name}: [${nums.join(", ")}]`);
			} else if (field.type === "number") {
				const num = Number(raw);
				lines.push(`${field.name}: ${raw !== "" && Number.isFinite(num) ? num : (field.min ?? 0)}`);
			} else if (field.type === "date") {
				lines.push(`${field.name}: ${raw}`);
			} else {
				lines.push(`${field.name}: ${yamlString(raw)}`);
			}
		}
		lines.push("draft: false", "---");
		return lines.join("\n");
	}

	/** 从已有 md 里拆出 frontmatter（只处理这几个集合用到的简单标量 / 行内数组） */
	function parseFrontmatter(raw: string) {
		const match = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
		if (!match) return { meta: {} as Record<string, string>, body: raw };
		const meta: Record<string, string> = {};
		for (const line of match[1].split(/\r?\n/)) {
			const at = line.indexOf(":");
			if (at < 0) continue;
			meta[line.slice(0, at).trim()] = line.slice(at + 1).trim();
		}
		return { meta, body: match[2].replace(/^\n+/, "") };
	}

	function valueFromMeta(field: AdminField, raw: string | undefined): string {
		if (field.virtual) return "";
		if (!raw) return field.value ?? "";
		if (field.type === "tags" || field.type === "nums") {
			return raw
				.replace(/^\[|\]$/g, "")
				.split(",")
				.map((item) => item.trim().replace(/^["']|["']$/g, ""))
				.filter(Boolean)
				.join(", ");
		}
		return raw.replace(/^["']|["']$/g, "");
	}

	function today(): string {
		const now = new Date();
		const pad = (n: number) => String(n).padStart(2, "0");
		return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
	}

	/** 文件名只留字母数字汉字和连字符，避免出现空格 / 斜杠 / 冒号 */
	function sanitize(slug: string): string {
		return slug
			.replace(/\.mdx?$/i, "")
			.replace(/[^\w\u4e00-\u9fa5-]+/g, "-")
			.replace(/-+/g, "-")
			.replace(/^-|-$/g, "")
			.slice(0, 60);
	}

	function initInterviewAdmin() {
		const root = document.querySelector<HTMLElement>("[data-iv-admin]");
		if (!root) return;
		const spec = ADMIN_COLLECTIONS[(root.dataset.key ?? "interviews") as keyof typeof ADMIN_COLLECTIONS];
		if (!spec) return;

		const dialog = root.querySelector<HTMLDialogElement>("[data-iv-dialog]");
		const listEl = root.querySelector<HTMLUListElement>("[data-iv-list]");
		const emptyEl = root.querySelector<HTMLElement>("[data-iv-empty]");
		const countEl = root.querySelector<HTMLElement>("[data-iv-count]");
		const listView = root.querySelector<HTMLElement>("[data-iv-list-view]");
		const form = root.querySelector<HTMLFormElement>("[data-iv-form]");
		const errorEl = root.querySelector<HTMLElement>("[data-iv-error]");
		const titleEl = root.querySelector<HTMLElement>("[data-iv-title]");
		const saveBtn = root.querySelector<HTMLButtonElement>("[data-iv-save]");
		if (!dialog || !listEl || !form) return;

		let editing: { path: string; sha: string } | null = null;
		let busy = false;

		const showError = (message: string) => {
			if (!errorEl) return;
			errorEl.textContent = message;
			errorEl.hidden = !message;
		};

		const input = (name: string) =>
			form?.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
				`[name="${name}"]`,
			) ?? null;

		function resetForm() {
			form?.reset();
			for (const field of spec.fields) {
				const el = input(field.name);
				if (!el) continue;
				el.value = field.type === "date" ? today() : (field.value ?? "");
			}
			showError("");
		}

		function readValues(): Values {
			const values: Values = {};
			for (const field of spec.fields) {
				values[field.name] = (input(field.name)?.value ?? "").trim();
			}
			return values;
		}

		async function loadList() {
			listEl.textContent = "";
			showError("");
			try {
				const entries = await request<Entry[]>(
					`/api/content/list/?path=${encodeURIComponent(spec.dir)}`,
				);
				const files = entries
					.filter((entry) => entry.name.endsWith(".md") || entry.name.endsWith(".mdx"))
					.sort((a, b) => b.name.localeCompare(a.name));

				if (countEl) countEl.textContent = `共 ${files.length} 篇`;
				if (emptyEl) emptyEl.hidden = files.length > 0;

				for (const file of files) {
					const li = document.createElement("li");
					li.className = "iv-admin__item";

					const name = document.createElement("span");
					name.className = "iv-admin__item-name";
					name.textContent = file.name.replace(/\.mdx?$/, "");

					const meta = document.createElement("span");
					meta.className = "iv-admin__item-meta";
					meta.textContent = file.path;

					const edit = document.createElement("button");
					edit.type = "button";
					edit.className = "iv-admin__btn iv-admin__btn--sm";
					edit.textContent = "编辑";
					edit.addEventListener("click", () => void openEditor(file));

					const del = document.createElement("button");
					del.type = "button";
					del.className = "iv-admin__btn iv-admin__btn--sm iv-admin__btn--danger";
					del.textContent = "删除";
					del.addEventListener("click", () => void removeEntry(file));

					const row = document.createElement("div");
					row.className = "iv-admin__item-text";
					row.append(name, meta);

					const ops = document.createElement("div");
					ops.className = "iv-admin__item-ops";
					ops.append(edit, del);

					li.append(row, ops);
					listEl.append(li);
				}
			} catch (error) {
				showError(error instanceof Error ? error.message : "列表加载失败");
			}
		}

		async function openEditor(file?: Entry) {
			resetForm();
			if (file) {
				if (titleEl) titleEl.textContent = `编辑${spec.label}`;
				try {
					const data = await request<ReadResult>(
						`/api/content/read/?path=${encodeURIComponent(file.path)}`,
					);
					const { meta, body } = parseFrontmatter(data.content ?? "");
					for (const field of spec.fields) {
						const el = input(field.name);
						if (el) el.value = valueFromMeta(field, meta[field.name]);
					}
					const bodyEl = input("body");
					if (bodyEl) bodyEl.value = body;
					const nameEl = input("filename");
					if (nameEl) {
						nameEl.value = file.name.replace(/\.mdx?$/, "");
						// 改名 = 删旧文件 + 建新文件，走 GitHub Contents API 时容易留残骸，编辑时先锁住
						nameEl.readOnly = true;
					}
					editing = { path: file.path, sha: data.sha || file.sha };
				} catch (error) {
					showError(error instanceof Error ? error.message : "读取失败");
					return;
				}
			} else {
				editing = null;
				if (titleEl) titleEl.textContent = `新建${spec.label}`;
				const nameEl = input("filename");
				if (nameEl) nameEl.readOnly = false;
			}
			if (listView) listView.hidden = true;
			form.hidden = false;
			(form.querySelector('[name="company"], [name="category"], [name="title"]') as
				| HTMLInputElement
				| null)?.focus();
		}

		function backToList() {
			form.hidden = true;
			if (listView) listView.hidden = false;
			editing = null;
			showError("");
			void loadList();
		}

		async function removeEntry(file: Entry) {
			const label = file.name.replace(/\.mdx?$/, "");
			if (
				!window.confirm(
					`删除「${label}」？\n\n会直接改动仓库文件，删掉的可以从 git 历史找回。`,
				)
			) {
				return;
			}
			try {
				await request("/api/content/delete/", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						path: file.path,
						sha: file.sha,
						message: `Delete ${file.name}`,
					}),
				});
				await loadList();
			} catch (error) {
				showError(error instanceof Error ? error.message : "删除失败");
			}
		}

		function buildSlug(values: Values): string {
			const custom = sanitize(values.filename ?? "");
			if (custom) return custom;
			const parts = [
				spec.fields.some((field) => field.name === "date") ? values.date?.slice(0, 10) : "",
				...spec.slugFrom.map((key) => values[key]),
			].filter(Boolean);
			return sanitize(parts.join("-")) || `entry-${Date.now().toString(36)}`;
		}

		async function submit() {
			if (busy) return;
			const values = readValues();
			const missing = spec.fields.filter((field) => field.required && !values[field.name]);
			if (missing.length) {
				showError(`必填：${missing.map((field) => field.label).join("、")}`);
				return;
			}

			const cleanSlug = buildSlug(values);
			const path = editing?.path ?? `${spec.dir}/${cleanSlug}.md`;
			const body = input("body") ? (input("body") as HTMLTextAreaElement).value : "";

			busy = true;
			if (saveBtn) saveBtn.disabled = true;
			showError("");
			try {
				await request("/api/content/write/", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						path,
						content: `${toFrontmatter(values, spec.fields)}\n\n${body.trimEnd()}\n`,
						sha: editing?.sha,
						message: `${editing ? "Update" : "Add"} ${cleanSlug}`,
					}),
				});
				backToList();
			} catch (error) {
				showError(error instanceof Error ? error.message : "保存失败");
			} finally {
				busy = false;
				if (saveBtn) saveBtn.disabled = false;
			}
		}

		const onOpen = () => {
			dialog.showModal();
			void loadList();
		};
		const onClose = () => dialog.close();
		const onDialogClick = (event: MouseEvent) => {
			if (event.target === dialog) dialog.close();
		};

		const openBtn = root.querySelector<HTMLButtonElement>("[data-iv-open]");
		const closeBtn = root.querySelector<HTMLButtonElement>("[data-iv-close]");
		const newBtn = root.querySelector<HTMLButtonElement>("[data-iv-new]");
		const reloadBtn = root.querySelector<HTMLButtonElement>("[data-iv-reload]");
		const cancelBtn = root.querySelector<HTMLButtonElement>("[data-iv-cancel]");

		openBtn?.addEventListener("click", onOpen);
		closeBtn?.addEventListener("click", onClose);
		newBtn?.addEventListener("click", () => void openEditor());
		reloadBtn?.addEventListener("click", () => void loadList());
		cancelBtn?.addEventListener("click", backToList);
		dialog.addEventListener("click", onDialogClick);
		form.addEventListener("submit", (event) => {
			event.preventDefault();
			void submit();
		});

		// 登录态：只有已登录才把入口放出来
		void request<{ authenticated: boolean }>("/api/auth/status/")
			.then((status) => {
				if (status.authenticated) root.hidden = false;
			})
			.catch(() => {});

		cleanup = () => {
			openBtn?.removeEventListener("click", onOpen);
			closeBtn?.removeEventListener("click", onClose);
			dialog.removeEventListener("click", onDialogClick);
			if (dialog.open) dialog.close();
		};
	}

	function boot() {
		cleanup?.();
		cleanup = null;
		initInterviewAdmin();
	}

	document.addEventListener("astro:page-load", boot);
	document.addEventListener("astro:before-swap", () => {
		cleanup?.();
		cleanup = null;
	});
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", boot, { once: true });
	} else {
		boot();
	}
</script>

<!--
	必须 is:global：列表项和「编辑 / 删除」按钮是 JS 里 document.createElement 出来的，
	拿不到 Astro 给模板节点加的作用域属性，scoped 样式对它们完全无效。
	所有类名都带 iv-admin__ 前缀，不会外溢。
-->
<style is:global>
	.iv-admin {
		min-width: 0;
	}

	.iv-admin[hidden] {
		display: none;
	}

	.iv-admin__open {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.7rem;
		border: 1px solid color-mix(in srgb, var(--iv-accent) 48%, transparent);
		border-radius: 999px;
		/* 页头压在插画上，纯白底会糊掉，这里给一层半透明磨砂 + 淡色描边 */
		background: color-mix(in srgb, var(--iv-surface) 74%, transparent);
		backdrop-filter: blur(8px);
		box-shadow: 0 3px 12px rgb(0 0 0 / 14%);
		font-size: 0.72rem;
		font-weight: 600;
		color: color-mix(in srgb, var(--iv-accent) 78%, var(--iv-title));
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.iv-admin__open:hover {
		border-color: var(--iv-accent);
		background: var(--iv-surface);
		color: var(--iv-accent);
	}

	.iv-admin__open-icon {
		width: 0.95rem;
		height: 0.95rem;
	}

	.iv-admin__dialog {
		position: fixed;
		inset: 0;
		display: flex;
		flex-direction: column;
		margin: auto;
		width: min(46rem, calc(100vw - 2rem));
		max-height: min(88vh, 52rem);
		height: fit-content;
		padding: 0;
		border: 1px solid var(--iv-line);
		border-radius: 18px;
		background: var(--iv-surface);
		color: var(--iv-title);
		overflow: hidden;
	}

	.iv-admin__dialog::backdrop {
		background: rgb(0 0 0 / 45%);
		backdrop-filter: blur(2px);
	}

	.iv-admin__head {
		flex: none;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.15rem 1.3rem 0.9rem;
		border-bottom: 1px solid var(--iv-line);
	}

	.iv-admin__title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 800;
		color: var(--iv-title);
	}

	.iv-admin__sub {
		margin: 0.2rem 0 0;
		font-size: 0.74rem;
		color: var(--iv-faint);
	}

	.iv-admin__x {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.9rem;
		height: 1.9rem;
		border: 1px solid var(--iv-line);
		border-radius: 10px;
		background: transparent;
		color: var(--iv-muted);
		cursor: pointer;
	}

	.iv-admin__x:hover {
		color: var(--iv-accent);
		border-color: color-mix(in srgb, var(--iv-accent) 45%, transparent);
	}

	.iv-admin__scroll {
		flex: 1 1 auto;
		min-height: 0;
		overflow-y: auto;
		padding: 1rem 1.3rem 1.3rem;
	}

	.iv-admin__toolbar {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.9rem;
	}

	.iv-admin__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.45rem 0.85rem;
		border: 1px solid var(--iv-line);
		border-radius: 10px;
		background: var(--iv-surface);
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--iv-muted);
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.iv-admin__btn:hover {
		border-color: color-mix(in srgb, var(--iv-accent) 50%, transparent);
		color: var(--iv-accent);
	}

	.iv-admin__btn--primary {
		border-color: color-mix(in srgb, var(--iv-accent) 55%, transparent);
		background: color-mix(in srgb, var(--iv-accent) 12%, transparent);
		color: var(--iv-accent);
	}

	.iv-admin__btn--sm {
		padding: 0.28rem 0.6rem;
		font-size: 0.72rem;
	}

	.iv-admin__btn--danger:hover {
		border-color: var(--iv-hard);
		color: var(--iv-hard);
	}

	.iv-admin__btn:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}

	.iv-admin__list {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.iv-admin__item {
		display: flex;
		align-items: center;
