---
import { Icon } from "astro-icon/components";
---

<!-- 底部浮动歌词 -->
<div
	class="fm-float-lrc pointer-events-none fixed left-1/2 bottom-8 z-[131] -translate-x-1/2 max-w-[90vw] text-center opacity-0 transition-all duration-300"
	aria-live="polite"
>
	<span class="fm-float-lrc-text block whitespace-nowrap overflow-hidden text-ellipsis text-2xl text-neutral-700/85 dark:text-neutral-200/90"></span>
</div>

<!-- 悬浮迷你播放器（左下角，参照 fqzlr 毛玻璃风格） -->
<div
	class="fm-mini fixed bottom-4 left-4 z-[130] w-[min(94vw,440px)] translate-y-6 scale-95 opacity-0 pointer-events-none transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
	role="dialog"
	aria-label="悬浮播放器"
>
	<div class="relative flex items-center gap-2.5 rounded-[20px] border border-white/50 bg-white/60 p-2.5 pl-3 pr-8 shadow-[0_8px_24px_rgba(0,0,0,0.14)] backdrop-blur-xl dark:border-white/10 dark:bg-neutral-900/60">
		<!-- 关闭 -->
		<button data-ana="关闭悬浮播放器" class="fm-mini-close absolute right-1.5 top-1.5 z-20 rounded-full p-0.5 text-neutral-400 transition hover:text-(--primary) active:scale-95" title="关闭悬浮播放器" aria-label="关闭悬浮播放器">
			<Icon is:inline name="material-symbols:close-rounded" class="text-lg" aria-hidden="true" />
		</button>

		<!-- 唱片（旋转 + 中央播放态，仿 fqzlr disc） -->
		<button data-ana="播放或暂停音乐" class="fm-mini-cover-btn relative h-11 w-11 shrink-0 rounded-full transition-transform active:scale-95" title="播放/暂停" aria-label="播放/暂停">
			<img class="fm-mini-cover h-full w-full rounded-full object-cover shadow-[0_0_0_1.5px_#fff,0_0_0_2.5px_rgba(0,0,0,0.55),0_5px_16px_rgba(0,0,0,0.22)] dark:shadow-[0_0_0_1.5px_#000,0_0_0_2.5px_rgba(255,255,255,0.7),0_5px_16px_rgba(0,0,0,0.45)]" src="" alt="封面" />
			<span class="fm-mini-cover-mask absolute inset-0 flex items-center justify-center rounded-full bg-black/30 opacity-0 transition-opacity">
				<Icon is:inline name="material-symbols:play-arrow-rounded" class="fm-mini-icon-play text-xl text-white ml-0.5" aria-hidden="true" />
				<Icon is:inline name="material-symbols:pause-rounded" class="fm-mini-icon-pause text-xl text-white hidden" aria-hidden="true" />
			</span>
		</button>

		<!-- 歌曲信息 + 进度 -->
		<div class="min-w-0 flex-1">
			<div class="flex items-baseline gap-2 leading-tight">
				<span class="fm-mini-title min-w-0 flex-1 truncate text-sm font-bold text-neutral-800 dark:text-neutral-100">未在播放</span>
				<span class="fm-mini-artist max-w-[42%] shrink-0 truncate text-[11px] text-neutral-500 dark:text-neutral-400">—</span>
			</div>
			<div class="mt-0.5 flex items-center gap-1">
				<span class="fm-mini-current w-7 shrink-0 text-right text-[10px] tabular-nums text-neutral-400">0:00</span>
				<div class="fm-mini-track relative h-5 min-w-0 flex-1 cursor-pointer touch-none" role="slider" aria-label="播放进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
					<div class="fm-mini-fill absolute left-0 top-1/2 h-[3px] w-0 -translate-y-1/2 rounded-full bg-(--primary) pointer-events-none"></div>
					<svg class="fm-mini-wave absolute left-0 top-0 h-full w-full overflow-visible pointer-events-none" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
						<defs>
							<clipPath id="fm-mini-wave-clip">
								<rect class="fm-mini-clip" x="0" y="0" width="0" height="20"></rect>
							</clipPath>
						</defs>
						<g class="fm-mini-waveflow" clip-path="url(#fm-mini-wave-clip)">
							<path class="fm-mini-wavepath" d="" fill="none" stroke="var(--primary)" stroke-width="5" stroke-linecap="round" vector-effect="non-scaling-stroke"></path>
						</g>
					</svg>
					<div class="fm-mini-thumb pointer-events-none absolute left-0 top-1/2 z-10 -ml-[5px] -mt-[5px] h-2.5 w-2.5 rounded-full bg-(--primary) ring-2 ring-white shadow-sm dark:ring-neutral-800"></div>
				</div>
				<span class="fm-mini-total w-7 shrink-0 text-[10px] tabular-nums text-neutral-400">0:00</span>
			</div>
		</div>

		<!-- 控制条（单行紧凑，参照 fqzlr toolbar） -->
		<div class="flex shrink-0 items-center justify-end gap-0.5">
			<button data-ana="上一首歌曲" class="fm-mini-prev p-1.5 text-neutral-600 transition hover:text-(--primary) active:scale-95 dark:text-neutral-300" title="上一首" aria-label="上一首">
				<Icon is:inline name="material-symbols:skip-previous-rounded" class="text-xl" aria-hidden="true" />
			</button>
			<button data-ana="播放或暂停音乐" class="fm-mini-play mx-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-neutral-900 text-white transition active:scale-95 dark:bg-white dark:text-neutral-900" title="播放/暂停" aria-label="播放/暂停">
				<Icon is:inline name="material-symbols:play-arrow-rounded" class="fm-mini-icon-play-big ml-0.5 text-xl" aria-hidden="true" />
				<Icon is:inline name="material-symbols:pause-rounded" class="fm-mini-icon-pause-big hidden text-xl" aria-hidden="true" />
			</button>
			<button data-ana="下一首歌曲" class="fm-mini-next p-1.5 text-neutral-600 transition hover:text-(--primary) active:scale-95 dark:text-neutral-300" title="下一首" aria-label="下一首">
				<Icon is:inline name="material-symbols:skip-next-rounded" class="text-xl" aria-hidden="true" />
			</button>
			<button data-ana="切换播放模式" class="fm-mini-mode p-1.5 text-neutral-400 transition hover:text-(--primary) active:scale-95" title="播放模式" aria-label="播放模式">
				<Icon is:inline name="material-symbols:repeat-rounded" class="fm-mini-icon-repeat text-lg" aria-hidden="true" />
				<Icon is:inline name="material-symbols:repeat-one-rounded" class="fm-mini-icon-repeat-one text-lg hidden" aria-hidden="true" />
				<Icon is:inline name="material-symbols:shuffle-rounded" class="fm-mini-icon-shuffle text-lg hidden" aria-hidden="true" />
			</button>
			<button data-ana="切换音乐静音" class="fm-mini-mute p-1.5 text-neutral-400 transition hover:text-(--primary) active:scale-95" title="静音" aria-label="静音">
				<Icon is:inline name="material-symbols:volume-up-rounded" class="fm-mini-icon-vol-up text-lg" aria-hidden="true" />
				<Icon is:inline name="material-symbols:volume-off-rounded" class="fm-mini-icon-vol-off text-lg hidden" aria-hidden="true" />
			</button>
		</div>
	</div>
</div>

<script data-swup-ignore-script is:inline>
(function () {
    if (window.__fireflyMusicFloat) return;
    window.__fireflyMusicFloat = true;

    var root = document.currentScript ? document.currentScript.previousElementSibling : null;

    function ready(fn) {
        if (document.readyState !== 'loading') fn();
        else document.addEventListener('DOMContentLoaded', fn);
    }

    ready(function () {
        var mini = document.querySelector('.fm-mini');
        var floatLrc = document.querySelector('.fm-float-lrc');
        if (!mini || !floatLrc) return;

        var els = {
            mini: mini,
            close: mini.querySelector('.fm-mini-close'),
            cover: mini.querySelector('.fm-mini-cover'),
            coverBtn: mini.querySelector('.fm-mini-cover-btn'),
            coverMask: mini.querySelector('.fm-mini-cover-mask'),
            iconPlay: mini.querySelector('.fm-mini-icon-play'),
            iconPause: mini.querySelector('.fm-mini-icon-pause'),
            iconPlayBig: mini.querySelector('.fm-mini-icon-play-big'),
            iconPauseBig: mini.querySelector('.fm-mini-icon-pause-big'),
            title: mini.querySelector('.fm-mini-title'),
            artist: mini.querySelector('.fm-mini-artist'),
            current: mini.querySelector('.fm-mini-current'),
            total: mini.querySelector('.fm-mini-total'),
            track: mini.querySelector('.fm-mini-track'),
            fill: mini.querySelector('.fm-mini-fill'),
            thumb: mini.querySelector('.fm-mini-thumb'),
            waveFlow: mini.querySelector('.fm-mini-waveflow'),
            wavePath: mini.querySelector('.fm-mini-wavepath'),
            clipRect: mini.querySelector('.fm-mini-clip'),
            btnMode: mini.querySelector('.fm-mini-mode'),
            iconRepeat: mini.querySelector('.fm-mini-icon-repeat'),
            iconRepeatOne: mini.querySelector('.fm-mini-icon-repeat-one'),
            iconShuffle: mini.querySelector('.fm-mini-icon-shuffle'),
            btnPrev: mini.querySelector('.fm-mini-prev'),
            btnPlay: mini.querySelector('.fm-mini-play'),
            btnNext: mini.querySelector('.fm-mini-next'),
            btnMute: mini.querySelector('.fm-mini-mute'),
            iconVolUp: mini.querySelector('.fm-mini-icon-vol-up'),
            iconVolOff: mini.querySelector('.fm-mini-icon-vol-off'),
            lrcText: floatLrc.querySelector('.fm-float-lrc-text')
        };

        // ── 开关状态（持久化）────────────────────────────────
        var uiState = {
            mini: localStorage.getItem('music-float-mini') === '1',
            lrc: localStorage.getItem('music-float-lrc') === '1'
        };
        var currentLyrics = [];
        var currentLrcIndex = -1;
        var isSeeking = false;

        function emitState() {
            window.dispatchEvent(new CustomEvent('fm:float-state', {
                detail: { mini: uiState.mini, lrc: uiState.lrc }
            }));
        }

        function applyMini() {
            if (uiState.mini) {
                els.mini.classList.remove('translate-y-6', 'scale-95', 'opacity-0', 'pointer-events-none');
            } else {
                els.mini.classList.add('translate-y-6', 'scale-95', 'opacity-0', 'pointer-events-none');
            }
            applyLrcPosition();
        }

        function applyLrcPosition() {
            // 悬浮播放器打开时，浮动歌词上移到播放器上方
            if (uiState.mini) {
                floatLrc.classList.remove('bottom-8');
                floatLrc.classList.add('bottom-[150px]');
            } else {
                floatLrc.classList.add('bottom-8');
                floatLrc.classList.remove('bottom-[150px]');
            }
        }

        // ── 浮动歌词逐字高亮（与歌词面板共用同一份逐字 IR）────
        /** 浮动歌词是否应可见 */
        function floatVisible() {
            return uiState.lrc
                && currentLyrics.length > 0
                && currentLrcIndex >= 0
                && !!currentLyrics[currentLrcIndex];
        }

        /** 重建当前行的逐字 span */
        function renderFloatLine() {
            var line = currentLyrics[currentLrcIndex];
            els.lrcText.textContent = '';
            if (!line) return;
            if (line.chars && line.chars.length) {
                line.chars.forEach(function (ch) {
                    var sp = document.createElement('span');
                    sp.className = 'fm-fch is-future';
                    sp.textContent = ch.text;
                    els.lrcText.appendChild(sp);
                });
            } else {
                els.lrcText.textContent = line.text;
            }
        }

        /** 按真实时间绘制逐字状态（与面板 paintLineChars 同一套规则） */
        function paintFloat(t) {
            var line = currentLyrics[currentLrcIndex];
            if (!line || !line.chars) return;
            var chars = line.chars;
            var spans = els.lrcText.children;

            // 二分查找当前正在演唱的字
            var cur = -1;
            var lo = 0;
            var hi = chars.length - 1;
            while (lo <= hi) {
                var mid = (lo + hi) >> 1;
                if (t >= chars[mid].time) {
                    cur = mid;
                    lo = mid + 1;
                } else {
                    hi = mid - 1;
                }
            }

            for (var k = 0; k < spans.length; k++) {
                var sp = spans[k];
                if (k < cur) {
                    sp.className = 'fm-fch is-done';
                } else if (k === cur) {
                    var ch = chars[k];
                    var p = ch.dur > 0 ? (t - ch.time) / ch.dur : 1;
                    p = Math.max(0, Math.min(1, p));
                    if (p >= 1) sp.className = 'fm-fch is-done';
                    else {
                        sp.className = 'fm-fch is-singing';
                        sp.style.setProperty('--cp', (p * 100).toFixed(1) + '%');
                    }
                } else {
                    sp.className = 'fm-fch is-future';
                }
            }
        }

        var floatRaf = 0;
        function floatTick() {
            var m = mgr || window.__fireflyMusic;
            if (m) paintFloat(m.getState().currentTime);
            floatRaf = requestAnimationFrame(floatTick);
        }
        /** 按可见性与播放状态启停逐字 RAF */
        function syncFloatRaf() {
            var m = mgr || window.__fireflyMusic;
            var playing = m ? m.getState().isPlaying : false;
            if (floatVisible() && playing && !floatRaf) {
                floatRaf = requestAnimationFrame(floatTick);
            } else if ((!floatVisible() || !playing) && floatRaf) {
                cancelAnimationFrame(floatRaf);
                floatRaf = 0;
            }
        }

        function refreshLrc() {
            var m = mgr || window.__fireflyMusic;
            if (floatVisible()) {
                renderFloatLine();
                floatLrc.classList.remove('opacity-0');
                if (m) paintFloat(m.getState().currentTime);
            } else {
                floatLrc.classList.add('opacity-0');
            }
            syncFloatRaf();
        }

        // ── 波浪路径（与卡片同款）──────────────────────────────
        (function buildWave() {
            var d = '';
            for (var x = -25; x < 125; x += 25) {
                d += ' M' + x + ',10 Q' + (x + 6.25) + ',4 ' + (x + 12.5) + ',10'
                    + ' Q' + (x + 18.75) + ',16 ' + (x + 25) + ',10';
            }
            els.wavePath.setAttribute('d', d);
        })();

        var mgr = window.__fireflyMusic;

        function setProgress(pct) {
            pct = Math.max(0, Math.min(100, pct));
            els.fill.style.width = pct + '%';
            els.thumb.style.left = pct + '%';
            els.clipRect.setAttribute('width', pct.toString());
            els.track.setAttribute('aria-valuenow', Math.round(pct).toString());
        }

        function refreshWave() {
            var playing = mgr ? mgr.getState().isPlaying : false;
            var active = isSeeking || playing;
            els.waveFlow.classList.toggle('is-active', active);
            els.fill.style.opacity = active ? '0' : '1';
        }

        function setPlayingUI(playing) {
            els.iconPlay.classList.toggle('hidden', playing);
            els.iconPause.classList.toggle('hidden', !playing);
            els.iconPlayBig.classList.toggle('hidden', playing);
            els.iconPauseBig.classList.toggle('hidden', !playing);
            els.coverMask.style.opacity = playing ? '0' : '1';
            els.cover.classList.toggle('fm-spin', playing);
            refreshWave();
        }

        function setModeUI(mode) {
            els.iconRepeat.classList.toggle('hidden', mode !== 0);
            els.iconRepeatOne.classList.toggle('hidden', mode !== 1);
            els.iconShuffle.classList.toggle('hidden', mode !== 2);
            els.btnMode.classList.toggle('text-(--primary)', mode !== 0);
            els.btnMode.classList.toggle('text-neutral-400', mode === 0);
        }

        function setTrackUI(track) {
            if (!track) return;
            els.title.textContent = track.name || '';
            els.title.title = track.name || '';
            els.artist.textContent = track.artist || '';
            if (track.pic) {
                els.cover.src = track.pic;
                els.cover.alt = (track.name || '封面') + ' - ' + (track.artist || '');
            } else {
                els.cover.removeAttribute('src');
            }
            setProgress(0);
        }

        // ── 控制 ─────────────────────────────────────────────
        function withMgr(fn) {
            return function () { if (mgr) fn(); };
        }
        els.close.addEventListener('click', function () {
            uiState.mini = false;
            localStorage.setItem('music-float-mini', '0');
            applyMini();
            emitState();
        });
        els.btnPlay.addEventListener('click', withMgr(function () { mgr.togglePlay(); }));
        els.coverBtn.addEventListener('click', withMgr(function () { mgr.togglePlay(); }));
        els.btnPrev.addEventListener('click', withMgr(function () { mgr.playPrev(); }));
        els.btnNext.addEventListener('click', withMgr(function () { mgr.playNext(); }));
        els.btnMode.addEventListener('click', withMgr(function () { mgr.cyclePlayMode(); }));
        els.btnMute.addEventListener('click', withMgr(function () { mgr.toggleMute(); }));

        // 拖拽 / 点击 seek
        function pctFromClientX(clientX) {
            var rect = els.track.getBoundingClientRect();
            return Math.max(0, Math.min(1, (clientX - rect.left) / rect.width)) * 100;
        }
        els.track.addEventListener('pointerdown', function (e) {
            if (!mgr) return;
            isSeeking = true;
            try { els.track.setPointerCapture(e.pointerId); } catch (_) {}
            var p = pctFromClientX(e.clientX);
            mgr.seek(p / 100);
            setProgress(p);
            refreshWave();
            // 浮动歌词逐字高亮实时跟随拖动
            if (floatVisible()) paintFloat(mgr.getState().currentTime);
        });
        els.track.addEventListener('pointermove', function (e) {
            if (!isSeeking || !mgr) return;
            var p = pctFromClientX(e.clientX);
            mgr.seek(p / 100);
            setProgress(p);
            if (floatVisible()) paintFloat(mgr.getState().currentTime);
        });
        ['pointerup', 'pointercancel', 'lostpointercapture'].forEach(function (evt) {
            els.track.addEventListener(evt, function () {
                if (!isSeeking) return;
                isSeeking = false;
                refreshWave();
            });
        });

        // ── 接收卡片按钮的开关事件 ─────────────────────────────
        window.addEventListener('fm:float-toggle', function (e) {
            var target = e.detail && e.detail.target;
            if (target === 'mini') {
                uiState.mini = !uiState.mini;
                localStorage.setItem('music-float-mini', uiState.mini ? '1' : '0');
                applyMini();
                emitState();
            } else if (target === 'lrc') {
                uiState.lrc = !uiState.lrc;
                localStorage.setItem('music-float-lrc', uiState.lrc ? '1' : '0');
                refreshLrc();
                emitState();
            }
        });

        // ── 订阅播放引擎事件 ─────────────────────────────────
        window.addEventListener('fm:init', function () {
            mgr = window.__fireflyMusic;
            emitState();
            var s = mgr.getState();
            setModeUI(s.playMode);
            if (s.track) setTrackUI(s.track);
            setPlayingUI(s.isPlaying);
        });
        window.addEventListener('fm:track', function (e) {
            setTrackUI(e.detail.track);
            currentLyrics = [];
            currentLrcIndex = -1;
            refreshLrc();
        });
        window.addEventListener('fm:play-state', function (e) {
            setPlayingUI(e.detail.isPlaying);
            syncFloatRaf();
            // 暂停瞬间定格在当前演唱位置
            if (!e.detail.isPlaying && mgr && floatVisible()) {
                paintFloat(mgr.getState().currentTime);
            }
        });
        window.addEventListener('fm:time', function (e) {
            var d = e.detail;
            if (!isSeeking) setProgress(d.progress);
            els.current.textContent = d.currentTimeStr;
            els.total.textContent = d.durationStr;
            // 暂停态（含拖动结束后的 timeupdate）也要保持逐字位置正确
            if (mgr && floatVisible() && !mgr.getState().isPlaying) {
                paintFloat(d.currentTime);
            }
        });
        window.addEventListener('fm:mode', function (e) {
            setModeUI(e.detail.playMode);
        });
        window.addEventListener('fm:volume', function (e) {
            var muted = e.detail.isMuted || e.detail.volume === 0;
            els.iconVolUp.classList.toggle('hidden', muted);
            els.iconVolOff.classList.toggle('hidden', !muted);
        });
        window.addEventListener('fm:lyrics', function (e) {
            currentLyrics = (e.detail && e.detail.lyrics) || [];
            currentLrcIndex = -1;
            refreshLrc();
        });
        window.addEventListener('fm:lrc-index', function (e) {
            currentLrcIndex = e.detail.index;
            refreshLrc();
        });

        // ── 初始化：同步已有状态 ─────────────────────────────
        applyMini();
        applyLrcPosition();
        emitState();
        if (mgr && mgr.getState().initialized) {
            var s0 = mgr.getState();
            setModeUI(s0.playMode);
            if (s0.track) setTrackUI(s0.track);
            setPlayingUI(s0.isPlaying);
            currentLyrics = s0.lyrics || [];
            currentLrcIndex = s0.currentLrcIndex;
            if (s0.duration > 0) {
                setProgress(s0.progress);
                els.current.textContent = s0.currentTimeStr;
                els.total.textContent = s0.durationStr;
            }
            refreshLrc();
        }
        // 卡片按钮可能晚于本组件挂载，初始化/首帧后再广播一次
        setTimeout(emitState, 300);
        setTimeout(emitState, 1500);
    });
})();
</script>

<!-- 浮动歌词逐字 span（.fm-fch）由 JS 动态创建，不带 Astro 作用域样式的 data-astro-cid 属性，
     作用域样式无法命中，故必须用 is:global（类名均为 fm- 专用前缀，无冲突）。 -->
<style is:global>
    .fm-float-lrc-text {
		font-family: "STKaiti", "KaiTi", "Kaiti SC", "Yu Mincho", "Yu Gothic", serif;
		text-shadow:
			0 1px 12px rgba(255, 255, 255, 0.9),
			0 0 4px rgba(255, 255, 255, 0.7);
	}
	:global(.dark) .fm-float-lrc-text {
		text-shadow:
			0 1px 12px rgba(0, 0, 0, 0.9),
			0 0 4px rgba(0, 0, 0, 0.7);
	}

	/* ── 浮动歌词逐字三态 ─────────────────────────────── */
	.fm-fch.is-future {
		color: inherit; /* 未演唱：沿用浮动歌词原本的中性色 */
	}
	.fm-fch.is-done {
		color: var(--lrc-past, #3b82f6);
	}
	/* 正在演唱的字：高亮色随 --cp 向右填充，未唱部分为灰色 */
	.fm-fch.is-singing {
		color: transparent;
		background-image: linear-gradient(
			90deg,
			var(--lrc-current, #38bdf8) 0 var(--cp, 0%),
			var(--lrc-future, #94a3b8) var(--cp, 0%) 100%
		);
		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

    .fm-mini-waveflow {
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	.fm-mini-waveflow.is-active {
		opacity: 1;
	}
	.fm-mini-waveflow .fm-mini-wavepath {
		transform-box: view-box;
	}
	.fm-mini-waveflow.is-active .fm-mini-wavepath {
		animation: fm-mini-wave-flow 1.3s linear infinite;
	}
	@keyframes fm-mini-wave-flow {
