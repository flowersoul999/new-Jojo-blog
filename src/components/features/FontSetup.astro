---
import { Font } from "astro:assets";
import { fontConfig } from "@/config";
import { collectUsedFontCssVars } from "@/utils/fontHelper";
import "lxgw-wenkai-screen-webfont/lxgwwenkaiscreen.css";

const allCssVars = fontConfig.enable
	? collectUsedFontCssVars(fontConfig)
	: new Set<string>();

const selectedIds: string[] =
	fontConfig.enable && fontConfig.selected
		? Array.isArray(fontConfig.selected)
			? fontConfig.selected
			: [fontConfig.selected]
		: [];

const SYSTEM_FONT_STACK =
	"system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif";
const WENKAI_FONT_STACK =
	'"LXGW WenKai Screen", -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", "Microsoft YaHei", "PingFang SC", "Hiragino Sans GB", sans-serif';

const selectedFontVars = selectedIds.filter((v) => v !== "system");
const bodyFontFamily =
	selectedFontVars.length > 0
		? [...selectedFontVars.map((v) => `var(${v})`), SYSTEM_FONT_STACK].join(
				", ",
			)
		: SYSTEM_FONT_STACK;
---

{Array.from(allCssVars).map((cssVar) => (
	<Font cssVariable={cssVar as any} preload={selectedFontVars.includes(cssVar)} />
))}

{fontConfig.enable && (
	<style
		set:html={`
		:root {
			--font-lxgw-wenkai: ${WENKAI_FONT_STACK};
			--font-blog-original: ${bodyFontFamily};
			--font-active-sans: var(--font-lxgw-wenkai);
			--font-banner-title: var(--font-lxgw-wenkai);
			--font-banner-subtitle: var(--font-lxgw-wenkai);
			--font-navbar-title: var(--font-lxgw-wenkai);
			--font-sans: var(--font-lxgw-wenkai);
		}

		body,
		button,
		input,
		textarea,
		select {
			font-family: var(--font-active-sans);
		}
	`}
	/>
)}

<script>
	if (document.fonts && typeof document.fonts.ready !== "undefined") {
		document.fonts.ready
			.then(() => {
				document.dispatchEvent(new CustomEvent("fontsLoaded"));
			})
			.catch((error) => {
				console.warn("Font loading failed:", error);
			});
	}
</script>
