---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

export interface Props {
	playerUrl: string | string[];
	playerMode?: "order" | "random";
	/**
	 * 保存「已选中的动态壁纸索引」的 localStorage 键（来自 setting-utils）。
	 * 本组件是 is:inline 脚本、无法 import，所以靠这个 prop 透传键名。
	 */
	dynamicStorageKey?: string;
}

const {
	playerUrl,
	playerMode = "order",
	dynamicStorageKey = "selectedDynamicWallpaper",
} = Astro.props;

const urls = Array.isArray(playerUrl) ? playerUrl : [playerUrl];
const hasMultiple = urls.length > 1;
const urlsJson = JSON.stringify(urls);

const tPrev = i18n(I18nKey.videoPrev);
const tNext = i18n(I18nKey.videoNext);
const tLoadError = i18n(I18nKey.videoLoadError);
---

{
	urls.length > 0 && (
		<div id="bg-player">
			<div
				id="bg-player-overlay"
				class="absolute inset-0 z-15 overflow-hidden pointer-events-none transition-opacity duration-500 ease-in-out opacity-0"
			>
				<!--
					preload="metadata"：页面加载就把 moov（文件头索引）拉回来，点播放时不必再握手取索引。
					两支视频都是 faststart（moov 在文件最前面），metadata 只占一两百 KB，不会常驻占带宽。
					x5-* / webkit-playsinline：微信、QQ、UC 等腾讯 X5 内核默认会把 video 接管成原生全屏播放器，
					页面被盖住就无法上下滑动 —— 这组属性强制它走 H5 页内播放。
				-->
				<video
					id="bg-player-video"
					preload="metadata"
					playsinline
					webkit-playsinline="true"
					x5-playsinline="true"
					x5-video-player-type="h5-page"
					x5-video-player-fullscreen="false"
					class="size-full object-cover"
				></video>
			</div>

			<div id="bg-player-controls" class="absolute bottom-4 left-4 z-30 flex items-center gap-1.5 group">
				{hasMultiple && (
					<button
						id="bg-prev-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:!opacity-80 hover:!scale-100"
						title={tPrev}
						aria-label={tPrev}
					>
						<Icon is:inline name="material-symbols:skip-previous-rounded" class="text-[1rem]" />
					</button>
				)}

				{hasMultiple && (
					<button
						id="bg-next-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:!opacity-80 hover:!scale-100"
						title={tNext}
						aria-label={tNext}
					>
						<Icon is:inline name="material-symbols:skip-next-rounded" class="text-[1rem]" />
					</button>
				)}
			</div>

			<div
				id="bg-player-toast"
				class="fixed bottom-20 left-1/2 -translate-x-1/2 z-100 px-4 py-2 rounded-lg bg-black/70 text-white text-sm backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"
			>
				{tLoadError}
			</div>
		</div>
	)
}

<script is:inline define:vars={{ urls: urlsJson, playerMode, hasMultiple, dynamicStorageKey }}>
	(() => {
		var urlList = JSON.parse(urls);
		if (!urlList.length) return;
		var isMultiple = urlList.length > 1;

		var overlay = document.getElementById("bg-player-overlay");
		var video = document.getElementById("bg-player-video");
		var prevBtn = document.getElementById("bg-prev-btn");
		var nextBtn = document.getElementById("bg-next-btn");
		var toast = document.getElementById("bg-player-toast");

		if (!video) return;

		// 防止 is:inline 脚本重复注册监听器（Swup 导航会重新执行脚本）
		if (video.getAttribute("data-player-init")) return;
		video.setAttribute("data-player-init", "true");

		var isPlaying = false;
		var currentIndex = 0;
		var errorCount = 0;
		var toastTimer = null;
		// 被显示设置面板选中的「动态壁纸」索引。非 null 时循环固定这一支、不随机切换，
		// 语义上等同「我已经把它设成壁纸了」。
		var pinnedIndex = null;
		// 本次起播是否静音。面板选中 = 设为壁纸 → 静音起播（也是自动播放策略下唯一稳的方式）；
		// 用户点导航栏播放按钮则带声音。
		var startMuted = false;

		// 「点播放就卡一下」的根因是 `preload="none"`：连 moov 都要等到点击那一刻才拉，
		// 起播必须重走一次握手 + 索引下载。这里分两步把这段等待挪到点击之前：
		//   1) 页面加载就把当前支挂到 video 上 —— preload="metadata" 只会拉 moov（两支都 faststart，一两百 KB）；
		//   2) 浏览器空闲时用 Range 把开头一小段拉进 HTTP 缓存 —— 点击时首帧数据已经在本地。
		// 没有被设为壁纸时也只是这一两百 KB + 1.5MB 的一次性预取，不会持续占带宽。
		var PREFETCH_BYTES = 1572864;
		var prefetched = {};

		function networkAllowsPrefetch() {
			var conn = navigator.connection;
			if (!conn) return true;
			if (conn.saveData) return false;
			var type = conn.effectiveType;
			return type !== "slow-2g" && type !== "2g";
		}

		function prefetchTrack(index) {
			var target = urlList[index];
			if (!target || prefetched[target]) return;
			if (!networkAllowsPrefetch()) return;
			prefetched[target] = true;
			try {
				// Range 只取开头一段；把 body 读掉是为了让这段响应真正写进 HTTP 缓存而不是被丢弃。
				fetch(target, { headers: { Range: "bytes=0-" + (PREFETCH_BYTES - 1) } })
					.then(function (res) {
						return res.arrayBuffer();
					})
					.catch(function () {
						// 预取失败不影响播放，静默降级即可
					});
			} catch (e) {
				// 老浏览器没有 fetch：靠上面的 preload="metadata" 兜底
			}
		}

		function schedulePrefetch(index) {
			if (typeof window.requestIdleCallback === "function") {
				window.requestIdleCallback(
					function () {
						prefetchTrack(index);
					},
					{ timeout: 3000 },
				);
			} else {
				setTimeout(function () {
					prefetchTrack(index);
				}, 2000);
			}
		}

		function showToast() {
			if (!toast) return;
			toast.classList.remove("opacity-0");
			toast.classList.add("opacity-100");
			if (toastTimer) clearTimeout(toastTimer);
			toastTimer = setTimeout(function () {
				toast.classList.remove("opacity-100");
				toast.classList.add("opacity-0");
			}, 3000);
		}

		function pickIndex(except) {
			if (urlList.length <= 1) return 0;
			if (playerMode === "random") {
				var n;
				do { n = Math.floor(Math.random() * urlList.length); } while (n === except);
				return n;
			}
			return (except + 1) % urlList.length;
		}

		function prevIndex() {
			if (urlList.length <= 1) return 0;
			if (playerMode === "random") return pickIndex(currentIndex);
			return (currentIndex - 1 + urlList.length) % urlList.length;
		}

		function syncAttr() {
			document.body.toggleAttribute("data-bg-video-playing", isPlaying);
			document.documentElement.toggleAttribute("data-bg-video-playing", isPlaying);
			window.dispatchEvent(new CustomEvent("bg-player-state-change", { detail: { playing: isPlaying } }));
		}

		// 确保 video 的 src 指向当前索引的视频；未设置或已切换时才赋值。
		// 页面初始化时通常已经挂好 src（见下方 schedulePrefetch 那段），所以这里绝大多数情况下是空操作。
		function ensureSrc() {
			var cur = video.getAttribute("src");
			if (!cur || cur.indexOf(urlList[currentIndex]) === -1) {
				video.src = urlList[currentIndex];
			}
		}

		function hideOverlay() {
			if (overlay) {
				overlay.classList.remove("opacity-100");
				overlay.classList.add("opacity-0");
			}
		}

		function doPlay(forceMuted) {
			ensureSrc();
			if (forceMuted) {
				// 自动起播（壁纸语义）：只能静音，否则会被浏览器自动播放策略拦掉。
				video.muted = true;
				video.play().catch(function () { isPlaying = false; syncAttr(); });
				return;
			}
			// 播放按钮点击本身属于用户手势，直接带声音播放，避免"先静音再解除"在部分浏览器下失效导致无声
			// 若被浏览器自动播放策略拦截（play 返回 NotAllowedError），则回退为静音播放保证画面可用
			video.muted = false;
			video.play().catch(function () {
				video.muted = true;
				video.play().catch(function () { isPlaying = false; syncAttr(); });
			});
		}

		function switchTrack(index) {
			if (index < 0 || index >= urlList.length) return;
			currentIndex = index;
			if (isPlaying) {
				doPlay(startMuted);
			} else {
				video.src = urlList[currentIndex];
				video.load();
			}
		}

		// 「把第 index 支设为壁纸」：钉住索引 + 静音起播 + 点亮遮罩。
		// 面板点选和刷新后恢复都走这里，保证两条路径行为一致。
		function applyDynamicWallpaper(index) {
			if (typeof index !== "number" || index < 0 || index >= urlList.length) return;
			pinnedIndex = index;
			currentIndex = index;
			startMuted = true;
			isPlaying = true;
			if (overlay) {
				overlay.classList.remove("opacity-0");
				overlay.classList.add("opacity-100");
			}
			syncAttr();
			doPlay(true);
		}

		function clearDynamicWallpaper() {
			pinnedIndex = null;
			startMuted = false;
			if (!isPlaying) return;
			isPlaying = false;
			video.pause();
			hideOverlay();
			syncAttr();
		}

		function readStoredDynamicIndex() {
			try {
				var raw = window.localStorage.getItem(dynamicStorageKey);
				if (raw === null) return null;
				var parsed = parseInt(raw, 10);
				if (isNaN(parsed) || parsed < 0 || parsed >= urlList.length) return null;
				return parsed;
			} catch (e) {
				// 隐私模式下 localStorage 可能直接抛错，静默降级为「没有动态壁纸」。
				return null;
			}
		}

		function toggle() {
			isPlaying = !isPlaying;
		if (isPlaying) {
			if (currentIndex >= urlList.length) currentIndex = 0;
			// 手动点播放：随机挑一支（避开当前这支），贴合 playerMode="random" 的语义；
			// 被显示设置面板钉成动态壁纸时不打乱，继续播那一支。
			if (pinnedIndex === null && playerMode === "random" && urlList.length > 1) {
				currentIndex = pickIndex(currentIndex);
			}
			// 手动播放：用户是主动点的，带声音来。
			startMuted = false;
				syncAttr();
				if (overlay) { overlay.classList.remove("opacity-0"); overlay.classList.add("opacity-100"); }
				doPlay(false);
			} else {
				video.pause();
				hideOverlay();
				syncAttr();
			}
		}

		function onEnded() {
			// 被选为动态壁纸时循环同一支 —— 壁纸不该自己换片。
			if (pinnedIndex !== null) {
				currentIndex = pinnedIndex;
				doPlay(true);
				return;
			}
			if (isMultiple) {
				currentIndex = pickIndex(currentIndex);
				doPlay(startMuted);
			} else {
				isPlaying = false;
				hideOverlay();
				syncAttr();
			}
		}

		function onError() {
			errorCount++;
			if (isMultiple && errorCount < urlList.length) {
				// 多视频模式下自动尝试下一个
				currentIndex = pickIndex(currentIndex);
				video.src = urlList[currentIndex];
				video.load();
			} else {
				// 所有视频都失败或只有单个视频
				isPlaying = false;
				hideOverlay();
				syncAttr();
				showToast();
			}
		}

		// 监听导航栏播放按钮事件
		window.addEventListener("bg-player-toggle", toggle);
		video.addEventListener("ended", onEnded);
		video.addEventListener("error", onError);
		// 页面加载就把目标支挂到 video 上：preload="metadata" 只拉 moov，
		// 不会像 preload="auto" 那样一路把 42MB 整片拖下来；真正的画面数据仍要等点击 play() 才开始下载。
		var initialStoredIndex = readStoredDynamicIndex();
		if (initialStoredIndex !== null) currentIndex = initialStoredIndex;
		video.src = urlList[currentIndex];
		video.load();
		schedulePrefetch(currentIndex);

		// 播放成功时重置错误计数，并顺手把下一支的首段也拉下来（轮播切过去时不会再卡一次）
		video.addEventListener("playing", function () {
			errorCount = 0;
			schedulePrefetch(pickIndex(currentIndex));
		});
		if (prevBtn) prevBtn.addEventListener("click", function () { switchTrack(prevIndex()); });
		if (nextBtn) nextBtn.addEventListener("click", function () { switchTrack(pickIndex(currentIndex)); });

		// 显示设置面板里选中/取消动态壁纸（setting-utils 派发）。
		window.addEventListener("dynamicWallpaperChange", function (event) {
			var detail = event && event.detail;
			if (!detail || detail.index === null || detail.index === undefined) {
				clearDynamicWallpaper();
				return;
			}
			applyDynamicWallpaper(detail.index);
		});

		// 刷新后沿用已存的动态壁纸（不依赖上面那个事件是否早于本脚本绑定）。
		var storedDynamicIndex = readStoredDynamicIndex();
		if (storedDynamicIndex !== null) applyDynamicWallpaper(storedDynamicIndex);

		// 切换壁纸模式时停止播放
		window.addEventListener("wallpaperModeChange", function (e) {
			if (e.detail && e.detail.mode === "none" && isPlaying) {
				isPlaying = false;
				video.pause();
				hideOverlay();
				syncAttr();
			}
		});

		// 标签页切到后台时暂停视频解码（减少 GPU/带宽占用），回到前台若原本在播放则恢复
		var pausedByVisibility = false;
		document.addEventListener("visibilitychange", function () {
			if (document.hidden) {
				pausedByVisibility = isPlaying;
				if (isPlaying) {
					isPlaying = false;
					video.pause();
					hideOverlay();
					syncAttr();
				}
			} else if (pausedByVisibility) {
				pausedByVisibility = false;
				isPlaying = true;
				if (overlay) { overlay.classList.remove("opacity-0"); overlay.classList.add("opacity-100"); }
				syncAttr();
				// 恢复时沿用原来的静音状态：动态壁纸保持静音，手动播放的继续带声音。
				doPlay(startMuted);
			}
		});

		// 动态控制 prev/next 按钮显示
		if (!isMultiple) {
			if (prevBtn) prevBtn.style.display = "none";
			if (nextBtn) nextBtn.style.display = "none";
		}

		function cleanup() {
			// 视频仍在播放时保留属性，供 Navbar 同步按钮状态
			if (!isPlaying) {
				document.body.removeAttribute("data-bg-video-playing");
				document.documentElement.removeAttribute("data-bg-video-playing");
			}
		}
		document.addEventListener("astro:before-swap", cleanup);
	})();
</script>

<style>
	:global([data-bg-video-playing] #banner-images-container),
	:global([data-bg-video-playing] #banner-dim-container),
	:global([data-bg-video-playing] #banner-overlay-container),
	:global([data-bg-video-playing] #header-waves),
	:global([data-bg-video-playing] #wallpaper-gradient) {
		opacity: 0 !important;
		transition: opacity 0.5s ease;
	}

	/* 手机竖屏（≤767px）：片源是横着拍的 16:9，竖着放只能压成窄窄一条。
	   所以这里把 video 顺时针旋转 90° —— 旋转前的「宽」取遮罩的「高」、旋转前的「高」取遮罩的「宽」，
	   旋转后画面横过来正好铺满屏幕，上下不留黑边；页面仍是普通文档流，上下滑动不受影响。
	   尺寸先用 vh/vw 兜底，再用容器查询单位取遮罩的真实宽高（避开移动端 100vh 与可视视口的误差）。*/
	@media (max-width: 767px) and (orientation: portrait) {
		:global(#bg-player-overlay) {
			container-type: size;
		}

		:global(#bg-player-video) {
			position: absolute;
			top: 50%;
			left: 50%;
			width: 100vh;
			height: 100vw;
			width: 100cqh;
			height: 100cqw;
			max-width: none;
			object-fit: cover;
			transform: translate(-50%, -50%) rotate(90deg);
			transform-origin: center center;
		}
	}
</style>
