---
// Golden Experience · 高光时刻：每件事按「问题 → 方案 → 结果」三段式拆开
import { Icon } from "astro-icon/components";
import type { InternshipHighlight } from "@/data/internship";

interface Props {
	highlights: InternshipHighlight[];
}

const { highlights } = Astro.props;

const STEPS = [
	{ key: "problem", label: "问题", icon: "material-symbols:error-outline" },
	{ key: "solution", label: "方案", icon: "material-symbols:build-outline" },
	{ key: "result", label: "结果", icon: "material-symbols:check" },
] as const;
---

<section id="highlights" class="gi-section" data-gi-anchor>
	<header class="gi-section__head">
		<span class="gi-section__icon" aria-hidden="true">
			<Icon is:inline name="material-symbols:local-fire-department-rounded" class="text-[1.35rem]" />
		</span>
		<div>
			<h2 class="gi-section__title">高光时刻</h2>
			<p class="gi-section__desc">
				挑了两件我自己印象最深的事。按「问题 → 方案 → 结果」写，因为面试的时候大概也是这么被问的。
			</p>
		</div>
	</header>

	<div class="gi-highlights">
		{
			highlights.map((item) => (
				<article class="gi-highlight" data-gi-reveal>
					<h3 class="gi-highlight__title">{item.title}</h3>

					<div class="gi-steps">
						{STEPS.map((step) => (
							<div class="gi-step" data-step={step.key}>
								<div class="gi-step__label">
									<Icon is:inline name={step.icon} class="text-[0.95rem]" />
									<span>{step.label}</span>
								</div>
								<p class="gi-step__text">{item[step.key]}</p>
							</div>
						))}
					</div>

					{item.tags.length > 0 && (
						<ul class="gi-highlight__tags">
							{item.tags.map((tag) => (
								<li class="gi-highlight__tag">{tag}</li>
							))}
						</ul>
					)}
				</article>
			))
		}
	</div>
</section>

<style>
	.gi-section {
		margin-top: 2.6rem;
		scroll-margin-top: 10rem;
	}
	.gi-section__head {
		display: flex;
		align-items: flex-start;
		gap: 0.8rem;
		margin-bottom: 1.3rem;
	}
	.gi-section__icon {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.3rem;
		height: 2.3rem;
		border-radius: 13px;
		background: var(--gi-soft);
		color: var(--gi-accent);
	}
	.gi-section__title {
		margin: 0;
		font-size: 1.22rem;
		font-weight: 800;
		color: var(--gi-title);
	}
	.gi-section__desc {
		margin: 0.3rem 0 0;
		font-size: 0.82rem;
		line-height: 1.7;
		color: var(--gi-muted);
	}

	.gi-highlights {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.gi-highlight {
		min-width: 0;
		padding: 1.15rem 1.2rem 1.25rem;
		border-radius: 18px;
		border: 1px solid var(--gi-line);
		background: var(--gi-surface);
		transition:
			border-color 220ms ease,
			box-shadow 220ms ease;
	}
	.gi-highlight:hover {
		border-color: color-mix(in srgb, var(--gi-accent) 40%, transparent);
		box-shadow: 0 14px 34px rgb(0 0 0 / 0.08);
	}
	.gi-highlight__title {
		margin: 0 0 1rem;
		font-size: 1.02rem;
		font-weight: 800;
		color: var(--gi-title);
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}
	.gi-highlight__title::before {
		content: "";
		flex: none;
		width: 0.32rem;
		height: 1.05rem;
		border-radius: 999px;
		background: var(--gi-accent);
	}

	.gi-steps {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.85rem;
	}
	.gi-step {
		position: relative;
		min-width: 0;
		padding: 0.8rem 0.9rem 0.85rem;
		border-radius: 14px;
		background: var(--gi-sunken);
		border: 1px solid var(--gi-line);
	}
	.gi-step__label {
		display: flex;
		align-items: center;
		gap: 0.32rem;
		margin-bottom: 0.42rem;
		font-size: 0.76rem;
		font-weight: 700;
		color: var(--gi-accent);
	}
	.gi-step__text {
		margin: 0;
		font-size: 0.83rem;
		line-height: 1.8;
		color: var(--gi-body);
		word-break: break-word;
	}

	.gi-highlight__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.9rem 0 0;
		padding: 0;
		list-style: none;
	}
	.gi-highlight__tag {
		padding: 0.16rem 0.6rem;
		border-radius: 999px;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--gi-muted);
		background: var(--gi-surface);
		border: 1px solid var(--gi-line);
	}

	@media (min-width: 780px) {
		.gi-steps {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.7rem;
			align-items: stretch;
		}
		/* 三步之间的箭头：纯装饰，移动端自动隐藏 */
		.gi-step:not([data-step="result"])::after {
			content: "";
			position: absolute;
			right: -0.62rem;
			top: 50%;
			width: 0.42rem;
			height: 0.42rem;
			border-top: 2px solid color-mix(in srgb, var(--gi-accent) 45%, transparent);
			border-right: 2px solid color-mix(in srgb, var(--gi-accent) 45%, transparent);
			transform: translateY(-50%) rotate(45deg);
		}
	}
</style>
