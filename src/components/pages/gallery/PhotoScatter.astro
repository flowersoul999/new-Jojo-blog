---
/**
 * 全屏散落照片墙（拍立得模式，相册页本体）
 *
 * 进入相册页即直接展开，无需点击任何东西：
 * - 照片以拍立得白框随机散落在页面上（站点自身背景，无黑色遮罩）
 * - 每张照片可自由拖动，拖动后的位置按 相册+图片 维度持久化到 localStorage
 * - 单击照片放大居中，旁边出现彩色便签，显示标签 / 日期 / 描述
 * - 再次单击照片或 ESC 还原；再按 ESC 或点击右上角返回按钮回到相册列表
 *
 * 页面数据：相册页在模板中埋 <script type="application/json" data-scatter-data>，
 * 加密相册解密后通过 password:decrypted 事件启动。
 */
---

<style is:global>
  .ps-overlay {
    position: fixed;
    inset: 0;
    z-index: 1300;
    display: none;
  }

  .ps-overlay.ps-open {
    display: block;
  }

  .ps-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .ps-hint {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: rgba(0, 0, 0, 0.62);
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    pointer-events: none;
    white-space: nowrap;
    animation: ps-fade 0.5s ease 0.2s both;
  }

  :root[data-theme="dark"] .ps-hint {
    color: rgba(255, 255, 255, 0.9);
    background: rgba(30, 30, 36, 0.6);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .ps-back {
    position: absolute;
    top: 14px;
    right: 20px;
    height: 42px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    gap: 6px;
    border-radius: 999px;
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.72);
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
    animation: ps-fade 0.5s ease 0.25s both;
  }

  :root[data-theme="dark"] .ps-back {
    color: rgba(255, 255, 255, 0.92);
    background: rgba(30, 30, 36, 0.6);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .ps-back:hover {
    transform: scale(1.05);
  }

  .ps-card {
    position: fixed;
    left: 50%;
    top: 50%;
    width: var(--w, 200px);
    height: var(--h, 200px);
    transform:
      translate(calc(-50% + var(--ox, 0px)), calc(-50% + var(--oy, 0px)))
      rotate(var(--rot, 0deg));
    transition:
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.38s cubic-bezier(0.22, 1, 0.36, 1);
    touch-action: none;
    cursor: grab;
    will-change: transform;
    user-select: none;
  }

  .ps-card.is-dragging {
    transition: none;
    cursor: grabbing;
  }

  .ps-card.is-zoomed {
    transform: translate(-50%, -50%) rotate(0deg);
    z-index: 1400 !important;
  }

  .ps-frame {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 8px 8px 0;
    background: #fff;
    box-shadow:
      0 14px 42px rgba(0, 0, 0, 0.26),
      0 2px 10px rgba(0, 0, 0, 0.14);
    animation: ps-pop 0.5s cubic-bezier(0.22, 1.2, 0.36, 1) both;
  }

  .ps-card:not(.is-zoomed):hover .ps-frame {
    box-shadow:
      0 18px 52px rgba(0, 0, 0, 0.32),
      0 2px 10px rgba(0, 0, 0, 0.16);
  }

  .ps-frame img {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
    user-select: none;
    background: #e9e9ee;
  }

  .ps-strip {
    flex: 0 0 26px;
    background: #fff;
  }

  .ps-note {
    position: absolute;
    z-index: 1401;
    width: 224px;
    min-height: 120px;
    padding: 16px 18px;
    color: #3a3530;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.22);
    display: none;
  }

  .ps-note.is-visible {
    display: block;
    animation: ps-note-in 0.4s cubic-bezier(0.22, 1.3, 0.36, 1) both;
  }

  @media (min-width: 768px) {
    .ps-note {
      right: 5%;
      top: 50%;
    }
  }

  @media (max-width: 767.98px) {
    .ps-note {
      left: 14px;
      right: 14px;
      width: auto;
      bottom: 34px;
    }
  }

  .ps-note-date {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: rgba(58, 53, 48, 0.62);
    margin-bottom: 8px;
  }

  .ps-note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }

  .ps-note-tag {
    font-size: 0.72rem;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.12);
    color: rgba(58, 53, 48, 0.85);
  }

  .ps-note-desc {
    font-size: 0.9rem;
    line-height: 1.65;
    word-break: break-word;
  }

  @keyframes ps-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes ps-pop {
    from {
      opacity: 0;
      transform: scale(0.55) rotate(-4deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }

  @keyframes ps-note-in {
    from {
      opacity: 0;
      transform: scale(0.5) rotate(-3deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0);
    }
  }
</style>

<script>
  (() => {
    const w = window as Window & { __photoScatterBound?: boolean };
    if (w.__photoScatterBound) return;
    w.__photoScatterBound = true;

    const NOTE_COLORS = ["#fff3b0", "#ffd6e0", "#cdeffd", "#d8f3dc", "#f3d9fa", "#ffe5c2"];

    type PhotoMeta = {
      src: string;
      description: string;
      date: string;
      tags: string[];
    };

    type ScatterPayload = {
      album: string;
      name?: string;
      backHref?: string;
      date?: string;
      tags?: string[];
      photos: PhotoMeta[];
    };

    type Card = {
      el: HTMLElement;
      img: HTMLImageElement;
      meta: PhotoMeta;
      x: number;
      y: number;
      rot: number;
      baseW: number;
      baseH: number;
      noteColor: string;
    };

    type DragState = {
      card: Card;
      pointerId: number;
      startX: number;
      startY: number;
      origX: number;
      origY: number;
      moved: boolean;
      downAt: number;
    };

    let overlay: HTMLElement | null = null;
    let stage: HTMLElement | null = null;
    let noteEl: HTMLElement | null = null;
    let payload: ScatterPayload | null = null;
    let zoomed: Card | null = null;
    let zTop = 20;
    let drag: DragState | null = null;

    function ensureOverlay() {
      if (overlay) return;
      overlay = document.createElement("div");
      overlay.className = "ps-overlay";
      overlay.setAttribute("aria-hidden", "true");
      overlay.innerHTML = `
        <div class="ps-stage"></div>
        <div class="ps-hint">拖动照片重新摆放 · 单击查看标签与描述 · ESC 返回相册</div>
        <button type="button" class="ps-back" aria-label="返回相册列表">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          返回相册
        </button>
        <div class="ps-note"></div>
      `;
      document.body.appendChild(overlay);
      stage = overlay.querySelector(".ps-stage");
      noteEl = overlay.querySelector(".ps-note");

      overlay.querySelector(".ps-back")?.addEventListener("click", goBack);
    }

    function goBack() {
      if (payload?.backHref) {
        window.location.href = payload.backHref;
      } else {
        window.history.back();
      }
    }

    function hashStr(s: string): number {
      let hash = 0;
      for (let i = 0; i < s.length; i++) {
        hash = (hash << 5) - hash + s.charCodeAt(i);
        hash &= hash;
      }
      return Math.abs(hash);
    }

    /** 基于图片地址生成稳定的黄金角螺旋落点 + 随机感旋转 */
    function stablePosition(uniqueId: string, vw: number, vh: number, baseW: number) {
      const seed = hashStr(uniqueId) % 10000;
      const maxRadius = Math.max(60, Math.min(vw, vh) / 2 - baseW * 1.05);
      const goldenAngle = Math.PI * (3 - Math.sqrt(5));
      const t = (seed % 1000) / 1000;
      const radius = Math.pow(t, 0.78) * maxRadius;
      const angle = seed * goldenAngle;
      const x = radius * Math.cos(angle);
      const y = radius * Math.sin(angle) * 0.82;
      const rot = ((seed * 13) % 36) - 18;
      return { x, y, rot };
    }

    function offsetKey(albumId: string, src: string) {
      return `photo-scatter-offset:${albumId}:${src}`;
    }

    function loadOffset(albumId: string, src: string): { x: number; y: number } {
      try {
        const raw = localStorage.getItem(offsetKey(albumId, src));
        if (raw) {
          const parsed = JSON.parse(raw);
          return { x: Number(parsed.x) || 0, y: Number(parsed.y) || 0 };
        }
      } catch {
        /* ignore */
      }
      return { x: 0, y: 0 };
    }

    function saveOffset(albumId: string, src: string, x: number, y: number) {
      try {
        localStorage.setItem(offsetKey(albumId, src), JSON.stringify({ x, y }));
      } catch {
        /* ignore */
      }
    }

    function applyTransform(card: Card) {
      card.el.style.setProperty("--ox", `${card.x}px`);
      card.el.style.setProperty("--oy", `${card.y}px`);
      card.el.style.setProperty("--rot", `${card.rot}deg`);
    }

    function bringToFront(card: Card) {
      zTop += 1;
      card.el.style.zIndex = String(zTop);
    }

    function albumTags(): string[] {
      return Array.isArray(payload?.tags) ? payload!.tags.map(String) : [];
    }

    function unzoom() {
      if (!zoomed) return;
      const card = zoomed;
      zoomed = null;
      card.el.classList.remove("is-zoomed");
      card.el.style.setProperty("--w", `${card.baseW}px`);
      card.el.style.setProperty("--h", `${card.baseH}px`);
      noteEl?.classList.remove("is-visible");
    }

    function zoom(card: Card) {
      if (!payload) return;
      if (zoomed === card) {
        unzoom();
        return;
      }
      if (zoomed) unzoom();
      zoomed = card;
      bringToFront(card);

      const naturalW = card.img.naturalWidth || 4;
      const naturalH = card.img.naturalHeight || 3;
      const isMobile = window.innerWidth < 768;
      const maxW = window.innerWidth - (isMobile ? 36 : 120);
      const maxH = window.innerHeight - (isMobile ? 260 : 140);
      const scale = Math.min(maxW / naturalW, maxH / naturalH, 1.25);
      card.el.style.setProperty("--w", `${Math.round(naturalW * scale)}px`);
      card.el.style.setProperty("--h", `${Math.round(naturalH * scale)}px`);
      card.el.classList.add("is-zoomed");

      if (!noteEl) return;
      const tags = card.meta.tags.length > 0 ? card.meta.tags : albumTags();
      const date = card.meta.date || payload.date || "";
      const desc = card.meta.description;

      noteEl.style.backgroundColor = card.noteColor;
      noteEl.innerHTML = `
        ${date ? `<div class="ps-note-date"></div>` : ""}
        ${tags.length > 0 ? `<div class="ps-note-tags"></div>` : ""}
        ${desc ? `<div class="ps-note-desc"></div>` : ""}
      `;
      const dateEl = noteEl.querySelector(".ps-note-date");
      if (dateEl) dateEl.textContent = date;
      const tagsWrap = noteEl.querySelector(".ps-note-tags");
      if (tagsWrap) {
        for (const t of tags) {
          const chip = document.createElement("span");
          chip.className = "ps-note-tag";
          chip.textContent = `# ${t}`;
          tagsWrap.appendChild(chip);
        }
      }
      const descEl = noteEl.querySelector(".ps-note-desc");
      if (descEl) descEl.textContent = desc;

      if (!date && tags.length === 0 && !desc) {
        noteEl.classList.remove("is-visible");
      } else {
        noteEl.classList.remove("is-visible");
        void noteEl.offsetWidth;
        noteEl.classList.add("is-visible");
      }
    }

    function closeScatter() {
      if (!overlay || !overlay.classList.contains("ps-open")) return;
      zoomed = null;
      drag = null;
      overlay.classList.remove("ps-open");
      overlay.setAttribute("aria-hidden", "true");
      if (stage) stage.innerHTML = "";
      noteEl?.classList.remove("is-visible");
    }

    function renderScatter(data: ScatterPayload) {
      ensureOverlay();
      if (!overlay || !stage) return;
      closeScatter();

      payload = data;
      const photos = data.photos || [];
      if (photos.length === 0) return;

      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const baseW = vw < 640 ? 148 : vw < 1024 ? 180 : 210;
      zTop = 20 + photos.length;

      photos.forEach((meta, index) => {
        const el = document.createElement("div");
        el.className = "ps-card";
        el.style.setProperty("--w", `${baseW}px`);
        el.style.setProperty("--h", `${baseW}px`);

        const frame = document.createElement("div");
        frame.className = "ps-frame";
        frame.style.animationDelay = `${Math.min(index * 70, 700)}ms`;

        const img = document.createElement("img");
        img.src = meta.src;
        img.alt = meta.description || `照片 ${index + 1}`;
        img.draggable = false;

        const strip = document.createElement("div");
        strip.className = "ps-strip";

        frame.append(img, strip);
        el.appendChild(frame);
        stage!.appendChild(el);

        const pos = stablePosition(meta.src, vw, vh, baseW);
        const offset = loadOffset(data.album, meta.src);
        const card: Card = {
          el,
          img,
          meta,
          x: pos.x + offset.x,
          y: pos.y + offset.y,
          rot: pos.rot,
          baseW,
          baseH: baseW,
          noteColor: NOTE_COLORS[index % NOTE_COLORS.length],
        };
        applyTransform(card);

        const applyNaturalSize = () => {
          const ratio = img.naturalWidth / img.naturalHeight || 1;
          const clamped = Math.min(Math.max(ratio, 2 / 3), 3 / 2);
          card.baseH = Math.round(baseW / clamped);
          if (!card.el.classList.contains("is-zoomed")) {
            card.el.style.setProperty("--w", `${card.baseW}px`);
            card.el.style.setProperty("--h", `${card.baseH}px`);
          }
        };
        if (img.complete && img.naturalWidth) applyNaturalSize();
        img.addEventListener("load", applyNaturalSize);

        let zoomClickStart = 0;
        el.addEventListener("pointerdown", (e) => {
          if (e.pointerType === "mouse" && e.button !== 0) return;
          if (zoomed) {
            zoomClickStart = e.timeStamp;
            return;
          }
          e.preventDefault();
          bringToFront(card);
          el.classList.add("is-dragging");
          try {
            el.setPointerCapture(e.pointerId);
          } catch {
            /* ignore */
          }
          drag = {
            card,
            pointerId: e.pointerId,
            startX: e.clientX,
            startY: e.clientY,
            origX: card.x,
            origY: card.y,
            moved: false,
            downAt: e.timeStamp,
          };
        });

        el.addEventListener("pointermove", (e) => {
          if (!drag || drag.card !== card || drag.pointerId !== e.pointerId) return;
          const dx = e.clientX - drag.startX;
          const dy = e.clientY - drag.startY;
          if (Math.abs(dx) + Math.abs(dy) > 6) drag.moved = true;
          card.x = drag.origX + dx;
          card.y = drag.origY + dy;
          applyTransform(card);
        });

        el.addEventListener("pointerup", (e) => {
          // 放大态下点当前照片还原，点别的照片切换放大
          if (zoomed && zoomClickStart) {
            zoom(card);
            zoomClickStart = 0;
            return;
          }
          if (!drag || drag.card !== card || drag.pointerId !== e.pointerId) return;
          el.classList.remove("is-dragging");
          try {
            el.releasePointerCapture(e.pointerId);
          } catch {
            /* ignore */
          }
          const state = drag;
          drag = null;
          if (state.moved) {
            saveOffset(data.album, meta.src, card.x, card.y);
          } else if (e.timeStamp - state.downAt < 300) {
            zoom(card);
          }
        });
        el.addEventListener("pointercancel", () => {
          el.classList.remove("is-dragging");
          drag = null;
        });
      });

      overlay.classList.add("ps-open");
      overlay.setAttribute("aria-hidden", "false");
    }

    function readPayload(): ScatterPayload | null {
      const el = document.querySelector<HTMLScriptElement>("script[data-scatter-data]");
      if (!el?.textContent) return null;
      try {
        const data = JSON.parse(el.textContent) as ScatterPayload;
        if (!data || !Array.isArray(data.photos) || data.photos.length === 0) return null;
        return data;
      } catch {
        return null;
      }
    }

    /** 页面里存在散落相册数据就立即展开 */
    function boot() {
      const data = readPayload();
      if (data && !overlay?.classList.contains("ps-open")) renderScatter(data);
    }

    // Astro 的脚本在 DOM 解析后执行；加密相册解密后再启动一次
    boot();
    document.addEventListener("password:decrypted", () => setTimeout(boot, 150));
    // swup 无刷新进入相册页
    document.addEventListener("swup:contentReplaced", boot);
    // 离开相册页时收起
    document.addEventListener("swup:visit:start", closeScatter);

    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !overlay?.classList.contains("ps-open")) return;
      e.preventDefault();
      if (zoomed) unzoom();
      else goBack();
    });
  })();
</script>
