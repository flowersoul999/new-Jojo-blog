---
import { getLqipProps } from "@/utils/lqip-utils";

interface Props {
	src: string;
	albumId: string;
	alt?: string;
	description?: string;
	date?: string;
	tags?: string[];
}

const { src, albumId, alt = "", description, date, tags } = Astro.props;

// LQIP 渐变占位
const lqipProps = getLqipProps(src, undefined, true);
---

<div class="gallery-photo-card break-inside-avoid mb-3">
  <div
    data-scatter-photo
    data-src={src}
    data-description={description || ""}
    data-date={date || ""}
    data-tags={tags && tags.length > 0 ? JSON.stringify(tags) : "[]"}
    tabindex="0"
    role="button"
    aria-label={description || alt || "查看照片"}
    class="block rounded-xl overflow-hidden relative group cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-(--primary)"
  >
    <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>
    <img
      src={src}
      alt={alt || description || ""}
      loading="lazy"
      decoding="async"
      draggable="false"
      class="w-full h-auto object-cover opacity-0 transition-all duration-500 ease-out group-hover:scale-105"
    />
  </div>
</div>
