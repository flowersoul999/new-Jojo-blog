---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import CultivationDock from "@/components/skills/CultivationDock.svelte";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style } = Astro.props;
---

<WidgetLayout
	id="cultivation-dock"
	name="修行"
	class={className}
	style={style}
>
	<CultivationDock client:load />
</WidgetLayout>
